# Non-secret site, repository, GitHub App, branch, and R2 URL settings belong in
# wrangler.toml. Astro commands load them automatically; do not duplicate them here.

# Keystatic GitHub App OAuth credentials for local development.
# Put production values in Cloudflare Worker encrypted Secrets.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Keystatic OAuth/session secret for local development. It also remains the
# contact-form verification and Image Pool write fallback secret.
KEYSTATIC_SECRET=replace-with-at-least-32-random-characters

# Local examples only. Generate two different UUIDs and a separate random 32+
# character signing secret for production, then store all three as Cloudflare
# Worker encrypted Secrets. Never commit production values.
KEYSTATIC_PORTAL_UUID=11111111-1111-4111-8111-111111111111
MANAGER_PORTAL_UUID=22222222-2222-4222-8222-222222222222
ADMIN_PORTAL_SESSION_SECRET=replace-with-a-separate-32-character-random-secret

# Analytics visitor IDs use a separate daily HMAC and never expose this value.
# Generate a different 32+ character production value and save it as a Worker Secret.
ANALYTICS_HASH_SECRET=replace-with-a-separate-32-character-random-secret

# Optional Google Search Console read-only service account JSON. Add the service
# account email as a user on the exact GSC property configured in wrangler.toml.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=

# One fine-grained GitHub token is reused by Manager write-back, AI task dispatch,
# draft reads, and manual Publish Site dispatch.
BUSINESSWEB_GITHUB_TOKEN=

# Optional runtime settings. MANAGER_ACCESS_BYPASS_TOKEN is local API testing
# only; the production Manager UI uses the dedicated host, UUID, and session.
MANAGER_ACCESS_BYPASS_TOKEN=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
