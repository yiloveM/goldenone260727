# Non-secret site, repository, GitHub App, branch, and R2 URL settings belong in
# wrangler.toml. Astro commands load them automatically; do not duplicate them here.

# Keystatic GitHub App OAuth credentials for local development.
# Put production values in Cloudflare Worker encrypted Secrets.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# One 32+ character secret is reused for Keystatic sessions, contact-form
# verification, Manager's optional API bypass, and Image Pool write fallback.
KEYSTATIC_SECRET=replace-with-at-least-32-random-characters

# One fine-grained GitHub token is reused by Manager write-back, AI task dispatch,
# draft reads, and manual Publish Site dispatch.
BUSINESSWEB_GITHUB_TOKEN=

# Optional runtime settings.
MANAGER_ALLOWED_EMAILS=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
