# Site URL used by Astro canonical URLs and sitemap generation.
SITE_URL=https://businessweb.workers.dev

# Keystatic GitHub storage target. Must be owner/repo.
KEYSTATIC_GITHUB_REPO=your-org/businessweb

# Optional branch used by custom product order saves. Defaults to main.
KEYSTATIC_GITHUB_BRANCH=main

# GitHub App slug from the GitHub App settings URL, for example:
# https://github.com/settings/apps/businessweb-keystatic -> businessweb-keystatic
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=businessweb-keystatic

# Public custom domain for Cloudflare R2 image URLs copied from Keystatic Image Pool.
PUBLIC_R2_ASSET_BASE_URL=https://cdn.example.com

# Contact form email delivery.
# Store RESEND_API_KEY and CONTACT_FORM_SECRET as encrypted Cloudflare Secrets.
# CONTACT_FROM_EMAIL must be a sender verified by your email provider.
CONTACT_TO_EMAIL=inquiries@example.com
CONTACT_FROM_EMAIL=
CONTACT_FORM_SECRET=
RESEND_API_KEY=

# Optional fallback token for non-browser API uploads/deletes.
# The Keystatic UI now uses the logged-in GitHub session instead.
R2_IMAGE_POOL_WRITE_TOKEN=

# Keystatic GitHub App OAuth credentials.
# Put real values in Cloudflare Workers Settings -> Variables and Secrets.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Must be at least 32 characters. Generate with:
# openssl rand -base64 48
# Store the real value as an encrypted Cloudflare Secret, not in Git.
KEYSTATIC_SECRET=replace-with-at-least-32-random-characters

# One GitHub fine-grained token for Cloudflare Workers backend tasks:
# AI translation dispatch, manager write-back, latest draft reads, and site publish dispatch.
# Existing installs may keep using AI_TRANSLATION_DISPATCH_TOKEN instead.
BUSINESSWEB_GITHUB_TOKEN=

# Google AI Studio Gemini API keys for GitHub Actions AI translation drafts.
# Store the real value as a GitHub Actions Secret, not in Git.
GEMINI_API_KEYS=

# Optional. Use several Google AI Studio keys for AI translation rotation.
# Put these in GitHub Actions Secrets, not in Git. You can use either style:
# GEMINI_API_KEYS=key-1,key-2,key-3
# GEMINI_API_KEY_1=key-1
# GEMINI_API_KEY_2=key-2

# Optional. Defaults to gemini-3.5-flash when omitted.
GOOGLE_AI_TRANSLATION_MODEL=gemini-3.5-flash
