---
const pagePath = Astro.url.pathname;
---

<form
  class="artwork-brief"
  action="/api/contact"
  method="post"
  enctype="multipart/form-data"
  data-artwork-brief
  novalidate
>
  <input type="hidden" name="captchaToken" data-captcha-token />
  <input type="hidden" name="pagePath" value={pagePath} />
  <input type="hidden" name="inquiryItems" value="[]" />
  <input type="hidden" name="formType" value="artwork-brief" />
  <div class="form-trap" aria-hidden="true">
    <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="artwork-brief__heading">
    <span>01 / Your starting point</span>
    <h2>Show us the idea.</h2>
    <p>A sketch, logo, reference image, or PDF is enough to start a conversation.</p>
  </div>

  <label class="artwork-dropzone" data-artwork-dropzone>
    <input name="artwork" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" data-artwork-input required />
    <span class="artwork-dropzone__icon" aria-hidden="true">+</span>
    <strong data-artwork-file-label>Upload your design sketch</strong>
    <small>JPG, PNG, WEBP, or PDF · up to 5 MB</small>
  </label>

  <label class="artwork-brief__label" for="artwork-description">Describe your idea <em>(optional)</em></label>
  <textarea id="artwork-description" name="artworkDescription" rows="3" placeholder="Product type, occasion, shape, finish, quantity, or anything you already know."></textarea>

  <div class="artwork-brief__contact">
    <label><span>Full name</span><input name="name" autocomplete="name" required /></label>
    <label><span>Work email</span><input name="email" type="email" autocomplete="email" required /></label>
  </div>
  <div class="artwork-brief__contact">
    <label><span>Phone / WhatsApp</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" minlength="5" maxlength="80" required /></label>
    <label><span>Country / region <em>(optional)</em></span><input name="country" autocomplete="country-name" /></label>
  </div>

  <div class="artwork-brief__captcha">
    <div><span>Verification code</span><strong data-captcha-code>----</strong></div>
    <input name="captcha" placeholder="Enter code" inputmode="text" autocomplete="off" maxlength="4" pattern="[A-Za-z0-9]{4}" required />
    <button type="button" data-captcha-refresh aria-label="Refresh verification code">↻</button>
  </div>
  <button class="artwork-brief__submit" type="submit" data-submit>Get my free design <span aria-hidden="true">→</span></button>
  <p class="artwork-brief__status" data-form-status aria-live="polite"></p>
</form>

<script is:inline>
  (() => {
    const endpoint = '/api/contact';
    document.querySelectorAll('[data-artwork-brief]').forEach(form => {
      const fileInput = form.querySelector('[data-artwork-input]');
      const fileLabel = form.querySelector('[data-artwork-file-label]');
      const dropzone = form.querySelector('[data-artwork-dropzone]');
      const status = form.querySelector('[data-form-status]');
      const submit = form.querySelector('[data-submit]');
      const code = form.querySelector('[data-captcha-code]');
      const token = form.querySelector('[data-captcha-token]');
      const refresh = form.querySelector('[data-captcha-refresh]');

      const updateFileName = () => {
        const file = fileInput?.files?.[0];
        fileLabel.textContent = file ? file.name : 'Upload your design sketch';
        dropzone.classList.toggle('has-file', Boolean(file));
      };
      const loadCaptcha = async () => {
        code.textContent = '....';
        const response = await fetch(endpoint, { headers: { accept: 'application/json' }, credentials: 'same-origin' });
        if (!response.ok) throw new Error('captcha');
        const data = await response.json();
        code.textContent = data.code;
        token.value = data.token;
        form.querySelector('input[name="captcha"]').value = '';
      };
      fileInput?.addEventListener('change', updateFileName);
      ['dragenter', 'dragover'].forEach(type => dropzone?.addEventListener(type, event => {
        event.preventDefault();
        dropzone.classList.add('is-dragging');
      }));
      ['dragleave', 'drop'].forEach(type => dropzone?.addEventListener(type, event => {
        event.preventDefault();
        dropzone.classList.remove('is-dragging');
      }));
      dropzone?.addEventListener('drop', event => {
        const files = event.dataTransfer?.files;
        if (!files?.length || !fileInput) return;
        fileInput.files = files;
        updateFileName();
      });
      refresh?.addEventListener('click', () => loadCaptcha().catch(() => {
        status.textContent = 'Verification code could not load. Please refresh the page.';
      }));
      loadCaptcha().catch(() => { status.textContent = 'Verification code could not load. Please refresh the page.'; });
      form.addEventListener('submit', async event => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        submit.disabled = true;
        status.textContent = 'Sending your design brief…';
        status.dataset.state = 'pending';
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' }, credentials: 'same-origin' });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'Send failed.');
          form.reset();
          updateFileName();
          status.textContent = data.message || 'Thank you. Your design brief has been sent.';
          status.dataset.state = 'success';
          await loadCaptcha();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'The design brief could not be sent right now.';
          status.dataset.state = 'error';
        } finally {
          submit.disabled = false;
        }
      });
    });
  })();
</script>
