---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="back-to-top" type="button" aria-label={label} title={label} data-back-to-top hidden>
  <span class="back-to-top-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="m6 14 6-6 6 6" />
      <path d="M12 8v10" />
    </svg>
  </span>
  <span class="side-contact-note back-to-top-note"><strong>{label}</strong></span>
</button>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-back-to-top]').forEach(button => {
      const updateVisibility = () => {
        button.hidden = (window.scrollY || document.documentElement.scrollTop || 0) < 480;
      };

      button.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      });
      window.addEventListener('scroll', updateVisibility, { passive: true });
      updateVisibility();
    });
  })();
</script>
