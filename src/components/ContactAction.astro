---
import { getLocaleFromPathname, ui } from '../data/i18n';
import FormVerification from './FormVerification.astro';

interface Props {
  whatsapp?: string;
  email?: string;
}

const { whatsapp = '', email = '' } = Astro.props;
const pagePath = Astro.url.pathname;
const copy = ui[getLocaleFromPathname(pagePath)].contactAction;
---

{(whatsapp || email) && (
  <div
    class="contact-action"
    data-contact-action
    data-open-label={copy.contactUs}
    data-close-label={copy.close}
    data-captcha-error={copy.captchaError}
    data-sending-label={copy.sending}
    data-success-label={copy.success}
    data-error-label={copy.sendError}
  >
    <button class="contact-action-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label={copy.contactUs} data-contact-action-trigger>
      <svg class="contact-action-trigger__open" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 5.5h14v10H9l-4 3v-13Z" />
        <path d="M8.5 9h7M8.5 12h5" />
      </svg>
      <span class="contact-action-trigger__label">{copy.contactUs}</span>
      <svg class="contact-action-trigger__close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
    <div class="contact-action-menu" role="dialog" aria-label={copy.options} aria-hidden="true" inert>
      <header class="contact-action-menu__header">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5.5h14v10H9l-4 3v-13Z" />
          <path d="M8.5 9h7M8.5 12h5" />
        </svg>
        <strong>{copy.title}</strong>
      </header>
      <div class="contact-action-menu__body">
        <p>{copy.introduction}</p>
        <form class="contact-action-email-form" action="/api/contact" method="post" data-contact-action-form>
          <input type="hidden" name="pagePath" value={pagePath} />
          <input type="hidden" name="inquiryItems" value="[]" />
          <input type="hidden" name="formType" value="quick-contact" />
          <div class="form-trap" aria-hidden="true">
            <label>{copy.website} <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="contact-action-field">
            <span>{copy.name}</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label class="contact-action-field">
            <span>{copy.email}</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="contact-action-field">
            <span>{copy.message}</span>
            <textarea name="message" rows="3" required></textarea>
          </label>
          <FormVerification action="contact" locale={getLocaleFromPathname(pagePath)} refreshLabel={copy.refreshCode} errorLabel={copy.captchaError}>
          <div class="contact-action-captcha">
            <strong data-contact-action-captcha-code data-verification-code>----</strong>
            <input name="captcha" aria-label={copy.verificationCode} placeholder={copy.enterCode} autocomplete="off" maxlength="4" pattern="[A-Za-z0-9]{4}" required data-contact-action-captcha-input />
            <button type="button" aria-label={copy.refreshCode} title={copy.refreshCode} data-contact-action-captcha-refresh data-verification-refresh>&#8635;</button>
          </div>
          </FormVerification>
          <button class="contact-action-send" type="submit" data-contact-action-submit disabled>{copy.sendEmail}</button>
          <p class="contact-action-status" aria-live="polite" data-contact-action-status></p>
        </form>
        <div class="contact-action-menu__shortcuts">
          <span>{copy.direct}</span>
          <div class="contact-action-menu__options">
          {whatsapp && (
            <a class="contact-action-option contact-action-option--whatsapp" href={whatsapp} target="_blank" rel="noopener" aria-label={copy.whatsappLabel}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 11.8a8.4 8.4 0 0 1-12.4 7.4L4 20l.9-3.9a8.4 8.4 0 1 1 15.6-4.3Z" />
                <path d="M9.1 8.7c.3-.4.8-.4 1.1 0l.8.9c.2.2.3.6.1.9l-.3.7c.6 1.1 1.5 2 2.6 2.6l.8-.3c.3-.1.6 0 .9.2l.9.8c.3.3.3.8 0 1.1-.6.7-1.6.7-2.7.3-2.3-.8-4.3-2.8-5.1-5.1-.4-1.1-.3-2 .5-2.8Z" />
              </svg>
              <span>WhatsApp</span>
            </a>
          )}
          {email && (
            <a class="contact-action-option" href={`mailto:${email}`} aria-label={copy.emailLabel}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 6.5h15v11h-15Z" />
                <path d="m5 7 7 6 7-6" />
              </svg>
              <span>Email</span>
            </a>
          )}
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline>
  (() => {
    document.querySelectorAll('[data-contact-action]').forEach(root => {
      if (root.dataset.verificationBound) return;
      root.dataset.verificationBound = 'true';
      const trigger = root.querySelector('[data-contact-action-trigger]');
      const menu = root.querySelector('.contact-action-menu');
      const form = root.querySelector('[data-contact-action-form]');
      const status = root.querySelector('[data-contact-action-status]');
      const submit = root.querySelector('[data-contact-action-submit]');
      const verification = form?.querySelector('form-verification');
      let submitting = false;
      const updateSubmit = () => { if (submit) submit.disabled = submitting || !verification?.ready; };
      verification?.addEventListener('verificationchange', updateSubmit);

      const loadCaptcha = async () => {
        await customElements.whenDefined('form-verification');
        if (root.classList.contains('is-open')) await verification?.refresh();
      };

      const setOpen = open => {
        root.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('has-contact-action-open', open);
        trigger?.setAttribute('aria-expanded', String(open));
        trigger?.setAttribute('aria-label', open ? root.dataset.closeLabel : root.dataset.openLabel);
        menu?.setAttribute('aria-hidden', String(!open));
        if (menu instanceof HTMLElement) menu.inert = !open;
        if (open) {
          window.dispatchEvent(new CustomEvent('businessweb:contact-action-open'));
          loadCaptcha().catch(() => {});
        } else {
          verification?.suspend?.();
        }
      };

      trigger?.addEventListener('click', event => {
        event.stopPropagation();
        setOpen(!root.classList.contains('is-open'));
      });
      root.addEventListener('focusout', event => {
        if (event.relatedTarget instanceof Node && !root.contains(event.relatedTarget)) setOpen(false);
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') setOpen(false);
      });
      window.addEventListener('businessweb:inquiry-cart-open', () => setOpen(false));

      form?.addEventListener('submit', async event => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
        if (submitting || !verification?.ready) return;
        submitting = true;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (status) {
          status.textContent = root.dataset.sendingLabel;
          status.dataset.state = 'pending';
        }
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { accept: 'application/json' },
            credentials: 'same-origin',
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(root.dataset.errorLabel);
          form.reset();
          if (status) {
            status.textContent = root.dataset.successLabel;
            status.dataset.state = 'success';
          }
          await loadCaptcha();
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : root.dataset.errorLabel;
            status.dataset.state = 'error';
          }
          loadCaptcha().catch(() => {});
        } finally {
          submitting = false;
          updateSubmit();
        }
      });
    });
  })();
</script>
