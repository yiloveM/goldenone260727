---
interface Props {
  whatsapp?: string;
  email?: string;
}

const { whatsapp = '', email = '' } = Astro.props;
const pagePath = Astro.url.pathname;
---

{(whatsapp || email) && (
  <div class="contact-action" data-contact-action>
    <button class="contact-action-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Contact us" data-contact-action-trigger>
      <span class="contact-action-trigger__label">Contact us</span>
      <svg class="contact-action-trigger__close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
    <div class="contact-action-menu" role="dialog" aria-label="Contact options" aria-hidden="true" inert>
      <header class="contact-action-menu__header">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5.5h14v10H9l-4 3v-13Z" />
          <path d="M8.5 9h7M8.5 12h5" />
        </svg>
        <strong>Let's discuss your custom project.</strong>
      </header>
      <div class="contact-action-menu__body">
        <p>Share your idea, artwork, or requirements with our custom gift team.</p>
        <form class="contact-action-email-form" action="/api/contact" method="post" data-contact-action-form>
          <input type="hidden" name="captchaToken" data-contact-action-captcha-token />
          <input type="hidden" name="pagePath" value={pagePath} />
          <input type="hidden" name="inquiryItems" value="[]" />
          <input type="hidden" name="formType" value="quick-contact" />
          <div class="form-trap" aria-hidden="true">
            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="contact-action-field">
            <span>Name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label class="contact-action-field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="contact-action-field">
            <span>Message</span>
            <textarea name="message" rows="3" required></textarea>
          </label>
          <div class="contact-action-captcha">
            <strong data-contact-action-captcha-code>----</strong>
            <input name="captcha" aria-label="Verification code" placeholder="Enter code" autocomplete="off" maxlength="4" pattern="[A-Za-z0-9]{4}" required data-contact-action-captcha-input />
            <button type="button" aria-label="Refresh verification code" title="Refresh verification code" data-contact-action-captcha-refresh>&#8635;</button>
          </div>
          <button class="contact-action-send" type="submit" data-contact-action-submit>Send email</button>
          <p class="contact-action-status" aria-live="polite" data-contact-action-status></p>
        </form>
        <div class="contact-action-menu__shortcuts">
          <span>Or contact us directly</span>
          <div class="contact-action-menu__options">
          {whatsapp && (
            <a class="contact-action-option contact-action-option--whatsapp" href={whatsapp} target="_blank" rel="noopener" aria-label="Contact us on WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 11.8a8.4 8.4 0 0 1-12.4 7.4L4 20l.9-3.9a8.4 8.4 0 1 1 15.6-4.3Z" />
                <path d="M9.1 8.7c.3-.4.8-.4 1.1 0l.8.9c.2.2.3.6.1.9l-.3.7c.6 1.1 1.5 2 2.6 2.6l.8-.3c.3-.1.6 0 .9.2l.9.8c.3.3.3.8 0 1.1-.6.7-1.6.7-2.7.3-2.3-.8-4.3-2.8-5.1-5.1-.4-1.1-.3-2 .5-2.8Z" />
              </svg>
              <span>WhatsApp</span>
            </a>
          )}
          {email && (
            <a class="contact-action-option" href={`mailto:${email}`} aria-label="Contact us by email">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.5 6.5h15v11h-15Z" />
                <path d="m5 7 7 6 7-6" />
              </svg>
              <span>Email</span>
            </a>
          )}
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline>
  (() => {
    document.querySelectorAll('[data-contact-action]').forEach(root => {
      const trigger = root.querySelector('[data-contact-action-trigger]');
      const menu = root.querySelector('.contact-action-menu');
      const form = root.querySelector('[data-contact-action-form]');
      const status = root.querySelector('[data-contact-action-status]');
      const submit = root.querySelector('[data-contact-action-submit]');
      const captchaCode = root.querySelector('[data-contact-action-captcha-code]');
      const captchaToken = root.querySelector('[data-contact-action-captcha-token]');
      const captchaInput = root.querySelector('[data-contact-action-captcha-input]');
      const captchaRefresh = root.querySelector('[data-contact-action-captcha-refresh]');
      let captchaLoaded = false;
      let captchaLoading = null;

      const loadCaptcha = () => {
        if (captchaLoading) return captchaLoading;
        if (captchaCode) captchaCode.textContent = '....';
        captchaLoading = fetch('/api/contact', { headers: { accept: 'application/json' }, credentials: 'same-origin' })
          .then(response => {
            if (!response.ok) throw new Error('Verification code could not load.');
            return response.json();
          })
          .then(data => {
            if (captchaCode) captchaCode.textContent = data.code;
            if (captchaToken) captchaToken.value = data.token;
            if (captchaInput) captchaInput.value = '';
            captchaLoaded = true;
          })
          .catch(error => {
            captchaLoaded = false;
            if (captchaCode) captchaCode.textContent = '----';
            if (status) {
              status.textContent = error instanceof Error ? error.message : 'Verification code could not load.';
              status.dataset.state = 'error';
            }
            throw error;
          })
          .finally(() => { captchaLoading = null; });
        return captchaLoading;
      };

      const setOpen = open => {
        root.classList.toggle('is-open', open);
        trigger?.setAttribute('aria-expanded', String(open));
        trigger?.setAttribute('aria-label', open ? 'Close contact options' : 'Contact us');
        menu?.setAttribute('aria-hidden', String(!open));
        if (menu instanceof HTMLElement) menu.inert = !open;
        if (open) {
          window.dispatchEvent(new CustomEvent('businessweb:contact-action-open'));
          if (!captchaLoaded) loadCaptcha().catch(() => {});
        }
      };

      trigger?.addEventListener('click', event => {
        event.stopPropagation();
        setOpen(!root.classList.contains('is-open'));
      });
      root.addEventListener('focusout', event => {
        if (!(event.relatedTarget instanceof Node) || !root.contains(event.relatedTarget)) setOpen(false);
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') setOpen(false);
      });
      window.addEventListener('businessweb:inquiry-cart-open', () => setOpen(false));

      captchaRefresh?.addEventListener('click', () => {
        captchaLoaded = false;
        if (status) status.textContent = '';
        loadCaptcha().catch(() => {});
      });

      form?.addEventListener('submit', async event => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
        if (!captchaLoaded) {
          await loadCaptcha().catch(() => {});
          captchaInput?.focus();
          return;
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (status) {
          status.textContent = 'Sending your message...';
          status.dataset.state = 'pending';
        }
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { accept: 'application/json' },
            credentials: 'same-origin',
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'The message could not be sent.');
          form.reset();
          captchaLoaded = false;
          if (status) {
            status.textContent = data.message || 'Thank you. Your message has been sent.';
            status.dataset.state = 'success';
          }
          await loadCaptcha();
        } catch (error) {
          captchaLoaded = false;
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'The message could not be sent.';
            status.dataset.state = 'error';
          }
          loadCaptcha().catch(() => {});
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });
    });
  })();
</script>
