---
import {
  customerReviewSummary,
  reviewSystemEnabled,
  reviewsForProduct,
  reviewSummaryForProduct,
  type CustomerReview,
} from '../data/customerReviews';
import { getLocaleFromPathname, ui } from '../data/i18n';

interface Props {
  productSlug?: string;
  compact?: boolean;
  productReviews?: unknown;
  aggregateRatingValue?: unknown;
  aggregateRatingCount?: unknown;
}

const { productSlug, compact = false, productReviews, aggregateRatingValue, aggregateRatingCount } = Astro.props;
const locale = getLocaleFromPathname(Astro.url.pathname);
const copy = ui[locale].reviews;
const visibleReviews: CustomerReview[] = reviewsForProduct(productSlug, productReviews);
const summary = productSlug
  ? reviewSummaryForProduct(productSlug, productReviews, aggregateRatingValue, aggregateRatingCount)
  : customerReviewSummary;
const hasSummary = summary.rating > 0 && summary.reviewCount > 0;
const loopReviews = visibleReviews.length > 1 ? [...visibleReviews, ...visibleReviews] : visibleReviews;
const sectionTitle = productSlug ? copy.productTitle : copy.homeTitle;
const reviewCountLabel = summary.reviewCount === 1 ? copy.review : copy.reviews;
---

{reviewSystemEnabled && (visibleReviews.length > 0 || hasSummary) && <section class:list={['customer-ratings', compact && 'customer-ratings--compact']} aria-labelledby={`customer-ratings-title-${productSlug || 'home'}`}>
  <div class="metal-shell customer-ratings__inner">
    <div class="customer-ratings__heading">
      <p class="metal-kicker">{copy.customerRatings}</p>
      <h2 id={`customer-ratings-title-${productSlug || 'home'}`}>{sectionTitle}</h2>
    </div>

    {hasSummary && <div class="customer-ratings__overview">
      <div class="customer-ratings__brand" aria-label={`${summary.rating} ${copy.outOfFiveStars}`}>
        <strong>{summary.rating}</strong>
        <div><span class="customer-ratings__stars" aria-hidden="true">{Array.from({ length: 5 }, (_, index) => <span style={`opacity:${Math.max(.2, Math.min(1, summary.rating - index))}`}>&#9733;</span>)}</span></div>
      </div>
      <div class="customer-ratings__count">
        <span class="customer-ratings__stars" aria-hidden="true">{Array.from({ length: 5 }, (_, index) => <span style={`opacity:${Math.max(.2, Math.min(1, summary.rating - index))}`}>&#9733;</span>)}</span>
        <strong>{summary.reviewCount} {reviewCountLabel}</strong>
      </div>
      {!productSlug && customerReviewSummary.profileUrl && <a href={customerReviewSummary.profileUrl} target="_blank" rel="noopener noreferrer">{copy.viewProfile}</a>}
    </div>}

    {visibleReviews.length > 0 && (
      <div class="customer-ratings__carousel" data-marquee-shell data-marquee-duration="56" data-marquee-direction="rtl">
        <button class="customer-ratings__control customer-ratings__control--prev" type="button" aria-label={copy.previous} data-marquee-prev>&#8249;</button>
        <div class="customer-ratings__viewport" data-review-viewport tabindex="0" aria-label={copy.carousel}>
          <div class="customer-ratings__track" data-marquee-track>
            {loopReviews.map((review, index) => (
            <article class="customer-review-card" aria-hidden={index >= visibleReviews.length ? 'true' : undefined}>
              <header>
                <span class="customer-review-card__avatar" aria-hidden="true">{(review.buyerLabel || 'V').slice(0, 1).toUpperCase()}</span>
                <div>
                  <strong>{review.buyerLabel || 'Buyer'}</strong>
                  {review.date && <small>{review.date}</small>}
                </div>
              </header>
              <div class="customer-review-card__stars" aria-label={`${review.rating} ${copy.outOfFiveStars}`}>
                {Array.from({ length: review.rating }).map(() => <span aria-hidden="true">&#9733;</span>)}
              </div>
              <blockquote>{review.quote}</blockquote>
              {(review.projectType || review.country) && <footer>
                <span>{[review.projectType, review.country].filter(Boolean).join(' / ')}</span>
              </footer>}
            </article>
            ))}
          </div>
        </div>
        <button class="customer-ratings__control customer-ratings__control--next" type="button" aria-label={copy.next} data-marquee-next>&#8250;</button>
      </div>
    )}

  </div>
</section>}
