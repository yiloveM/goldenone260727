---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkBriefForm from './ArtworkBriefForm.astro';
import BrandPartnerStrip from './BrandPartnerStrip.astro';
import CustomerReviews from './CustomerReviews.astro';
import MediaCarousel from './MediaCarousel.astro';
import '../styles/home-tailwind.css';
import { brandAssets } from '../data/assets';
import { industryProfile, profileKeywords } from '../data/industry-profile';
import { type Locale, getPageCopy, localizePath, translateTechnicalText } from '../data/i18n';
import { collectionStructuredData, organizationStructuredData, websiteStructuredData } from '../data/seo';
import { brandShowcase, factoryGallery, siteInfo } from '../data/site';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const pages = getPageCopy(locale);
const productHref = localizePath('/products/', locale);
const contactHref = localizePath('/contact/', locale);
const categoryImages = [
  '/images/metal-gifts/lapel-pin-collection-v2.webp',
  '/images/metal-gifts/challenge-coin-collection-v2.webp',
  '/images/metal-gifts/medal-collection-v2.webp',
  '/images/metal-gifts/keychain-collection-v2.webp',
];
const categories = brandShowcase.map((item, index) => ({
  ...item,
  image: categoryImages[index],
  title: translateTechnicalText(item.title, locale),
  label: translateTechnicalText(item.label, locale),
  number: String(index + 1).padStart(2, '0'),
}));
const homeStructuredData = [
  organizationStructuredData(Astro.site),
  websiteStructuredData(Astro.site),
  collectionStructuredData({
    name: `${siteInfo.name} | ${industryProfile.market.industry}`,
    description: pages.home.description,
    url: localizePath('/', locale),
    image: brandAssets.heroRippleDesktop,
    keywords: profileKeywords([industryProfile.market.industry]),
    items: categories.map(category => ({ name: category.title, url: productHref, image: category.image })),
  }, Astro.site),
];
---

<BaseLayout title={siteInfo.name} description={pages.home.description} image={brandAssets.heroRippleDesktop} preloadHomeHero structuredData={homeStructuredData} locale={locale}>
  <main class="metal-home signature-home" data-tailwind-homepage="tw:signature-product">
    <section class="conversion-hero" aria-labelledby="conversion-hero-title">
      <img class="conversion-hero__image" src={brandAssets.heroRippleDesktop} alt="Custom metal gift collection" width="1792" height="1024" fetchpriority="high" decoding="async" />
      <div class="conversion-hero__shade" aria-hidden="true"></div>
      <div class="metal-shell conversion-hero__inner">
        <div class="conversion-hero__copy">
          <span class="conversion-hero__pill">Free artwork support with every custom project</span>
          <h1 id="conversion-hero-title">Premium Custom Metal Gifts That Honor Every Occasion</h1>
          <p>Turn your logo, sketch, or idea into custom pins, challenge coins, medals, and keychains with a clear specification and presentation direction.</p>
          <div class="conversion-hero__actions">
            <a class="signature-button signature-button--orange" href="#free-design">Get a free design <span aria-hidden="true">&#8594;</span></a>
            <a class="signature-button signature-button--outline" href={productHref}>Explore products</a>
          </div>
          <ul class="conversion-hero__points">
            <li>Artwork and specification guidance</li>
            <li>Custom shape, finish, color, and packaging</li>
            <li>Built for brands, events, recognition, and merchandise</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="design-upload" id="free-design" aria-labelledby="design-upload-title">
      <div class="metal-shell design-upload__grid">
        <div class="design-upload__intro">
          <span class="metal-kicker">Start with your artwork</span>
          <h2 id="design-upload-title">Ready to create something worth keeping?</h2>
          <p>Upload a sketch, logo, reference image, or PDF. We will use it to begin a practical design and quotation conversation.</p>
          <figure><img src="/images/metal-gifts/challenge-coin-collection-v2.webp" alt="Custom metal gift design reference" width="1456" height="1092" loading="lazy" decoding="async" /></figure>
        </div>
        <ArtworkBriefForm />
      </div>
    </section>

    <BrandPartnerStrip />

    <section class="collection-reframe metal-section" aria-labelledby="collection-title">
      <div class="metal-shell">
        <header class="collection-reframe__header">
          <div><span class="metal-kicker">Challenge coins for every purpose</span><h2 id="collection-title">One idea. Four ways to make it tangible.</h2></div>
          <p>Choose the object closest to your brief, then compare shape, relief, color, hardware, and presentation options.</p>
        </header>
        <div class="collection-reframe__grid">
          {categories.map(category => (
            <article class="format-card">
              <a href={productHref} aria-label={`Explore ${category.title}`}>
                <div class="format-card__image"><img src={category.image} alt={category.title} width="1456" height="1092" loading="lazy" decoding="async" /></div>
                <div class="format-card__copy"><span>{category.number}</span><h3>{category.title}</h3><p>{category.label}</p><i aria-hidden="true">&#8594;</i></div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="briefing-rhythm" id="how-it-starts" aria-labelledby="briefing-title">
      <div class="metal-shell">
        <header class="briefing-rhythm__header"><span class="metal-kicker">How we make it happen</span><h2 id="briefing-title">From your idea to a production-ready brief.</h2></header>
        <ol>
          <li><span>1</span><strong>Send your idea</strong><p>Share a sketch, logo, photo, or reference object.</p></li>
          <li><span>2</span><strong>Shape the design</strong><p>Confirm form, relief, color, plating, hardware, and packaging.</p></li>
          <li><span>3</span><strong>Review the brief</strong><p>Align quantity, destination, timing, and the final specification.</p></li>
          <li><span>4</span><strong>Move to production</strong><p>Use the approved direction to begin the order workflow.</p></li>
        </ol>
      </div>
    </section>

    <section class="material-edit metal-section" aria-labelledby="material-edit-title">
      <div class="metal-shell material-edit__grid">
        <figure><img src="/images/metal-gifts/customization-story-v2.webp" alt="Custom metal gift details" width="1600" height="900" loading="lazy" decoding="async" /></figure>
        <div><span class="metal-kicker">Explore our custom formats</span><h2 id="material-edit-title">Details that make the object distinctly yours.</h2><p>Use the catalogue to compare the choices that affect appearance, hand-feel, attachment, and presentation.</p><dl><div><dt>Form</dt><dd>Shape, scale, thickness, front, reverse, and edge.</dd></div><div><dt>Surface</dt><dd>Enamel, print, relief, plating, polish, texture, and color.</dd></div><div><dt>Presentation</dt><dd>Backing, ribbon, hardware, leather, card, box, or individual packaging.</dd></div></dl><a class="material-edit__link" href={productHref}>Browse the custom gift catalogue <span aria-hidden="true">&#8594;</span></a></div>
      </div>
    </section>

    <section class="closing-brief" aria-labelledby="closing-brief-title">
      <div class="metal-shell closing-brief__inner">
        <span class="metal-kicker">Your idea can start rough</span><h2 id="closing-brief-title">Let us turn it into a clear custom brief.</h2>
        <a class="signature-button signature-button--orange" href="#free-design">Upload your design <span aria-hidden="true">&#8593;</span></a>
        <small>Specifications already defined? <a href={contactHref}>Send a detailed project inquiry.</a></small>
      </div>
    </section>

    <MediaCarousel
      items={factoryGallery}
      eyebrow="Inside production"
      title="A closer look at how custom work moves."
      description="Tooling, metalworking, finishing, inspection, packing, and storage in one consistent gallery experience."
      id="home-factory"
    />

    <CustomerReviews />
  </main>
</BaseLayout>
