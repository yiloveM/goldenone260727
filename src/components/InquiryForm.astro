---
interface InquiryLabels {
  name: string;
  email: string;
  company: string;
  country: string;
  message: string;
  sendInquiry: string;
}

interface Props {
  labels: InquiryLabels;
}

const { labels } = Astro.props;
const pagePath = Astro.url.pathname;
---

<form class="glass-panel contact-card contact-form-card" action="/api/contact" method="post" data-inquiry-form dir="ltr">
  <input type="hidden" name="captchaToken" data-captcha-token />
  <input type="hidden" name="pagePath" value={pagePath} />
  <div class="form-trap" aria-hidden="true">
    <label>
      Website
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <div class="form-grid">
    <input class="input" name="name" placeholder={labels.name} autocomplete="name" required />
    <input class="input" name="email" type="email" placeholder={labels.email} autocomplete="email" required />
  </div>
  <div class="form-grid" style="margin-top:14px;">
    <input class="input" name="company" placeholder={labels.company} autocomplete="organization" />
    <input class="input" name="country" placeholder={labels.country} autocomplete="country-name" />
  </div>
  <textarea name="message" placeholder={labels.message} style="margin-top:14px;" required></textarea>
  <div class="captcha-panel" style="margin-top:14px;">
    <div>
      <span class="captcha-label">Verification code</span>
      <strong class="captcha-code" data-captcha-code>----</strong>
    </div>
    <button class="captcha-refresh" type="button" data-captcha-refresh aria-label="Refresh verification code">Refresh</button>
    <input class="input captcha-input" name="captcha" placeholder="Enter code" inputmode="text" autocomplete="off" maxlength="4" pattern="[A-Za-z0-9]{4}" required />
  </div>
  <button class="btn primary contact-submit-button" type="submit" style="margin-top:14px;">{labels.sendInquiry}</button>
  <p class="contact-form-status" data-form-status aria-live="polite"></p>
</form>

<script is:inline>
  (() => {
    const endpoint = '/api/contact';
    const loadCaptcha = async (form) => {
      const codeEl = form.querySelector('[data-captcha-code]');
      const tokenInput = form.querySelector('[data-captcha-token]');
      const captchaInput = form.querySelector('input[name="captcha"]');
      codeEl.textContent = '....';
      const response = await fetch(endpoint, {
        headers: { accept: 'application/json' },
        credentials: 'same-origin',
      });
      if (!response.ok) throw new Error('captcha');
      const data = await response.json();
      codeEl.textContent = data.code;
      tokenInput.value = data.token;
      captchaInput.value = '';
    };

    document.querySelectorAll('[data-inquiry-form]').forEach((form) => {
      const status = form.querySelector('[data-form-status]');
      const submitButton = form.querySelector('.contact-submit-button');
      const refreshButton = form.querySelector('[data-captcha-refresh]');

      loadCaptcha(form).catch(() => {
        status.textContent = 'Verification code could not load. Please refresh this page.';
        status.dataset.state = 'error';
      });

      refreshButton?.addEventListener('click', () => {
        status.textContent = '';
        loadCaptcha(form).catch(() => {
          status.textContent = 'Verification code could not load. Please refresh this page.';
          status.dataset.state = 'error';
        });
      });

      form.addEventListener('submit', async (event) => {
        if (!window.fetch) return;
        event.preventDefault();
        if (!form.reportValidity()) return;

        submitButton.disabled = true;
        status.textContent = 'Sending inquiry...';
        status.dataset.state = 'pending';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { accept: 'application/json' },
            credentials: 'same-origin',
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || 'Send failed.');

          form.reset();
          status.textContent = data.message || 'Thank you. Your inquiry has been sent.';
          status.dataset.state = 'success';
          await loadCaptcha(form);
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'The inquiry could not be sent right now.';
          status.dataset.state = 'error';
          loadCaptcha(form).catch(() => {});
        } finally {
          submitButton.disabled = false;
        }
      });
    });
  })();
</script>
