---
import PublicImage from './public/PublicImage.astro';
import { getLocaleFromPathname, ui } from '../data/i18n';

interface Props {
  images?: string[];
  title: string;
  variant?: 'hero' | 'stage';
  priority?: boolean;
}

const { images = [], title, variant = 'stage', priority = false } = Astro.props;
const carouselImages = Array.from(new Set(images.filter(Boolean))).slice(0, 12);
const hasControls = carouselImages.length > 1;
const locale = getLocaleFromPathname(Astro.url.pathname);
const common = ui[locale].common;
const dragHint = locale === 'es'
  ? 'Arrastra las miniaturas y selecciona una imagen para verla en grande.'
  : 'Drag the thumbnails and select an image to view it larger.';
---

<div
  class={`product-image-carousel product-image-carousel--${variant}${hasControls ? ' has-multiple-images' : ''}`}
  data-product-image-carousel
  data-autoplay={hasControls ? 'true' : 'false'}
  role="region"
  aria-label={`${title} product gallery`}
>
  <div class="product-image-carousel__viewport">
    {carouselImages.map((image, index) => (
      <PublicImage
        class={`product-image-carousel__image${index === 0 ? ' is-active' : ''}`}
        src={image}
        alt={`${title} - view ${index + 1} of ${carouselImages.length}`}
        fetchpriority={priority && index === 0 ? 'high' : 'auto'}
        loading={priority && index === 0 ? 'eager' : 'lazy'}
        decoding="async"
        width="1200"
        height="1000"
        data-carousel-image
        aria-hidden={index === 0 ? 'false' : 'true'}
      />
    ))}

    {hasControls && (
      <>
        <button class="product-image-carousel__nav product-image-carousel__nav--prev" type="button" aria-label={common.previousProductImage} data-carousel-prev>
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <button class="product-image-carousel__nav product-image-carousel__nav--next" type="button" aria-label={common.nextProductImage} data-carousel-next>
          <span aria-hidden="true">&rsaquo;</span>
        </button>
        <p class="product-image-carousel__counter" aria-live="polite">
          <span data-carousel-current>1</span>
          <span aria-hidden="true"> / </span>
          <span>{carouselImages.length}</span>
        </p>
      </>
    )}
  </div>

  {hasControls && (
    <>
      <p class="product-image-carousel__drag-hint">{dragHint}</p>
      <div class="product-image-carousel__thumbnails" role="group" aria-label={`${title} image choices`} data-carousel-thumbnails>
        {carouselImages.map((image, index) => (
          <button
            class:list={['product-image-carousel__thumbnail', { 'is-active': index === 0 }]}
            type="button"
            data-carousel-thumbnail
            data-carousel-index={index}
            aria-label={`Show ${title} image ${index + 1}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <PublicImage
              src={image}
              alt=""
              loading={index < 5 ? 'eager' : 'lazy'}
              decoding="async"
              width="144"
              height="120"
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  (() => {
    const setup = () => {
      document.querySelectorAll('[data-product-image-carousel]').forEach(root => {
        if (!(root instanceof HTMLElement) || root.dataset.carouselReady === 'true') return;
        root.dataset.carouselReady = 'true';

        const images = Array.from(root.querySelectorAll('[data-carousel-image]'));
        const thumbnails = Array.from(root.querySelectorAll('[data-carousel-thumbnail]'));
        const thumbnailTrack = root.querySelector('[data-carousel-thumbnails]');
        const current = root.querySelector('[data-carousel-current]');
        if (images.length <= 1) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let activeIndex = 0;
        let timer = 0;
        let isVisible = true;

        const show = (index: number, revealThumbnail = false) => {
          activeIndex = (index + images.length) % images.length;
          images.forEach((image, imageIndex) => {
            const isActive = imageIndex === activeIndex;
            image.classList.toggle('is-active', isActive);
            image.setAttribute('aria-hidden', isActive ? 'false' : 'true');
          });
          thumbnails.forEach((thumbnail, thumbnailIndex) => {
            const isActive = thumbnailIndex === activeIndex;
            thumbnail.classList.toggle('is-active', isActive);
            thumbnail.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
          if (current) current.textContent = String(activeIndex + 1);
          if (revealThumbnail) {
            thumbnails[activeIndex]?.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'nearest' });
          }
        };

        const stop = () => {
          if (timer) window.clearInterval(timer);
          timer = 0;
        };
        const start = () => {
          if (prefersReducedMotion || !isVisible || timer || root.dataset.autoplay !== 'true') return;
          timer = window.setInterval(() => show(activeIndex + 1), 3200);
        };
        const restart = () => {
          stop();
          start();
        };
        const select = (index: number) => {
          show(index, true);
          restart();
        };

        root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => select(activeIndex - 1));
        root.querySelector('[data-carousel-next]')?.addEventListener('click', () => select(activeIndex + 1));
        thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => select(index)));
        if (thumbnailTrack instanceof HTMLElement) {
          let pointerId: number | null = null;
          let startX = 0;
          let startScrollLeft = 0;
          let didDrag = false;
          let suppressClick = false;

          thumbnailTrack.addEventListener('dragstart', event => event.preventDefault());
          thumbnailTrack.addEventListener('pointerdown', event => {
            if (event.pointerType !== 'mouse' || event.button !== 0) return;
            pointerId = event.pointerId;
            startX = event.clientX;
            startScrollLeft = thumbnailTrack.scrollLeft;
            didDrag = false;
            suppressClick = false;
            stop();
            thumbnailTrack.setPointerCapture?.(event.pointerId);
          });
          thumbnailTrack.addEventListener('pointermove', event => {
            if (pointerId !== event.pointerId) return;
            const distance = event.clientX - startX;
            if (!didDrag && Math.abs(distance) < 6) return;
            didDrag = true;
            suppressClick = true;
            event.preventDefault();
            thumbnailTrack.classList.add('is-dragging');
            thumbnailTrack.scrollLeft = startScrollLeft - distance;
          });
          const finishThumbnailDrag = (event: PointerEvent) => {
            if (pointerId !== event.pointerId) return;
            if (thumbnailTrack.hasPointerCapture?.(event.pointerId)) thumbnailTrack.releasePointerCapture?.(event.pointerId);
            pointerId = null;
            thumbnailTrack.classList.remove('is-dragging');
            start();
          };
          thumbnailTrack.addEventListener('pointerup', finishThumbnailDrag);
          thumbnailTrack.addEventListener('pointercancel', finishThumbnailDrag);
          thumbnailTrack.addEventListener('click', event => {
            if (!suppressClick) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            suppressClick = false;
          }, true);
        }
        root.addEventListener('keydown', event => {
          if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          select(activeIndex + (event.key === 'ArrowRight' ? 1 : -1));
        });
        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', () => window.setTimeout(() => {
          if (!root.contains(document.activeElement)) start();
        }, 0));
        root.addEventListener('touchstart', stop, { passive: true });
        root.addEventListener('touchend', start, { passive: true });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stop();
          else start();
        });

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(entries => {
            isVisible = entries.some(entry => entry.isIntersecting);
            if (isVisible) start();
            else stop();
          }, { threshold: 0.2 });
          observer.observe(root);
        }

        show(0);
        start();
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup, { once: true });
    else setup();
  })();
</script>
