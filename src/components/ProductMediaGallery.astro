---
import PublicImage from './public/PublicImage.astro';
import { getLocaleFromPathname, ui } from '../data/i18n';

interface DetailImage {
  image: string;
  title?: string;
  caption?: string;
}

interface Props {
  detailImages?: DetailImage[];
  title: string;
}

type FeatureKind = 'examples' | 'customization' | 'finishes' | 'dimensions' | 'edges' | 'attachments' | 'packaging' | 'construction' | 'references';

const { detailImages = [], title } = Astro.props;
const locale = getLocaleFromPathname(Astro.url.pathname);
const spanish = locale === 'es';
const common = ui[locale].common;
const featureImages = Array.from(
  new Map(detailImages.filter(item => item.image).map(item => [item.image, item])).values()
);

const copy = spanish
  ? {
      eyebrow: 'Detalles del producto',
      title: 'Opciones visuales y referencias del producto',
      fallback: 'Referencia del producto',
      notes: {
        examples: 'Ejemplo real para comparar forma, relieve, color y proporción.',
        customization: 'Referencia para decidir cómo aplicar el logotipo, el color o la presentación.',
        finishes: 'Compara el tono del metal, el brillo y la textura antes de aprobar el diseño.',
        dimensions: 'Utiliza esta guía para comprobar el tamaño y la proporción del diseño final.',
        edges: 'Compara el perfil y el acabado del canto antes de confirmar la especificación.',
        attachments: 'Selecciona el cierre o accesorio según el uso previsto de la pieza.',
        packaging: 'Compara opciones de presentación para entrega, regalo o exposición.',
        construction: 'Referencia de forma, estructura y montaje para revisar el diseño.',
        references: 'Referencia visual para indicar el resultado deseado en la consulta.',
      },
    }
  : {
      eyebrow: 'Product details',
      title: 'Visual options and product references',
      fallback: 'Product reference',
      notes: {
        examples: 'A real product example for comparing shape, relief, color, and proportion.',
        customization: 'Use this reference to decide how the logo, color, or presentation should be applied.',
        finishes: 'Compare metal tone, reflectivity, and texture before approving the artwork.',
        dimensions: 'Use this guide to check the size and proportion of the finished design.',
        edges: 'Compare the edge profile and treatment before confirming the specification.',
        attachments: 'Choose the backing or attachment around how the finished piece will be used.',
        packaging: 'Compare presentation choices for delivery, gifting, or display.',
        construction: 'A form, structure, or assembly reference for reviewing the design.',
        references: 'A visual reference for showing the intended result in your inquiry.',
      },
    };

const classifyImage = (item: DetailImage): FeatureKind => {
  const value = `${item.image} ${item.title || ''} ${item.caption || ''}`.toLowerCase();
  if (/\/(?:gallery|product-images?)\//.test(value) && !value.includes('/_shared/')) return 'examples';
  if (/plating|finish|polished|sandblasted/.test(value)) return 'finishes';
  if (/edge-option|\/edges?\//.test(value)) return 'edges';
  if (/hardware|backing|clutch|ribbon|attachment/.test(value)) return 'attachments';
  if (/size-guide|dimension|comparison-guide/.test(value)) return 'dimensions';
  if (/packaging|presentation/.test(value)) return 'packaging';
  if (/construction|assembly/.test(value)) return 'construction';
  if (/customization|logo-method|artwork/.test(value)) return 'customization';
  return 'references';
};

const assetLabel = (item: DetailImage, fallback: string) => {
  const current = String(item.title || '').trim();
  if (current && !/(?:product reference|option|guide|reference)\s+\d+$/i.test(current)) return current;
  try {
    const filename = decodeURIComponent(new URL(item.image).pathname.split('/').pop() || '')
      .replace(/\.[a-z0-9]+$/i, '')
      .replace(/-[a-f0-9]{10}$/i, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    if (!filename || filename === 'asset') return fallback;
    return filename.replace(/\b\w/g, letter => letter.toUpperCase()).replace(/\b(2d|3d)\b/gi, value => value.toUpperCase());
  } catch {
    return fallback;
  }
};

const captionFor = (item: DetailImage, kind: FeatureKind) => {
  const caption = String(item.caption || '').trim();
  if (caption && !/(?:product reference supplied|reference supplied for|supplied for .* review)/i.test(caption)) return caption;
  return copy.notes[kind];
};

const cards = featureImages.map((item, index) => {
  const kind = classifyImage(item);
  return {
    ...item,
    kind,
    label: assetLabel(item, `${copy.fallback} ${index + 1}`),
    description: captionFor(item, kind),
  };
});
---

{cards.length > 0 && (
  <section id="product-gallery" class="product-content-band product-content-band--media" aria-label={`${title}: ${common.featureImages}`}>
    <div class="container product-reference-gallery">
      <header class="product-section-heading product-reference-gallery__heading">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2>{copy.title}</h2>
      </header>
      <div class="product-feature-image-grid">
        {cards.map(item => (
          <figure class="product-feature-image" data-feature-kind={item.kind}>
            <PublicImage src={item.image} alt={`${title}: ${item.label}`} loading="lazy" decoding="async" width="1400" height="1050" />
            <figcaption>
              <strong>{item.label}</strong>
              <span>{item.description}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
