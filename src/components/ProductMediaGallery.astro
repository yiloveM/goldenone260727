---
import PublicImage from './public/PublicImage.astro';
import { getLocaleFromPathname, ui } from '../data/i18n';

interface DetailImage {
  image: string;
  title?: string;
  caption?: string;
}

interface Props {
  detailImages?: DetailImage[];
  title: string;
}

const { detailImages = [], title } = Astro.props;
const featureImages = detailImages.filter(item => item.image);
const initialImages = featureImages.slice(0, 12);
const additionalImages = featureImages.slice(12);
const common = ui[getLocaleFromPathname(Astro.url.pathname)].common;
---

{featureImages.length > 0 && (
  <section id="product-gallery" class="product-content-band product-content-band--media" aria-label={`${title}: ${common.featureImages}`}>
    <div class="container product-reference-gallery">
      <header class="product-section-heading">
        <span class="eyebrow">{common.featureImages}</span>
        <h2>{title}</h2>
      </header>
      <div class="product-feature-image-grid">
        {initialImages.map(item => (
          <figure class="product-feature-image">
            <PublicImage src={item.image} alt={item.title || title} loading="lazy" decoding="async" width="1400" height="1050" />
            {(item.title || item.caption) && (
              <figcaption>
                {item.title && <strong>{item.title}</strong>}
                {item.caption && <span>{item.caption}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
      {additionalImages.length > 0 && (
        <details class="product-gallery-more">
          <summary>View {additionalImages.length} more reference images</summary>
          <div class="product-feature-image-grid">
            {additionalImages.map(item => (
              <figure class="product-feature-image">
                <PublicImage src={item.image} alt={item.title || title} loading="lazy" decoding="async" width="1400" height="1050" />
                {(item.title || item.caption) && (
                  <figcaption>
                    {item.title && <strong>{item.title}</strong>}
                    {item.caption && <span>{item.caption}</span>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </details>
      )}
    </div>
  </section>
)}
