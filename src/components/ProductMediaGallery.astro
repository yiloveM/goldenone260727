---
import PublicImage from './public/PublicImage.astro';
import { getLocaleFromPathname, ui } from '../data/i18n';

interface DetailImage {
  image: string;
  title?: string;
  caption?: string;
}

interface Props {
  detailImages?: DetailImage[];
  title: string;
}

type FeatureKind = 'examples' | 'customization' | 'finishes' | 'dimensions' | 'edges' | 'attachments' | 'packaging' | 'construction' | 'references';
type OptionGroupKind = 'plating' | 'edge' | 'additional';

const { detailImages = [], title } = Astro.props;
const locale = getLocaleFromPathname(Astro.url.pathname);
const spanish = locale === 'es';
const common = ui[locale].common;
const productTerm = title
  .replace(/^Custom\s+/i, '')
  .replace(/^Personalizad(?:o|a|os|as)\s+/i, '')
  .trim()
  .toLocaleLowerCase(spanish ? 'es' : 'en')
  .replace(/\b([23])d\b/g, '$1D')
  .replace(/\bpvc\b/g, 'PVC')
  .replace(/\bopp\b/g, 'OPP');
const featureImages = Array.from(
  new Map(detailImages.filter(item => item.image).map(item => [item.image, item])).values()
);

const copy = spanish
  ? {
      galleryEyebrow: 'Galería del producto',
      galleryTitle: 'Estilos y detalles del producto',
      optionsEyebrow: 'Opciones disponibles',
      optionsTitle: 'Explora acabados y opciones personalizadas',
      closePreview: 'Cerrar vista ampliada',
      openPreview: 'Abrir vista ampliada',
      optionsDescription: 'Compara cada grupo por separado para elegir con claridad el acabado, la forma y los detalles adecuados para tu proyecto.',
      groups: {
        plating: {
          title: 'Opciones de baño y acabado',
          description: 'Compara tonos de metal, brillo, color y tratamientos de superficie.',
        },
        edge: {
          title: 'Opciones de canto',
          description: 'Compara perfiles y tratamientos de canto que modifican el contorno final.',
        },
        form: {
          title: 'Opciones de tamaño y forma',
          description: 'Compara tamaños, proporciones, construcción y formas disponibles.',
        },
        additional: {
          title: 'Opciones adicionales',
          description: 'Compara métodos de logotipo, accesorios, cierres, embalajes y otros detalles del proyecto.',
        },
      },
      labels: {
        examples: `Diseño de ${productTerm}`,
        customization: `Personalización de ${productTerm}`,
        finishes: `Acabado de ${productTerm}`,
        dimensions: `Tamaño de ${productTerm}`,
        edges: `Canto de ${productTerm}`,
        attachments: `Accesorio de ${productTerm}`,
        packaging: `Embalaje de ${productTerm}`,
        construction: `Construcción de ${productTerm}`,
        references: `Opción de ${productTerm}`,
      },
      notes: {
        examples: `Explora ${productTerm} en diferentes formas, acabados, colores y proporciones.`,
        customization: `Opciones de logotipo y diseño disponibles para ${productTerm}.`,
        finishes: `Opciones de baño, color y acabado superficial para ${productTerm}.`,
        dimensions: `Opciones de tamaño y proporción para ${productTerm}.`,
        edges: `Perfiles y acabados de canto disponibles para ${productTerm}.`,
        attachments: `Cierres y accesorios disponibles para ${productTerm}.`,
        packaging: `Opciones de embalaje y presentación para ${productTerm}.`,
        construction: `Opciones de forma, construcción y montaje para ${productTerm}.`,
        references: `Opciones de diseño adicionales para ${productTerm}.`,
      },
    }
  : {
      galleryEyebrow: 'Product gallery',
      galleryTitle: 'Product styles and design details',
      optionsEyebrow: 'Available options',
      optionsTitle: 'Explore finishes and custom options',
      closePreview: 'Close enlarged image',
      openPreview: 'Open enlarged image',
      optionsDescription: 'Compare each group separately to choose the right finish, form, and supporting details for your project.',
      groups: {
        plating: {
          title: 'Plating Options',
          description: 'Compare metal tones, reflectivity, color treatments, and surface finishes.',
        },
        edge: {
          title: 'Edge Options',
          description: 'Compare edge profiles and treatments that change the finished outline.',
        },
        form: {
          title: 'Size & Form Options',
          description: 'Compare available sizes, proportions, construction, and forms.',
        },
        additional: {
          title: 'Additional Options',
          description: 'Compare logo methods, attachments, backings, packaging, and other project details.',
        },
      },
      labels: {
        examples: `${title} design`,
        customization: `${title} customization`,
        finishes: `${title} finish`,
        dimensions: `${title} size`,
        edges: `${title} edge`,
        attachments: `${title} attachment`,
        packaging: `${title} packaging`,
        construction: `${title} construction`,
        references: `${title} option`,
      },
      notes: {
        examples: `Explore ${productTerm} in different shapes, finishes, colors, and proportions.`,
        customization: `Logo and artwork options available for ${productTerm}.`,
        finishes: `Plating, color, and surface finish options for ${productTerm}.`,
        dimensions: `Size and proportion options for ${productTerm}.`,
        edges: `Edge profiles and treatments available for ${productTerm}.`,
        attachments: `Backing and attachment options for ${productTerm}.`,
        packaging: `Packaging and presentation options for ${productTerm}.`,
        construction: `Form, construction, and assembly options for ${productTerm}.`,
        references: `Additional design options for ${productTerm}.`,
      },
    };

const classifyImage = (item: DetailImage): FeatureKind => {
  const identity = `${item.image} ${item.title || ''}`.toLowerCase();
  const value = `${identity} ${item.caption || ''}`.toLowerCase();
  if (/\/(?:gallery|product-images?)\//.test(identity) && !identity.includes('/_shared/')) return 'examples';
  if (/pack(?:ag(?:e|ing)|ing)|presentation|gift[\s-]?box|velvet[\s-]?pouch|opp[\s-]?bag/.test(identity)) return 'packaging';
  if (/customization|logo-method|artwork/.test(identity)) return 'customization';
  if (/plating|finish|polished|sandblasted/.test(identity)) return 'finishes';
  if (/edge-option|\/edges?\//.test(identity)) return 'edges';
  if (/hardware|backing|clutch|ribbon|attachment/.test(identity)) return 'attachments';
  if (/size-guide|dimension|comparison-guide/.test(identity)) return 'dimensions';
  if (/construction|assembly/.test(identity)) return 'construction';
  if (/plating|finish|customization|logo|size|dimension|edge|hardware|backing|attachment|packaging/.test(value)) return 'customization';
  return 'references';
};

const assetLabel = (item: DetailImage, fallback: string) => {
  const current = String(item.title || '').trim();
  if (current && !/(?:product reference|option|guide|reference)\s+\d+$/i.test(current)) return current;
  try {
    const filename = decodeURIComponent(new URL(item.image).pathname.split('/').pop() || '')
      .replace(/\.[a-z0-9]+$/i, '')
      .replace(/-[a-f0-9]{10}$/i, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    if (!filename || filename === 'asset' || /^(?:[a-z]{1,5}[ -]?)?\d+(?:[ -]\d+)?$/i.test(filename)) return fallback;
    return filename.replace(/\b\w/g, letter => letter.toUpperCase()).replace(/\b(2d|3d)\b/gi, value => value.toUpperCase());
  } catch {
    return fallback;
  }
};

const captionFor = (item: DetailImage, kind: FeatureKind) => {
  const caption = String(item.caption || '').trim();
  if (caption && !/(?:product reference supplied|reference supplied for|supplied for .* review)/i.test(caption)) return caption;
  return copy.notes[kind];
};

const kindCounts = new Map<FeatureKind, number>();
const cards = featureImages.map(item => {
  const kind = classifyImage(item);
  const sequence = (kindCounts.get(kind) || 0) + 1;
  kindCounts.set(kind, sequence);
  return {
    ...item,
    kind,
    label: spanish ? `${copy.labels[kind]} ${sequence}` : assetLabel(item, `${copy.labels[kind]} ${sequence}`),
    description: captionFor(item, kind),
  };
});
const productCards = cards.filter(item => item.kind === 'examples');
const optionCards = cards.filter(item => item.kind !== 'examples');
const hasEdgeOptions = optionCards.some(item => item.kind === 'edges');
const optionGroupFor = (kind: FeatureKind): OptionGroupKind => {
  if (kind === 'finishes') return 'plating';
  if (kind === 'edges' || kind === 'dimensions' || kind === 'construction') return 'edge';
  return 'additional';
};
const optionGroupDefinitions = [
  {
    key: 'plating' as const,
    title: copy.groups.plating.title,
    description: copy.groups.plating.description,
  },
  {
    key: 'edge' as const,
    title: hasEdgeOptions ? copy.groups.edge.title : copy.groups.form.title,
    description: hasEdgeOptions ? copy.groups.edge.description : copy.groups.form.description,
  },
  {
    key: 'additional' as const,
    title: copy.groups.additional.title,
    description: copy.groups.additional.description,
  },
];
const optionGroups = optionGroupDefinitions
  .map(group => ({ ...group, cards: optionCards.filter(item => optionGroupFor(item.kind) === group.key) }))
  .filter(group => group.cards.length > 0);
const optionCountLabel = (count: number) => spanish
  ? `${count} ${count === 1 ? 'opción' : 'opciones'}`
  : `${count} ${count === 1 ? 'option' : 'options'}`;
---

{cards.length > 0 && (
  <section
    id="product-gallery"
    class:list={['product-content-band', 'product-content-band--media', { 'product-content-band--options-only': productCards.length === 0 }]}
    aria-label={`${title}: ${common.featureImages}`}
  >
    <div class="container product-reference-gallery">
      {productCards.length > 0 && (
        <div class="product-reference-gallery__main">
          <header class="product-section-heading product-reference-gallery__heading">
            <span class="eyebrow">{copy.galleryEyebrow}</span>
            <h2>{copy.galleryTitle}</h2>
          </header>
          <div class="product-feature-image-grid" data-product-reference-grid>
            {productCards.map(item => (
              <figure
                class="product-feature-image"
                data-feature-kind={item.kind}
                data-product-hover-card
                role="button"
                tabindex="0"
                aria-label={`${copy.openPreview}: ${item.label}`}
              >
                <PublicImage src={item.image} alt={`${title}: ${item.label}`} loading="lazy" decoding="async" width="1400" height="1050" />
                <figcaption>
                  <strong title={item.label}>{item.label}</strong>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
      {optionCards.length > 0 && (
        <section class="product-option-gallery" aria-label={copy.optionsTitle}>
          <header class="product-section-heading product-reference-gallery__heading product-option-gallery__heading">
            <span class="eyebrow">{copy.optionsEyebrow}</span>
            <h2>{copy.optionsTitle}</h2>
            <p>{copy.optionsDescription}</p>
          </header>
          <div class="product-option-browser" data-product-option-browser>
            <div
              class:list={[
                'product-option-category-tabs',
                { 'product-option-category-tabs--single': optionGroups.length === 1 },
                { 'product-option-category-tabs--pair': optionGroups.length === 2 },
              ]}
              role="tablist"
              aria-label={copy.optionsTitle}
            >
              {optionGroups.map((group, index) => (
                <a
                  id={`product-options-${group.key}-tab`}
                  class:list={['product-option-category-card', { 'is-active': index === 0 }]}
                  href={`#product-options-${group.key}`}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`product-options-${group.key}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-product-option-tab={group.key}
                >
                  <span class="product-option-category-card__media" aria-hidden="true">
                    <PublicImage src={group.cards[0].image} alt="" loading="eager" decoding="async" width="240" height="180" />
                  </span>
                  <span class="product-option-category-card__copy">
                    <strong>{group.title}</strong>
                    <span>{optionCountLabel(group.cards.length)}</span>
                  </span>
                </a>
              ))}
            </div>

            <div class="product-option-panels">
              {optionGroups.map((group, index) => (
                <section
                  id={`product-options-${group.key}`}
                  class:list={['product-option-panel', { 'is-active': index === 0 }]}
                  role="tabpanel"
                  aria-labelledby={`product-options-${group.key}-tab`}
                  data-product-option-panel={group.key}
                >
                  <header class="product-option-panel__heading">
                    <h3>{group.title}</h3>
                    <p>{group.description}</p>
                  </header>
                  <div
                    class:list={[
                      'product-feature-image-grid',
                      { 'product-feature-image-grid--single': group.cards.length === 1 },
                      { 'product-feature-image-grid--pair': group.cards.length === 2 },
                    ]}
                    data-product-option-grid
                  >
                    {group.cards.map(item => (
                      <figure
                        class="product-feature-image"
                        data-feature-kind={item.kind}
                        data-product-hover-card
                        role="button"
                        tabindex="0"
                        aria-label={`${copy.openPreview}: ${item.label}`}
                      >
                        <PublicImage src={item.image} alt={`${title}: ${item.label}`} loading="lazy" decoding="async" width="1400" height="1050" />
                        <figcaption>
                          <strong>{item.label}</strong>
                          <span>{item.description}</span>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
    <div class="product-image-hover-preview" data-product-hover-preview hidden aria-hidden="true">
      <figure class="product-image-hover-preview__panel" data-product-hover-preview-panel>
        <button class="product-image-hover-preview__close" type="button" data-product-hover-preview-close aria-label={copy.closePreview}>&#215;</button>
        <img data-product-hover-preview-image alt="" />
        <figcaption data-product-hover-preview-caption></figcaption>
      </figure>
    </div>
  </section>
)}

<script>
  const setupProductOptionBrowsers = () => {
    document.querySelectorAll<HTMLElement>('[data-product-option-browser]').forEach(browser => {
      if (browser.dataset.ready === 'true') return;
      browser.dataset.ready = 'true';

      const tabs = Array.from(browser.querySelectorAll<HTMLAnchorElement>('[data-product-option-tab]'));
      const panels = Array.from(browser.querySelectorAll<HTMLElement>('[data-product-option-panel]'));
      if (tabs.length === 0 || panels.length === 0) return;

      const activate = (key: string, moveFocus = false) => {
        tabs.forEach(tab => {
          const active = tab.dataset.productOptionTab === key;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && moveFocus) tab.focus();
        });
        panels.forEach(panel => {
          const active = panel.dataset.productOptionPanel === key;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      };

      browser.classList.add('is-enhanced');
      const requestedPanel = window.location.hash.replace('#product-options-', '');
      const initialKey = tabs.some(tab => tab.dataset.productOptionTab === requestedPanel)
        ? requestedPanel
        : tabs[0].dataset.productOptionTab || '';
      activate(initialKey);

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', event => {
          event.preventDefault();
          activate(tab.dataset.productOptionTab || '');
        });
        tab.addEventListener('keydown', event => {
          let nextIndex = index;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(tabs[nextIndex].dataset.productOptionTab || '', true);
        });
      });
    });
  };

  const setupProductHoverPreviews = () => {
    document.querySelectorAll<HTMLElement>('[data-product-hover-preview]').forEach(preview => {
      if (preview.dataset.ready === 'true') return;
      preview.dataset.ready = 'true';

      const gallery = preview.closest<HTMLElement>('#product-gallery');
      const panel = preview.querySelector<HTMLElement>('[data-product-hover-preview-panel]');
      const closeButton = preview.querySelector<HTMLButtonElement>('[data-product-hover-preview-close]');
      const previewImage = preview.querySelector<HTMLImageElement>('[data-product-hover-preview-image]');
      const previewCaption = preview.querySelector<HTMLElement>('[data-product-hover-preview-caption]');
      if (!gallery || !panel || !closeButton || !previewImage || !previewCaption) return;

      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      let openTimer = 0;
      let closeTimer = 0;

      const clearTimers = () => {
        window.clearTimeout(openTimer);
        window.clearTimeout(closeTimer);
      };
      const openPreview = (card: HTMLElement) => {
        const image = card.querySelector<HTMLImageElement>('img');
        const label = card.querySelector<HTMLElement>('figcaption strong');
        if (!image) return;
        clearTimers();
        const cardRect = card.getBoundingClientRect();
        const panelWidth = Math.min(760, window.innerWidth - 48);
        const panelHeight = Math.min(window.innerHeight * 0.82, 760);
        const edge = 24;
        const centerX = Math.min(
          window.innerWidth - panelWidth / 2 - edge,
          Math.max(panelWidth / 2 + edge, cardRect.left + cardRect.width / 2)
        );
        const centerY = Math.min(
          window.innerHeight - panelHeight / 2 - edge,
          Math.max(panelHeight / 2 + edge, cardRect.top + cardRect.height / 2)
        );
        panel.style.setProperty('--preview-x', `${centerX}px`);
        panel.style.setProperty('--preview-y', `${centerY}px`);
        previewImage.src = image.currentSrc || image.src;
        previewImage.alt = image.alt;
        previewCaption.textContent = label?.textContent?.trim() || image.alt;
        preview.hidden = false;
        preview.setAttribute('aria-hidden', 'false');
        window.requestAnimationFrame(() => preview.classList.add('is-visible'));
      };
      const closePreview = () => {
        window.clearTimeout(openTimer);
        preview.classList.remove('is-visible');
        preview.setAttribute('aria-hidden', 'true');
        closeTimer = window.setTimeout(() => {
          if (!preview.classList.contains('is-visible')) preview.hidden = true;
        }, 220);
      };
      const scheduleClose = () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(closePreview, 180);
      };

      gallery.querySelectorAll<HTMLElement>('[data-product-hover-card]').forEach(card => {
        card.addEventListener('pointerenter', event => {
          if (!canHover.matches || (event.pointerType && event.pointerType !== 'mouse')) return;
          clearTimers();
          openTimer = window.setTimeout(() => openPreview(card), 1000);
        });
        card.addEventListener('pointerleave', () => {
          if (canHover.matches) scheduleClose();
        });
        card.addEventListener('click', () => {
          openPreview(card);
        });
        card.addEventListener('keydown', event => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openPreview(card);
        });
      });

      panel.addEventListener('pointerenter', () => window.clearTimeout(closeTimer));
      panel.addEventListener('pointerleave', () => {
        if (canHover.matches) closePreview();
      });
      closeButton.addEventListener('click', closePreview);
      preview.addEventListener('click', event => {
        if (event.target === preview) closePreview();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closePreview();
      });
      window.addEventListener('scroll', closePreview, { passive: true });
      window.addEventListener('resize', closePreview, { passive: true });
    });
  };

  setupProductOptionBrowsers();
  setupProductHoverPreviews();
  document.addEventListener('astro:page-load', setupProductOptionBrowsers);
  document.addEventListener('astro:page-load', setupProductHoverPreviews);
</script>
