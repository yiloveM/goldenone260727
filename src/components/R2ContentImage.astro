---
import PublicImage from './public/PublicImage.astro';
type Props = {
  src?: string;
  alt?: string;
  caption?: string;
};

const { src = '', alt = '', caption = '' } = Astro.props;
---

{src ? (
  <figure class="r2-content-image">
    <PublicImage src={src} alt={alt} loading="lazy" decoding="async" />
    {caption ? <figcaption>{caption}</figcaption> : null}
  </figure>
) : null}

<style>
  .r2-content-image {
    margin: clamp(24px, 4vw, 42px) 0;
  }

  .r2-content-image img {
    background: rgba(237, 250, 253, 0.78);
    border: 1px solid rgba(94, 184, 205, 0.18);
    border-radius: 14px;
    box-shadow: 0 24px 58px rgba(0, 56, 78, 0.12);
    display: block;
    height: auto;
    max-height: 680px;
    object-fit: contain;
    width: 100%;
  }

  .r2-content-image figcaption {
    color: rgba(22, 63, 82, 0.72);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-top: 10px;
    text-align: center;
  }
</style>
