---
import { brandAssets } from '../data/assets';
import { getLocaleFromPathname, ui } from '../data/i18n';
import { siteUrl } from '../data/seo';

interface Props {
  url?: string;
  title: string;
  description?: string;
  image?: string;
  label?: string;
  className?: string;
}

const {
  url,
  title,
  description = '',
  image = brandAssets.heroCenter,
  label = 'Share',
  className = '',
} = Astro.props;

const baseUrl = siteUrl(Astro.site);
const common = ui[getLocaleFromPathname(Astro.url.pathname)].common;
const shareUrl = new URL(url || Astro.url.pathname, baseUrl).toString();
const shareImage = new URL(image, baseUrl).toString();
const shareText = [title, description].filter(Boolean).join(' - ');
const encodedUrl = encodeURIComponent(shareUrl);
const encodedTitle = encodeURIComponent(title);
const encodedText = encodeURIComponent(shareText);
const encodedImage = encodeURIComponent(shareImage);

const shareLinks = [
  {
    name: 'Facebook',
    className: 'a2a_button_facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    name: 'X',
    className: 'a2a_button_x',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    name: 'Pinterest',
    className: 'a2a_button_pinterest',
    href: `https://www.pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodedImage}&description=${encodedText}`,
  },
  {
    name: 'LinkedIn',
    className: 'a2a_button_linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
  {
    name: 'WhatsApp',
    className: 'a2a_button_whatsapp',
    href: `https://api.whatsapp.com/send?text=${encodedText}%20${encodedUrl}`,
  },
  {
    name: 'Email',
    className: 'a2a_button_email',
    href: `mailto:?subject=${encodedTitle}&body=${encodedText}%0A${encodedUrl}`,
  },
];
const addToAnyFallback = `https://www.addtoany.com/share?linkurl=${encodedUrl}&linkname=${encodedTitle}`;
---
<div class:list={['product-share', 'share-buttons', className]} aria-label={`${common.share}: ${title}`}>
  <span>{label}</span>
  <div class="a2a_kit a2a_kit_size_32 a2a_default_style addtoany-button-row" data-a2a-url={shareUrl} data-a2a-title={shareText}>
    {shareLinks.map(link => (
      <a
        class={link.className}
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener' : undefined}
        title={`${common.shareOn} ${link.name}`}
        aria-label={`${common.share}: ${title} / ${link.name}`}
      ></a>
    ))}
    <a class="a2a_dd" href={addToAnyFallback} target="_blank" rel="noopener" title={common.share} aria-label={`${common.share}: ${title}`}></a>
  </div>
</div>
<script is:inline>
  (() => {
    const scriptId = 'addtoany-page-script';
    const existing = document.getElementById(scriptId);
    if (existing) {
      const addToAny = Reflect.get(window, 'a2a');
      if (addToAny && typeof addToAny.init_all === 'function') addToAny.init_all();
      return;
    }
    const script = document.createElement('script');
    script.id = scriptId;
    script.src = 'https://static.addtoany.com/menu/page.js';
    script.async = true;
    document.head.appendChild(script);
  })();
</script>
