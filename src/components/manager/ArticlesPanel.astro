<section class="section" data-panel="blog">
        <div class="grid">
          <aside class="panel manager-view is-visible" id="blogBrowserView">
            <div class="panel-head">
              <div>
                <h2>博客</h2>
                <span id="blogCount">加载中</span>
              </div>
              <button class="button secondary" id="newBlogButton" type="button">新建文章草稿</button>
            </div>
            <div class="toolbar is-row">
              <input id="blogSearchInput" type="search" placeholder="搜索文章标题或分类" />
              <button class="button secondary" id="blogRefreshButton" type="button">刷新文章</button>
            </div>
            <div class="blog-list" id="blogList"></div>
          </aside>

          <section class="panel manager-view" id="blogEditorView">
            <div class="panel-head">
              <div>
                <h2>文章草稿</h2>
                <span>支持文章标题、封面、摘要、分类、发布日期和正文。</span>
              </div>
              <button class="button secondary" id="blogBackButton" type="button">返回博客列表</button>
            </div>
            <form class="form" id="blogForm">
              <div class="field">
                <label for="blogTitle">文章标题</label>
                <input id="blogTitle" required />
              </div>
              <div class="field">
                <label for="blogSlug">文章页面标识</label>
                <input id="blogSlug" readonly />
              </div>
              <div class="field">
                <label for="blogCategory">文章分类</label>
                <input id="blogCategory" required />
              </div>
              <div class="field">
                <label for="blogPublishDate">发布时间</label>
                <input id="blogPublishDate" type="datetime-local" required />
              </div>
              <div class="field">
                <label for="blogAuthor">作者</label>
                <input id="blogAuthor" />
              </div>
              <div class="field">
                <label>首页推荐</label>
                <span class="toggle">
                  <input id="blogFeatured" type="checkbox" />
                  <span>推荐显示该文章</span>
                </span>
              </div>
              <div class="field is-wide">
                <label for="blogImage">文章封面链接</label>
                <div class="input-action">
                  <input id="blogImage" placeholder="可从图片池选择或粘贴图片链接" />
                  <button class="button secondary" data-image-field="blogImage" data-image-title="选择文章封面" type="button">选择图片</button>
                </div>
              </div>
              <div class="field is-wide">
                <label for="blogDescription">文章摘要</label>
                <textarea id="blogDescription" required></textarea>
              </div>
              <div class="field is-wide">
                <label for="blogBody">文章正文</label>
                <textarea id="blogBody" required style="min-height: 420px;"></textarea>
              </div>
            </form>
            <div class="actions">
              <button class="button" id="saveBlogDraftButton" type="button">保存文章草稿</button>
              <button class="button secondary" id="reloadBlogDraftButton" type="button">刷新草稿</button>
              <a class="button secondary" id="viewBlogButton" href="#" target="_blank" rel="noreferrer">前端查看</a>
              <span class="status" id="blogStatus">请选择一篇文章。</span>
            </div>
            <div class="drafts" id="blogDraftWorkList"></div>
          </section>
        </div>
      </section>
