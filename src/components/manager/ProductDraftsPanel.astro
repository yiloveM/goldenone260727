<section class="section" data-panel="product-drafts">
        <section class="panel">
          <div class="panel-head">
            <div>
              <h2>产品翻译草稿</h2>
              <span>逐条预览产品多语言草稿，也可以勾选多条一键审核。</span>
            </div>
          </div>
          <div class="toolbar is-row">
            <span class="toggle">
              <input id="productDraftIncludePublished" type="checkbox" />
              <span>显示已审核</span>
            </span>
            <button class="button secondary" id="productDraftRefreshButton" type="button">刷新草稿</button>
            <button class="button" id="productDraftApproveButton" type="button">一键审核选中草稿</button>
            <span class="status" id="productDraftStatus">草稿列表未加载。</span>
          </div>
          <div class="history" id="productDraftList"></div>
        </section>
      </section>
