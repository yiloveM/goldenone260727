<section class="section" data-panel="product-order">
        <section class="panel">
          <div class="panel-head">
            <div class="order-panel-copy">
              <h2>产品管理 · 调整顺序</h2>
              <div class="order-panel-meta">
                <span>拖动卡片、前后移动或填写顺序，保存后整批审核。</span>
                <span class="status" id="orderStatus">排序列表未加载。</span>
              </div>
            </div>
            <button class="button" id="orderSaveButton" type="button">保存排序草稿</button>
            <button class="button secondary" data-workspace-target="products" type="button">返回产品列表</button>
          </div>
          <div class="toolbar is-row order-toolbar">
            <input id="orderSearchInput" type="search" placeholder="搜索产品名称或系列" />
            <select id="orderCategoryFilter">
              <option value="">所有分类</option>
            </select>
          </div>
          <div class="order-grid" id="orderGrid"></div>
        </section>
      </section>
