<section class="section" data-panel="publish">
        <section class="panel">
          <div class="panel-head">
            <div>
              <h2>发布网站更新</h2>
              <span>内容全部检查完成后再提交发布。一次点击只触发一次后台发布任务。</span>
            </div>
          </div>
          <div class="actions" style="padding-top: 20px;">
            <button class="button" id="publishButton" type="button">发布网站更新</button>
            <button class="button secondary" id="publishHistoryButton" type="button">刷新最近记录</button>
            <button class="button secondary" id="publishDeleteButton" type="button">删除选中记录</button>
            <span class="status" id="publishStatus">未提交发布。</span>
          </div>
          <div class="history" id="publishHistory"></div>
        </section>
      </section>
