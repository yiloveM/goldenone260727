---
import siteOrigin from '../../data/site-origin.json';
interface Props {
  managerOwner: string;
  managerSiteName: string;
  managerReviewSystemEnabled: boolean;
  managerAnalyticsEnabled: boolean;
}
const { managerOwner, managerSiteName, managerReviewSystemEnabled, managerAnalyticsEnabled } = Astro.props;
---

<aside class="sidebar" id="managerSidebar">
          <button class="button secondary manager-menu-close" id="managerMenuClose" type="button">关闭工作区</button>
          <div class="brand-mark">
            <a href={new URL('/', siteOrigin.productionUrl).href} aria-label="返回网站首页">
              <strong>{managerSiteName}</strong>
              <span>内容管理</span>
            </a>
          </div>
          <section class="connection-panel" id="connectionPanel" hidden>
            <div class="connection-copy">
              <strong id="connectionTitle"></strong>
              <span id="connectionDetail"></span>
            </div>
          </section>
          <div class="theme-switch" aria-label="显示模式">
            <button class="theme-switch__trigger" id="themeMenuButton" type="button" aria-haspopup="menu" aria-expanded="false">
              <span id="themeMenuLabel">跟随系统</span>
              <span class="theme-switch__chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="theme-switch__menu" id="themeMenu" role="menu" hidden>
              <button data-theme-option="light" type="button" role="menuitem">浅色</button>
              <button data-theme-option="dark" type="button" role="menuitem">深色</button>
              <button data-theme-option="system" type="button" role="menuitem">跟随系统</button>
            </div>
          </div>
          <div class="user-pill" id="managerEmail" hidden></div>
          <nav class="tabs" aria-label="Manager sections">
            <div class="nav-group">
              <span class="nav-group-label">内容</span>
              <button class="tab is-active" data-tab="dashboard" type="button">工作台</button>
              <button class="tab" data-tab="products" type="button">产品管理</button>
              <button class="tab" data-tab="blog" type="button">所有文章</button>
              <button class="tab" data-tab="reviews" type="button" hidden={!managerReviewSystemEnabled}>客户评价</button>
              <button class="tab" data-workspace="translation" type="button">翻译</button>
              <button class="tab" data-tab="visuals" type="button">站点视觉</button>
              <button class="tab" data-tab="publish" type="button">发布网站更新</button>
            </div>
            <div class="nav-group">
              <span class="nav-group-label">媒体</span>
              <button class="tab" data-tab="images" type="button">媒体资源</button>
            </div>
              <div class="nav-group" id="managerAnalyticsGroup" hidden={!managerAnalyticsEnabled}>
                <span class="nav-group-label">数据</span>
                <a class="tab tab-link" id="managerAnalyticsLink" href="#">网站访问分析</a>
              </div>
          </nav>
          <small class="manager-owner">站点维护：{managerOwner}</small>
        </aside>
