<section class="section" data-panel="translation-editor" id="translationEditor">
        <section class="panel translation-editor-page">
          <div class="panel-head">
            <div>
              <h2 id="translationEditorTitle">编辑翻译草稿</h2>
              <span>保存保留当前审核状态；未审核的内容确认无误后点“审核通过”，再统一发布网站更新。</span>
            </div>
            <button class="button secondary" id="translationEditorCloseButton" type="button">返回草稿列表</button>
          </div>
          <div class="translation-editor-body">
            <form class="translation-editor-form" id="translationEditorForm">
              <label>
                标题
                <input id="translationEditTitle" required />
              </label>
              <label>
                SEO 描述
                <textarea id="translationEditDescription" required></textarea>
              </label>
              <label class="translation-edit-product">
                分类名
                <input id="translationEditCategoryName" />
              </label>
              <label class="translation-edit-product">
                系列 / 型号
                <input id="translationEditSeries" />
              </label>
              <label class="translation-edit-blog">
                文章分类
                <select id="translationEditCategory" disabled><option value="company-news">公司新闻动态</option><option value="technical-articles">技术文章</option><option value="other-articles">其它文章</option></select>
              </label>
              <div class="translation-edit-product translation-editor-structured">
                <div class="builder">
                  <div class="builder-head">
                    <strong>应用场景</strong>
                    <button class="mini-button" data-action="applications:add" type="button">添加应用场景</button>
                  </div>
                  <div class="builder-list" id="translationApplicationsList"></div>
                </div>
                <div class="builder">
                  <div class="builder-head">
                    <strong>关键产品参数</strong>
                    <button class="mini-button" data-action="specs:add" type="button">添加参数</button>
                  </div>
                  <div class="builder-list" id="translationSpecsList"></div>
                </div>
                <div class="builder">
                  <div class="builder-head">
                    <strong>产品亮点</strong>
                    <button class="mini-button" data-action="highlights:add" type="button">添加亮点</button>
                  </div>
                  <div class="builder-list" id="translationHighlightsList"></div>
                </div>
                <div class="builder">
                  <div class="builder-head">
                    <strong>常见问题</strong>
                    <button class="mini-button" data-action="faqs:add" type="button">添加 FAQ</button>
                  </div>
                  <div class="builder-list" id="translationFaqsList"></div>
                </div>
                <div class="builder">
                  <div class="builder-head">
                    <strong>型号参数表</strong>
                    <button class="mini-button" data-action="tables:add" type="button">添加参数表</button>
                  </div>
                  <div class="builder-list" id="translationSpecTablesList"></div>
                </div>
              </div>
              <label>
                文章正文
                <textarea class="translation-body-editor" id="translationEditBody"></textarea>
              </label>
              <div class="translation-publish-row">
                <input id="translationEditPublished" type="checkbox" hidden />
                <a class="button secondary" id="translationEditorPreviewLink" href="#" data-auth-preview="" data-preview-status="translationEditorStatus" target="_blank" rel="noreferrer">预览当前草稿</a>
              </div>
            </form>
          </div>
          <div class="translation-editor-actions">
            <button class="button" id="translationEditorSaveButton" type="button">保存草稿</button>
            <button class="button secondary" id="translationEditorApproveButton" type="button">审核通过</button>
            <button class="button secondary" id="translationEditorCancelButton" type="button">返回草稿列表</button>
            <span class="status" id="translationEditorStatus">请选择一条翻译草稿。</span>
          </div>
        </section>
      </section>
