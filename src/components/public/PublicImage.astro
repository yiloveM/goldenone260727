---
import type { HTMLAttributes } from 'astro/types';
import { getR2WebpDeliveryUrl } from '../../lib/r2-image-delivery';

type Layout = 'responsive' | 'cover' | 'fixed';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
  layout?: Layout;
}

const { src, alt, layout = 'responsive', style, ...rest } = Astro.props as Props;
const deliveryMode = import.meta.env.PUBLIC_R2_IMAGE_DELIVERY_MODE;
const assetBaseUrl = import.meta.env.PUBLIC_R2_ASSET_BASE_URL;
const webpSrc = getR2WebpDeliveryUrl(src, assetBaseUrl, deliveryMode);
const layoutStyle = {
  responsive: 'display:block',
  cover: 'display:block;width:100%;height:100%;object-fit:cover',
  fixed: 'display:block',
}[layout];
const finalStyle = [layoutStyle, style].filter(Boolean).join(';');
---

<picture style="display:block">
  {webpSrc ? <source srcset={webpSrc} type="image/webp" /> : null}
  <img src={src} alt={alt} style={finalStyle} {...rest} />
</picture>
