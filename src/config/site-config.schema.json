{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "modules": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "object",
          "properties": {
            "navigation": {
              "type": "string",
              "const": "standard"
            },
            "footer": {
              "type": "string",
              "const": "standard"
            }
          },
          "required": [
            "navigation",
            "footer"
          ],
          "additionalProperties": false
        },
        "home": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,49}$"
              },
              "variant": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,49}$"
              },
              "contentKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,49}$"
              }
            },
            "required": [
              "id",
              "variant",
              "contentKey"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "shell",
        "home"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "technical",
            "product-led",
            "editorial",
            "service-led",
            "reference-led"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "motion": {
          "type": "string",
          "enum": [
            "reduced",
            "subtle"
          ]
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[a-f\\d]{6}$"
        },
        "accentStrong": {
          "type": "string",
          "pattern": "^#[a-f\\d]{6}$"
        },
        "accentSoft": {
          "type": "string",
          "pattern": "^#[a-f\\d]{6}$"
        }
      },
      "required": [
        "direction",
        "density",
        "motion",
        "accentColor",
        "accentStrong",
        "accentSoft"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "verification": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "signed-captcha",
                "turnstile"
              ]
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "downloads": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "direct",
                "protected"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "reviews": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "inquiryCart": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "visible"
          ],
          "additionalProperties": false
        },
        "managerAnalytics": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "visible"
          ],
          "additionalProperties": false
        },
        "articlePublisher": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "research": {
              "type": "boolean"
            },
            "bodyImage": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "research",
            "bodyImage"
          ],
          "additionalProperties": false
        },
        "aiDiscovery": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "multilingual": {
              "type": "boolean"
            },
            "markdown": {
              "type": "boolean"
            },
            "llmsFull": {
              "type": "boolean"
            },
            "include": {
              "type": "object",
              "properties": {
                "products": {
                  "type": "boolean"
                },
                "categories": {
                  "type": "boolean"
                },
                "articles": {
                  "type": "boolean"
                },
                "company": {
                  "type": "boolean"
                },
                "resources": {
                  "type": "boolean"
                },
                "contact": {
                  "type": "boolean"
                }
              },
              "required": [
                "products",
                "categories",
                "articles",
                "company",
                "resources",
                "contact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "multilingual",
            "markdown",
            "llmsFull",
            "include"
          ],
          "additionalProperties": false
        },
        "productEditing": {
          "type": "object",
          "properties": {
            "offeringType": {
              "type": "string",
              "enum": [
                "physical-product",
                "service",
                "solution"
              ]
            },
            "modelStrategy": {
              "type": "string",
              "enum": [
                "single-model",
                "series",
                "configurable",
                "not-applicable"
              ]
            }
          },
          "required": [
            "offeringType",
            "modelStrategy"
          ],
          "additionalProperties": false
        },
        "manager": {
          "type": "object",
          "properties": {
            "products": {
              "type": "boolean"
            },
            "articles": {
              "type": "boolean"
            },
            "translations": {
              "type": "boolean"
            },
            "visuals": {
              "type": "boolean"
            },
            "media": {
              "type": "boolean"
            },
            "publishing": {
              "type": "boolean"
            }
          },
          "required": [
            "products",
            "articles",
            "translations",
            "visuals",
            "media",
            "publishing"
          ],
          "additionalProperties": false
        },
        "visuals": {
          "type": "object",
          "properties": {
            "editableSlots": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(home|pages|category)\\.[a-zA-Z0-9-]+$"
              }
            }
          },
          "required": [
            "editableSlots"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "verification",
        "downloads",
        "reviews",
        "inquiryCart",
        "managerAnalytics",
        "articlePublisher",
        "aiDiscovery",
        "productEditing",
        "manager",
        "visuals"
      ],
      "additionalProperties": false
    },
    "locales": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "en"
        },
        "selected": {
          "maxItems": 19,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "zh",
              "ar",
              "hi",
              "es",
              "fr",
              "bn",
              "pt",
              "ru",
              "ur",
              "de",
              "tr",
              "fil",
              "ko",
              "uz",
              "ja",
              "ms",
              "nl",
              "el",
              "th"
            ]
          }
        }
      },
      "required": [
        "source",
        "selected"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "modules",
    "design",
    "features",
    "locales"
  ],
  "additionalProperties": false
}
