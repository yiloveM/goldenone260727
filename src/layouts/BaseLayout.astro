---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/astrowind-visual-foundation.css';
import { brandAssets } from '../data/assets';
import { siteInfo, socialLinks } from '../data/site';
import { industryProfile, visualTokens } from '../data/industry-profile';
import { buildProductCategories, isProductPublished } from '../data/productCategories';
import { absoluteUrl, organizationStructuredData, siteUrl, webPageStructuredData, websiteStructuredData } from '../data/seo';
import InquiryCart from '../components/InquiryCart.astro';
import BackToTop from '../components/BackToTop.astro';
import {
  type Locale,
  alternateUrls,
  getLocaleFromPathname,
  isActiveLocale,
  localeMeta,
  locales,
  localizePath,
  localizedProduct,
  stripLocaleFromPath,
  translateProductCategories,
  ui,
} from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  preloadHomeHero?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}

const {
  title = siteInfo.name,
  description,
  image = brandAssets.heroRippleDesktop,
  type = 'website',
  preloadHomeHero = false,
  structuredData = [],
  locale,
} = Astro.props;

const pageLocale = locale || getLocaleFromPathname(Astro.url.pathname);
const isContactPage = /^\/contact\/?$/.test(stripLocaleFromPath(Astro.url.pathname));
const localeInfo = localeMeta[pageLocale];
const dictionary = ui[pageLocale];
const pageDescription = description || siteInfo.description;
const siteBase = siteUrl(Astro.site);
const pageIsActiveLocale = isActiveLocale(pageLocale);
const canonical = new URL(pageIsActiveLocale ? Astro.url.pathname : stripLocaleFromPath(Astro.url.pathname), siteBase);
const canonicalUrl = canonical.toString();
const pageTitle = title === siteInfo.name ? `${siteInfo.name} | ${dictionary.siteTagline}` : `${title} | ${siteInfo.name}`;
const socialImage = absoluteUrl(image, siteBase);
const providedStructuredDataItems = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(Boolean);
const mainEntityId = providedStructuredDataItems.find(item => {
  const type = item?.['@type'];
  const types = Array.isArray(type) ? type : [type];
  return types.some(itemType => ['Product', 'ProductGroup', 'Article', 'FAQPage'].includes(String(itemType)));
})?.['@id'];
const coreStructuredDataItems = [
  organizationStructuredData(siteBase),
  websiteStructuredData(siteBase),
  webPageStructuredData(
    {
      name: pageTitle,
      description: pageDescription,
      url: canonicalUrl,
      image: socialImage,
      language: localeInfo.htmlLang,
      mainEntityId: typeof mainEntityId === 'string' ? mainEntityId : undefined,
    },
    siteBase
  ),
];
const structuredDataItems = [...coreStructuredDataItems, ...providedStructuredDataItems].reduce<Record<string, unknown>[]>((items, item) => {
  const key = `${item['@id'] || item['url'] || ''}|${item['@type'] || ''}`;
  if (key !== '|' && items.some(existing => `${existing['@id'] || existing['url'] || ''}|${existing['@type'] || ''}` === key)) {
    return items;
  }
  return [...items, item];
}, []);
const navCategories = translateProductCategories(buildProductCategories((await getCollection('products')).filter(isProductPublished)), pageLocale);
const alternates = alternateUrls(Astro.url.pathname, siteBase);
const languageOptions = locales.map(locale => ({
  locale,
  href: localizePath(Astro.url.pathname, locale),
  active: locale === pageLocale,
  ...localeMeta[locale],
}));
const latinFontHref =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500;600;700;800&display=swap';
const fontHrefByLocale: Record<Locale, string> = {
  en: latinFontHref,
  es: latinFontHref,
  pt: latinFontHref,
  fr: latinFontHref,
  ru: latinFontHref,
  de: latinFontHref,
  tr: latinFontHref,
  fil: latinFontHref,
  uz: latinFontHref,
  zh: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+SC:wght@400;500;600;700;800;900&display=swap',
  ar: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Arabic:wght@400;500;600;700;800;900&display=swap',
  hi: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&display=swap',
  ur: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap',
  bn: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Bengali:wght@400;500;600;700;800;900&display=swap',
  ko: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap',
};
const fontHref = fontHrefByLocale[pageLocale];
const visualTokenStyle = `:root { --aqua: ${visualTokens.accent}; --accent-strong: ${visualTokens.accentStrong}; --mint: ${visualTokens.accentSoft}; }`;
const imageOrigins = Array.from(new Set([image, brandAssets.heroRippleDesktop, ...brandAssets.heroFloatingProducts]
  .filter(Boolean)
  .map(item => {
    try {
      return new URL(item, siteBase).origin;
    } catch {
      return '';
    }
  })
  .filter(origin => origin && origin !== new URL(siteBase).origin)));
const preloadPageImage = !preloadHomeHero && image;
const footerCategoryLinks = navCategories.slice(0, 6);
const hasEmail = Boolean(siteInfo.email);
const hasPhone = Boolean(siteInfo.phone);
const hasWhatsApp = /^https:\/\//i.test(siteInfo.whatsapp);
const utilityLabel = pageLocale === 'es'
  ? 'Regalos metálicos personalizados para programas OEM'
  : 'Custom metal gifts for OEM programs';
---
<!doctype html>
<html lang={localeInfo.htmlLang} dir={localeInfo.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={pageIsActiveLocale ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta name="author" content={siteInfo.name} />
    <meta name="theme-color" content={visualTokens.accent} />
    <meta name="application-name" content={siteInfo.name} />
    <meta name="apple-mobile-web-app-title" content={siteInfo.name} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-goldenone-32.png" />
    <link rel="icon" type="image/svg+xml" href={brandAssets.icon} />
    <link rel="apple-touch-icon" sizes="180x180" href="/goldenone-apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map(locale => <link rel="alternate" hreflang={localeMeta[locale].htmlLang} href={alternates[locale]} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteInfo.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={localeInfo.ogLocale} />
    {locales.filter(locale => locale !== pageLocale).map(locale => <meta property="og:locale:alternate" content={localeMeta[locale].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    {imageOrigins.map(origin => <link rel="dns-prefetch" href={origin} />)}
    {imageOrigins.map(origin => <link rel="preconnect" href={origin} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    {preloadPageImage && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    {preloadHomeHero && (
      <>
        <link rel="preload" as="image" href={brandAssets.heroRippleDesktop} media="(min-width: 769px)" fetchpriority="high" />
        <link rel="preload" as="image" href={brandAssets.heroRippleMobile} media="(max-width: 768px)" fetchpriority="high" />
      </>
    )}
    {structuredDataItems.map(item => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <style is:inline set:html={visualTokenStyle}></style>
  </head>
  <body>
    <header class="site-header astrowind-site-header" data-visual-foundation="astrowind">
      <div class="nav-utility">
        <div class="container nav-utility__inner">
          <span>{utilityLabel}</span>
          <div>
            {hasEmail && <a href={`mailto:${siteInfo.email}`}><bdi dir="ltr">{siteInfo.email}</bdi></a>}
            {hasPhone && <a href={`tel:${siteInfo.phone}`}><bdi dir="ltr">{siteInfo.phone}</bdi></a>}
          </div>
        </div>
      </div>
      <nav class="container nav" aria-label="Main navigation">
        <a class="logo" href={localizePath('/', pageLocale)} aria-label={`${siteInfo.name} home`}>
          <img class="logo-image" src={brandAssets.logo} alt={`${siteInfo.name} logo`} width="154" height="60" decoding="async" />
        </a>
        <button class="mobile-toggle" aria-label={dictionary.nav.toggleMenu} aria-expanded="false" data-menu-toggle>
          <span></span><span></span><span></span>
        </button>
        <div class="nav-links" data-nav-links>
          <div class="nav-primary">
            <div class="nav-item nav-products" data-products-nav>
              <a class="nav-trigger" href={localizePath('/products/', pageLocale)} aria-haspopup={navCategories.length ? 'true' : undefined} aria-expanded="false" data-products-trigger>
                {dictionary.nav.products}
                <span class="nav-chevron" aria-hidden="true"></span>
              </a>
              {navCategories.length > 0 && (
                <div class="mega-menu" aria-label="Product category navigation">
                  <div class="mega-menu-shell">
                    <div class="mega-category-list">
                      {navCategories.map(category => (
                        <div class="mega-category-item">
                          <a class="mega-category-link" href={category.href}>
                            <span>{category.displayName || category.name}</span>
                          </a>
                          <div class="mega-product-flyout" aria-label={`${category.name} products`}>
                            {category.products.map(product => {
                              const item = localizedProduct(product, pageLocale);
                              return <a href={localizePath(`/products/${product.id.replace(/\.mdoc$/, '')}/`, pageLocale)}>{item.title}</a>;
                            })}
                            <a class="mega-view-all" href={category.href}>{dictionary.nav.viewAll} {category.displayName || category.name}</a>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>
            <a href={localizePath('/blog/', pageLocale)}>{dictionary.nav.engineeringNotes}</a>
            <a href={localizePath('/about/', pageLocale)}>{dictionary.nav.about}</a>
            <a href={localizePath('/faq/', pageLocale)}>{dictionary.nav.faq}</a>
          </div>
          <div class="nav-actions">
            <div class="language-switcher" data-language-switcher>
              <button class="language-trigger" type="button" aria-label={dictionary.nav.language} aria-haspopup="menu" aria-expanded="false" data-language-trigger>
                <span class="language-code">{localeInfo.label}</span>
                <span class="nav-chevron" aria-hidden="true"></span>
              </button>
              <div class="language-menu" role="menu" aria-label={dictionary.nav.language}>
                {languageOptions.map(option => (
                  <a
                    class={option.active ? 'language-option is-active' : 'language-option'}
                    href={option.href}
                    hreflang={option.htmlLang}
                    lang={option.htmlLang}
                    dir="ltr"
                    role="menuitem"
                    aria-current={option.active ? 'page' : undefined}
                  >
                    <strong>{option.label}</strong>
                  </a>
                ))}
              </div>
            </div>
            <a class="nav-quote" href={localizePath('/contact/', pageLocale)}>
              {dictionary.common.requestQuote}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </nav>
    </header>
    <slot />
    {!isContactPage && <InquiryCart locale={pageLocale} />}
    <BackToTop label={dictionary.common.backToTop} />
    <div class:list={['side-contact', { 'side-contact--contact-page': isContactPage }]} aria-label={dictionary.sideContact.label}>
      {hasWhatsApp && <a class="side-contact-link side-contact-link--whatsapp" href={siteInfo.whatsapp} target="_blank" rel="noopener" title="WhatsApp" aria-label={`Contact ${siteInfo.name} on WhatsApp`}>
        <span class="side-contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M20.5 11.8a8.4 8.4 0 0 1-12.4 7.4L4 20l.9-3.9a8.4 8.4 0 1 1 15.6-4.3Z" />
            <path d="M9.1 8.7c.3-.4.8-.4 1.1 0l.8.9c.2.2.3.6.1.9l-.3.7c.6 1.1 1.5 2 2.6 2.6l.8-.3c.3-.1.6 0 .9.2l.9.8c.3.3.3.8 0 1.1-.6.7-1.6.7-2.7.3-2.3-.8-4.3-2.8-5.1-5.1-.4-1.1-.3-2 .5-2.8Z" />
          </svg>
        </span>
        <span class="side-contact-note"><strong>{dictionary.sideContact.whatsapp}</strong><small>{dictionary.sideContact.whatsappNote}</small></span>
      </a>}
      <a class="side-contact-link" href={localizePath('/contact/', pageLocale)} title="Contact" aria-label="Send inquiry">
        <span class="side-contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M4.5 6.5h15v11h-15Z" />
            <path d="m5 7 7 6 7-6" />
            <path d="m8.4 11.5-3.4 3.2M15.6 11.5l3.4 3.2" />
          </svg>
        </span>
        <span class="side-contact-note"><strong>{dictionary.sideContact.inquiry}</strong><small>{dictionary.sideContact.inquiryNote}</small></span>
      </a>
    </div>
    <footer class="footer">
      <div class="container footer-shell">
        <div class="footer-brand-card">
          <a class="footer-brand-lockup" href={localizePath('/', pageLocale)} aria-label={`${siteInfo.name} home`}>
            <img src={brandAssets.icon} alt="" loading="lazy" decoding="async" width="46" height="46" />
            <span>
              <strong>{siteInfo.name}</strong>
              <small>{industryProfile.market.industry}</small>
            </span>
          </a>
          <p dir={localeInfo.dir}>{pageDescription}</p>
          <div class="footer-socials" aria-label={`${siteInfo.name} social media`}>
            {socialLinks.map(link => (
              <a class="social-button" href={link.href} target="_blank" rel="noopener" aria-label={`Visit ${siteInfo.name} on ${link.name}`}>
                <span aria-hidden="true"><img src={link.icon} alt="" loading="lazy" decoding="async" width="18" height="18" /></span>
                <small>{link.name}</small>
              </a>
            ))}
          </div>
        </div>
        <div class="footer-links-panel">
          <div class="footer-grid">
            <div>
              <strong>{dictionary.footer.productWorlds}</strong>
              {footerCategoryLinks.length > 0 ? footerCategoryLinks.map(link => <a href={link.href}>{link.displayName || link.name}</a>) : <a href={localizePath('/products/', pageLocale)}>{dictionary.footer.allProducts}</a>}
            </div>
            <div>
              <strong>{dictionary.footer.explore}</strong>
              <a href={localizePath('/products/', pageLocale)}>{dictionary.footer.allProducts}</a>
              <a href={localizePath('/blog/', pageLocale)}>{dictionary.nav.engineeringNotes}</a>
              <a href={localizePath('/faq/', pageLocale)}>{dictionary.nav.faq}</a>
              <a href="/sitemap-index.xml">{dictionary.footer.sitemap}</a>
            </div>
            <div>
              <strong>{dictionary.footer.company}</strong>
              <a href={localizePath('/about/', pageLocale)}>{dictionary.nav.about}</a>
              <a href={localizePath('/contact/', pageLocale)}>{dictionary.nav.contact}</a>
              {hasWhatsApp && <a href={siteInfo.whatsapp} target="_blank" rel="noopener">{dictionary.footer.whatsappInquiry}</a>}
              {hasPhone && <a href={`tel:${siteInfo.phone}`}><bdi dir="ltr">{siteInfo.phone}</bdi></a>}
            </div>
          </div>
          <div class="footer-contact-strip">
            <span>{dictionary.footer.contactStrip}</span>
            {hasEmail && <a href={`mailto:${siteInfo.email}`}><bdi dir="ltr">{siteInfo.email}</bdi></a>}
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>Copyright {new Date().getFullYear()} {siteInfo.name}. {dictionary.footer.copyright}</span>
        <span>{dictionary.footer.clearPools}</span>
      </div>
    </footer>
    <script is:inline>
      const mobileMenuQuery = window.matchMedia('(max-width: 780px)');
      const navLinks = document.querySelector('[data-nav-links]');
      const menuToggle = document.querySelector('[data-menu-toggle]');
      const productsNav = document.querySelector('[data-products-nav]');
      const productsTrigger = document.querySelector('[data-products-trigger]');
      const languageSwitchers = [...document.querySelectorAll('[data-language-switcher]')];

      const setMobileScrollLock = locked => {
        if (!mobileMenuQuery.matches) locked = false;
        if (locked && !document.body.classList.contains('mobile-nav-open')) {
          const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
          document.body.dataset.mobileNavScrollY = String(scrollY);
          document.body.style.setProperty('--mobile-nav-scroll-y', `-${scrollY}px`);
          document.body.classList.add('mobile-nav-open');
          return;
        }
        if (!locked && document.body.classList.contains('mobile-nav-open')) {
          const scrollY = Number(document.body.dataset.mobileNavScrollY || 0);
          document.body.classList.remove('mobile-nav-open');
          document.body.style.removeProperty('--mobile-nav-scroll-y');
          delete document.body.dataset.mobileNavScrollY;
          window.scrollTo(0, scrollY);
        }
      };

      const closeProductsMenu = () => {
        productsNav?.classList.remove('is-open');
        productsTrigger?.setAttribute('aria-expanded', 'false');
      };

      const closeLanguageMenus = (except = null) => {
        languageSwitchers.forEach(switcher => {
          if (switcher === except) return;
          switcher.classList.remove('is-open');
          switcher.querySelector('[data-language-trigger]')?.setAttribute('aria-expanded', 'false');
        });
      };

      languageSwitchers.forEach(switcher => {
        const trigger = switcher.querySelector('[data-language-trigger]');
        const menu = switcher.querySelector('.language-menu');
        menu?.addEventListener('click', event => event.stopPropagation());
        trigger?.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          const willOpen = !switcher.classList.contains('is-open');
          closeLanguageMenus(switcher);
          switcher.classList.toggle('is-open', willOpen);
          trigger.setAttribute('aria-expanded', String(willOpen));
        });
      });

      menuToggle?.addEventListener('click', () => {
        const willOpen = !navLinks?.classList.contains('open');
        navLinks?.classList.toggle('open', willOpen);
        menuToggle.setAttribute('aria-expanded', String(willOpen));
        setMobileScrollLock(willOpen);
        if (!willOpen) {
          closeProductsMenu();
          closeLanguageMenus();
        }
      });

      productsTrigger?.addEventListener('click', event => {
        if (!productsNav?.querySelector('.mega-menu')) return;
        event.preventDefault();
        const willOpen = !productsNav?.classList.contains('is-open');
        productsNav?.classList.toggle('is-open', willOpen);
        productsTrigger.setAttribute('aria-expanded', String(willOpen));
      });

      document.addEventListener('click', event => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (!productsNav?.contains(target)) closeProductsMenu();
        if (!languageSwitchers.some(switcher => switcher.contains(target))) closeLanguageMenus();
      });

      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        closeProductsMenu();
        closeLanguageMenus();
        if (mobileMenuQuery.matches) {
          navLinks?.classList.remove('open');
          menuToggle?.setAttribute('aria-expanded', 'false');
          setMobileScrollLock(false);
        }
      });

      mobileMenuQuery.addEventListener('change', event => {
        if (event.matches) return;
        navLinks?.classList.remove('open');
        menuToggle?.setAttribute('aria-expanded', 'false');
        setMobileScrollLock(false);
        closeProductsMenu();
        closeLanguageMenus();
      });
    </script>
    <script is:inline>
      const initMarqueeDrag = ({ shell, track, duration = 42, direction = 'rtl' }) => {
        const directionSign = direction === 'ltr' ? 1 : -1;
        let visualX = 0;
        let startX = 0;
        let startVisualX = 0;
        let pointerActive = false;
        let hasDragged = false;
        let suppressClick = false;
        let activePointerId = null;
        let lastFrameTime = 0;
        let lastPointerX = 0;
        let lastPointerTime = 0;
        let velocity = 0;
        let rafId = 0;
        const dragThreshold = 8;
        const friction = 0.94;
        const mobileCarouselQuery = window.matchMedia('(max-width: 780px)');

        const getLoopDistance = () => Math.max(1, track.scrollWidth / 2);
        const wrapVisualX = value => {
          const loopDistance = getLoopDistance();
          let wrapped = value % loopDistance;
          if (wrapped > 0) wrapped -= loopDistance;
          if (wrapped <= -loopDistance) wrapped += loopDistance;
          return wrapped;
        };
        const setVisualX = value => {
          visualX = wrapVisualX(value);
          track.style.transform = `translate3d(${visualX.toFixed(3)}px, 0, 0)`;
        };
        const tick = timestamp => {
          if (!lastFrameTime) lastFrameTime = timestamp;
          const elapsed = Math.min(64, timestamp - lastFrameTime);
          lastFrameTime = timestamp;
          if (!pointerActive && !document.hidden) {
            const speedMultiplier = mobileCarouselQuery.matches ? 2 : 1;
            const speed = getLoopDistance() * speedMultiplier / (duration * 1000);
            if (Math.abs(velocity) > 0.02) {
              setVisualX(visualX + velocity * elapsed);
              velocity *= Math.pow(friction, elapsed / 16.67);
            } else {
              velocity = 0;
              setVisualX(visualX + directionSign * speed * elapsed);
            }
          }
          rafId = window.requestAnimationFrame(tick);
        };

        track.style.animation = 'none';
        setVisualX(0);
        rafId = window.requestAnimationFrame(tick);

        shell.addEventListener('pointerdown', event => {
          if (!event.isPrimary) return;
          pointerActive = true;
          lastFrameTime = 0;
          hasDragged = false;
          activePointerId = event.pointerId;
          startX = event.clientX;
          lastPointerX = event.clientX;
          lastPointerTime = event.timeStamp || performance.now();
          velocity = 0;
          startVisualX = visualX;
        });

        shell.addEventListener('pointermove', event => {
          if (!pointerActive || !event.isPrimary || event.pointerId !== activePointerId) return;
          const delta = event.clientX - startX;
          if (!hasDragged && Math.abs(delta) < dragThreshold) return;
          event.preventDefault();
          if (!hasDragged) {
            hasDragged = true;
            suppressClick = true;
            shell.classList.add('is-dragging');
            shell.setPointerCapture?.(event.pointerId);
          }
          const now = event.timeStamp || performance.now();
          const elapsed = Math.max(16, now - lastPointerTime);
          velocity = (event.clientX - lastPointerX) / elapsed;
          lastPointerX = event.clientX;
          lastPointerTime = now;
          setVisualX(startVisualX + delta);
        });

        const endDrag = event => {
          if (!pointerActive || event.pointerId !== activePointerId) return;
          pointerActive = false;
          lastFrameTime = 0;
          activePointerId = null;
          if (!hasDragged) velocity = 0;
          shell.classList.remove('is-dragging');
          if (shell.hasPointerCapture?.(event.pointerId)) shell.releasePointerCapture?.(event.pointerId);
          if (hasDragged) window.setTimeout(() => { suppressClick = false; }, 220);
        };

        shell.addEventListener('pointerup', endDrag);
        shell.addEventListener('pointercancel', endDrag);
        shell.addEventListener('click', event => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
        }, true);
        window.addEventListener('resize', () => setVisualX(visualX));
        window.addEventListener('pagehide', () => window.cancelAnimationFrame(rafId), { once: true });
      };

      document.querySelectorAll('[data-brand-rail-shell], [data-marquee-shell]').forEach(shell => {
        const track = shell.querySelector('[data-brand-rail], [data-marquee-track]');
        if (!track) return;
        initMarqueeDrag({
          shell,
          track,
          duration: Number(shell.dataset.marqueeDuration || 42),
          direction: shell.dataset.marqueeDirection || 'rtl',
        });
      });
    </script>
  </body>
</html>
