---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import MediaCarousel from '../components/MediaCarousel.astro';
import { factoryGallery, pageImages, siteInfo } from '../data/site';
import { publicSiteCopy } from '../data/industry-profile';
import { breadcrumbStructuredData, organizationStructuredData, siteUrl } from '../data/seo';
import { getPageCopy } from '../data/i18n';

const pages = getPageCopy('en');
const aboutDescription = publicSiteCopy.positioning;
const aboutStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${siteInfo.name}`,
    description: aboutDescription,
    url: new URL('/about/', siteUrl(Astro.site)).toString(),
  },
  breadcrumbStructuredData(
    [
      { name: 'Home', url: '/' },
      { name: 'About', url: '/about/' },
    ],
    Astro.site
  ),
];
---
<BaseLayout title={`About ${siteInfo.name}`} description={aboutDescription} image={pageImages.about} structuredData={aboutStructuredData}>
  <main>
    <PageBanner
      eyebrow={pages.about.bannerEyebrow}
      title={pages.about.bannerTitle}
      description={pages.about.bannerDescription}
      image={pageImages.about}
      variant="category-aligned"
      share
    />
    <section class="section container interior-section about-system-section">
      <div class="section-heading">
        <span class="eyebrow">{pages.about.systemEyebrow}</span>
        <h2>{pages.about.systemTitle}</h2>
        <p class="prose">{pages.about.systemDescription}</p>
      </div>
      <div class="proof-grid">
        <div class="surface-panel proof-panel">
          <h2>{pages.about.whatWeBuild}</h2>
          <p class="prose">{pages.about.whatWeBuildDescription}</p>
        </div>
        <div class="proof-list">
          {[
            ['Artwork support', 'Start with a logo, sketch, photograph, or reference object and define how the finished piece will be used.'],
            ['Tooling and forming', 'Molding, tooling, stamping, and die casting turn the approved artwork into the metal form.'],
            ['Surface work', 'Polishing, enameling, printing, and plating establish the color, contrast, texture, and final character.'],
            ['Assembly and packing', 'Fittings, ribbons, leather, and packaging complete the product, with checks from raw material through final packing.'],
          ].map(item => (
            <div class="proof-card about-proof-card" tabindex="0">
              <strong>{item[0]}</strong>
              <p class="prose">{item[1]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <MediaCarousel items={factoryGallery} eyebrow={pages.about.factoryEyebrow} title={pages.about.factoryTitle} id="about-factory" />
  </main>
</BaseLayout>
