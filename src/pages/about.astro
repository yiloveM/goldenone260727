---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { factoryGallery, pageImages, siteInfo } from '../data/site';
import { industryProfile, publicSiteCopy } from '../data/industry-profile';
import { breadcrumbStructuredData, organizationStructuredData } from '../data/seo';

const aboutDescription = publicSiteCopy.positioning;
const aboutStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${siteInfo.name}`,
    description: aboutDescription,
    url: new URL('/about/', Astro.site || 'https://businessweb.workers.dev').toString(),
  },
  breadcrumbStructuredData(
    [
      { name: 'Home', url: '/' },
      { name: 'About', url: '/about/' },
    ],
    Astro.site
  ),
];
---
<BaseLayout title={`About ${siteInfo.name}`} description={aboutDescription} image={pageImages.about} structuredData={aboutStructuredData}>
  <main>
    <PageBanner
      eyebrow="About"
      title={`A specialist ${industryProfile.market.industry} partner for international buyers.`}
      description={aboutDescription}
      image={pageImages.about}
      variant="interior"
      share
    />
    <section class="section container interior-section about-system-section">
      <div class="section-heading">
        <span class="eyebrow">Approach</span>
        <h2>Focused commercial support from evaluation through delivery.</h2>
        <p class="prose">Share the evidence, application requirements, and commercial priorities that matter to your project. The team can then provide a relevant response.</p>
      </div>
      <div class="proof-grid">
        <div class="glass-panel proof-panel">
          <h2>What buyers can expect</h2>
          <p class="prose">Clear offering information, practical commercial communication, and a direct route to the people who can evaluate a specific requirement.</p>
        </div>
        <div class="proof-list">
          {[
            ['Context', 'Information shaped around actual applications, evaluation criteria, and project fit.'],
            ['Clarity', 'Direct commercial conversations with the details needed for a useful response.'],
            ['Continuity', 'Support for selection, implementation, and long-term operating needs.'],
            ['Reach', 'A perspective designed for international B2B buyers and project teams.'],
          ].map(item => (
            <div class="proof-card about-proof-card" tabindex="0">
              <strong>{item[0]}</strong>
              <p class="prose">{item[1]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section container factory-section">
      <div class="section-heading">
        <span class="eyebrow">Capability</span>
        <h2>See the work and outcomes in context.</h2>
      </div>
      <div class="factory-carousel-shell" data-marquee-shell data-marquee-direction="ltr" data-marquee-duration="48">
        <div class="brand-rail-hint" aria-hidden="true">Drag / swipe to browse</div>
        <div class="factory-carousel" aria-label={`${industryProfile.market.industry} visual gallery`} data-marquee-track>
          {[...factoryGallery, ...factoryGallery].map(item => (
            <figure><img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="800" /><figcaption>{item.title}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
