---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PageBanner from '../components/PageBanner.astro';
import { brandAssets } from '../data/assets';
import { pageImages, siteInfo } from '../data/site';
import { industryProfile } from '../data/industry-profile';
import { breadcrumbStructuredData, organizationStructuredData } from '../data/seo';

const mapAddress = siteInfo.address;
const hasMapAddress = Boolean(mapAddress && !/^replace with/i.test(mapAddress));
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapAddress)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapAddress)}`;
const contactDescription = `Contact ${siteInfo.name} about ${industryProfile.market.industry} requirements, projects, and commercial support.`;
const contactStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${siteInfo.name}`,
    description: contactDescription,
    url: new URL('/contact/', Astro.site || 'https://businessweb.workers.dev').toString(),
  },
  breadcrumbStructuredData(
    [
      { name: 'Home', url: '/' },
      { name: 'Contact', url: '/contact/' },
    ],
    Astro.site
  ),
];
---
<BaseLayout title="Contact" description={contactDescription} image={pageImages.contact} structuredData={contactStructuredData}>
  <main>
    <PageBanner
      eyebrow="Contact"
      title="Talk to the team about your requirements."
      description="Send the company, market, offering, quantity, timeline, or service details needed for a useful response."
      image={pageImages.contact}
      ctaHref="#contact-form"
      ctaLabel="Start inquiry"
      variant="interior"
      share
    />
    <section class="section container interior-section contact-page-section" id="contact-form">
      <div class="section-heading">
        <span class="eyebrow">Inquiry form</span>
        <h2>Share the request.</h2>
        <p class="prose">Include the application, target market, quantity, timeline, and technical or commercial requirements needed for a useful response.</p>
      </div>
      <div class="card-grid contact-grid">
        <InquiryForm
          labels={{
            name: 'Your name',
            email: 'Email',
            company: 'Company / project',
            country: 'Country / Region',
            message: 'Requirements, product or service scope, quantity, timeline, and target market',
            sendInquiry: 'Send inquiry',
          }}
        />
        <aside class="glass-panel contact-card contact-direct-card">
          <h2>Direct contact</h2>
          <p class="prose" style="margin-top:14px;">
            Email: <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a><br />
            Phone: <a href={`tel:${siteInfo.phone}`}>{siteInfo.phone}</a><br />
            Sales office: {siteInfo.address}<br />
            Operating address: {siteInfo.factoryAddress}
          </p>
          <a class="btn primary" href={siteInfo.whatsapp} target="_blank" rel="noopener" style="margin-top:20px;">Contact by WhatsApp</a>
        </aside>
      </div>
    </section>
    {hasMapAddress && <section class="section container contact-map-section">
      <div class="section-heading">
        <span class="eyebrow">Location</span>
        <h2>Business location</h2>
        <p class="prose">{mapAddress}</p>
      </div>
      <div class="glass-panel map-panel map-water-panel">
        <iframe title="Business location on Google Maps" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <div class="map-logo-pin" aria-hidden="true">
          <img src={brandAssets.logo} alt="" loading="lazy" decoding="async" width="154" height="60" />
        </div>
        <div class="map-location-card">
          <span class="eyebrow">Business office</span>
          <strong>{mapAddress}</strong>
          <p>{siteInfo.factoryAddress}</p>
          <a href={mapLink} target="_blank" rel="noopener">Open interactive map</a>
        </div>
      </div>
    </section>}
  </main>
</BaseLayout>
