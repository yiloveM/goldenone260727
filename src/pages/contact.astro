---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PageBanner from '../components/PageBanner.astro';
import { pageImages, siteInfo } from '../data/site';
import { breadcrumbStructuredData, organizationStructuredData, siteUrl } from '../data/seo';
import { getPageCopy } from '../data/i18n';

const pages = getPageCopy('en');
const mapAddress = siteInfo.address;
const hasMapAddress = Boolean(mapAddress && !/^replace with/i.test(mapAddress));
const hasDirectContact = Boolean(siteInfo.email || siteInfo.phone || siteInfo.address || siteInfo.factoryAddress || siteInfo.whatsapp);
const hasDistinctFactoryAddress = Boolean(
  siteInfo.factoryAddress
  && siteInfo.factoryAddress.trim().toLowerCase() !== siteInfo.address.trim().toLowerCase()
);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapAddress)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapAddress)}`;
const contactDescription = pages.contact.description;
const contactStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${siteInfo.name}`,
    description: contactDescription,
    url: new URL('/contact/', siteUrl(Astro.site)).toString(),
  },
  breadcrumbStructuredData(
    [
      { name: 'Home', url: '/' },
      { name: 'Contact', url: '/contact/' },
    ],
    Astro.site
  ),
];
---
<BaseLayout title="Contact" description={contactDescription} image={pageImages.contact} structuredData={contactStructuredData}>
  <main>
    <PageBanner
      eyebrow={pages.contact.bannerEyebrow}
      title={pages.contact.bannerTitle}
      description={pages.contact.bannerDescription}
      image={pageImages.contact}
      ctaHref="#contact-form"
      ctaLabel={pages.contact.startInquiry}
      variant="interior"
    />
    <section class="section container interior-section contact-page-section" id="contact-form">
      <div class="section-heading">
        <span class="eyebrow">{pages.contact.formEyebrow}</span>
        <h2>{pages.contact.formTitle}</h2>
        <p class="prose">{pages.contact.formDescription}</p>
      </div>
      <div class="card-grid contact-grid" style={hasDirectContact ? undefined : 'grid-template-columns:1fr;'}>
        <InquiryForm
          locale="en"
          labels={{
            name: pages.contact.name,
            email: pages.contact.email,
            company: pages.contact.company,
            country: pages.contact.country,
            message: pages.contact.message,
            sendInquiry: pages.contact.sendInquiry,
          }}
        />
        {hasDirectContact && <aside class="glass-panel contact-card contact-direct-card">
          <h2>{pages.contact.direct}</h2>
          <p class="prose" style="margin-top:14px;">
            {siteInfo.email && <>Email: <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a><br /></>}
            {siteInfo.phone && <>Phone: <a href={`tel:${siteInfo.phone}`}>{siteInfo.phone}</a><br /></>}
            {siteInfo.address && <>{pages.contact.salesOffice}: {siteInfo.address}<br /></>}
            {hasDistinctFactoryAddress && <>{pages.contact.factoryAddress}: {siteInfo.factoryAddress}</>}
          </p>
          {siteInfo.whatsapp && <a class="btn primary" href={siteInfo.whatsapp} target="_blank" rel="noopener" style="margin-top:20px;">{pages.contact.whatsapp}</a>}
        </aside>}
      </div>
    </section>
    {hasMapAddress && <section class="section container contact-map-section">
      <div class="section-heading">
        <span class="eyebrow">Location</span>
        <h2>Business location</h2>
        <p class="prose">{mapAddress}</p>
      </div>
      <div class="glass-panel map-panel">
        <iframe title="Business location on Google Maps" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <div class="contact-map-bar">
          <div><span>Business office</span><strong>{mapAddress}</strong></div>
          <a href={mapLink} target="_blank" rel="noopener">Open interactive map</a>
        </div>
      </div>
    </section>}
  </main>
</BaseLayout>
