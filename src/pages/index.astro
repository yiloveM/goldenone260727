---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-tailwind.css';
import { brandAssets } from '../data/assets';
import { siteImages } from '../data/backgroundImages';
import HomeRippleScript from '../components/HomeRippleScript.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { brandShowcase, factoryGallery, homePlaceholderImages, siteInfo } from '../data/site';
import { industryProfile, primaryKeyword, profileKeywords, publicSiteCopy } from '../data/industry-profile';
import { isProductPublished, sortProductsByPriority } from '../data/productCategories';
import { collectionStructuredData, organizationStructuredData, websiteStructuredData } from '../data/seo';

const allProducts = (await getCollection('products')).filter(isProductPublished);
const products = sortProductsByPriority(allProducts.filter(p => p.data.featured)).slice(0, 6);
const posts = (await getCollection('blog')).filter(p => p.data.featured).slice(0, 2);
const heroFloatingProducts = brandAssets.heroFloatingProducts.filter(Boolean).slice(0, 3);
const showcaseSlides = brandShowcase.map(item => ({
  title: item.title,
  label: item.label,
  image: item.image,
  href: '/about/',
}));
const cssImage = (url: string) => `url('${url}')`;
const homeBackgroundStyle = [
  `--brand-section-bg: ${cssImage(siteImages.homeBackgrounds.productWorldsIntro)}`,
  `--product-category-transition-bg-desktop: ${cssImage(siteImages.homeBackgrounds.productCategoryTransitionDesktop)}`,
  `--product-category-transition-bg-mobile: ${cssImage(siteImages.homeBackgrounds.productCategoryTransitionMobile)}`,
  `--feature-band-bg: ${cssImage(siteImages.homeBackgrounds.hotSalesBand)}`,
  `--featured-equipment-bg: ${cssImage(siteImages.homeBackgrounds.featuredEquipment)}`,
  `--factory-capability-bg: ${cssImage(siteImages.homeBackgrounds.factoryCapability)}`,
].join('; ');

const homeStructuredData = [
  organizationStructuredData(Astro.site),
  websiteStructuredData(Astro.site),
  collectionStructuredData(
    {
      name: `${siteInfo.name} | ${industryProfile.market.industry}`,
      description: siteInfo.description,
      url: '/',
      image: brandAssets.heroRippleDesktop,
      keywords: profileKeywords([industryProfile.market.industry]),
      items: [
        { name: 'Catalog', url: '/products/', image: siteImages.pageBanners.productsCatalog },
        { name: 'Insights', url: '/blog/', image: siteImages.pageBanners.engineeringNotes },
        { name: 'Contact', url: '/contact/', image: siteImages.pageBanners.contact },
      ],
    },
    Astro.site
  ),
];
---
<BaseLayout title={siteInfo.name} description={siteInfo.description} image={brandAssets.heroRippleDesktop} preloadHomeHero structuredData={homeStructuredData}>
  <main class="astrowind-home tw:relative tw:isolate tw:overflow-hidden" data-tailwind-homepage style={homeBackgroundStyle}>
    <section class="hero astrowind-hero tw:relative tw:min-h-[46rem] tw:overflow-hidden" id="home-hero">
      <div class="hero-water-surface tw:absolute tw:inset-0" id="home-ripples" aria-hidden="true" style={`--hero-bg-desktop: url('${brandAssets.heroRippleDesktop}'); --hero-bg-mobile: url('${brandAssets.heroRippleMobile}');`}></div>
      <div class="container hero-inner tw:relative tw:z-10 tw:mx-auto tw:grid tw:min-h-[46rem] tw:items-center tw:gap-10 tw:px-5 tw:py-20 lg:tw:grid-cols-[minmax(0,0.88fr)_minmax(25rem,1.12fr)] lg:tw:px-8">
        <div class="hero-copy tw:relative tw:z-10 tw:max-w-2xl">
          <span class="eyebrow tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-white/30 tw:bg-white/10 tw:px-3 tw:py-1 tw:text-xs tw:font-semibold tw:uppercase tw:tracking-[0.14em]">{publicSiteCopy.heroEyebrow}</span>
          <h1 class="tw:mt-6 tw:max-w-3xl tw:text-4xl tw:font-semibold tw:leading-tight sm:tw:text-5xl lg:tw:text-6xl">{publicSiteCopy.heroTitle}</h1>
          <p class="tw:mt-6 tw:max-w-xl tw:text-base tw:leading-8 sm:tw:text-lg">{publicSiteCopy.heroDescription}</p>
          <div class="hero-actions tw:mt-8 tw:flex tw:flex-wrap tw:gap-3">
            <a class="btn primary tw:inline-flex tw:min-h-12 tw:items-center tw:justify-center" href="/products">Explore Catalog</a>
            <a class="btn secondary tw:inline-flex tw:min-h-12 tw:items-center tw:justify-center" href="/contact">Start Inquiry</a>
          </div>
          <div class="metric-row tw:mt-10 tw:grid tw:gap-3 sm:tw:grid-cols-3">
            <div class="metric" tabindex="0" role="group" aria-label="Buyer focus">
              <strong>01</strong><span>Buyer-facing clarity for early evaluation and specification.</span>
            </div>
            <div class="metric" tabindex="0" role="group" aria-label="Commercial confidence">
              <strong>02</strong><span>Commercial detail built around applications, evidence, and project fit.</span>
            </div>
            <div class="metric" tabindex="0" role="group" aria-label="International focus">
              <strong>03</strong><span>International discovery and multilingual buyer journeys.</span>
            </div>
          </div>
        </div>
        <div class="hero-visual tw:relative tw:mx-auto tw:w-full tw:max-w-2xl" aria-label={`${industryProfile.market.industry} visual preview`}>
          <div class={`hero-product-stage hero-product-count-${heroFloatingProducts.length}`}>
            {heroFloatingProducts.map((image, index) => (
              <figure class={`hero-product hero-product-${index + 1}`} tabindex="0" role="button" aria-label={`Focus ${industryProfile.market.industry} visual ${index + 1}`}>
                <img
                  src={image}
                  alt={`${industryProfile.market.industry} visual ${index + 1}`}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="900"
                  height="760"
                />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section container brand-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="section-heading tw:max-w-3xl">
        <span class="eyebrow">Built for evaluation</span>
        <h2>Make the first commercial conversation feel informed and considered.</h2>
        <p class="prose">{publicSiteCopy.positioning}</p>
      </div>
      <div class="brand-rail-shell" data-brand-rail-shell>
        <div class="brand-rail-hint" aria-hidden="true">Drag / swipe to browse</div>
        <div class="brand-rail" aria-label={`${industryProfile.market.industry} capability carousel`} data-brand-rail>
          {[...showcaseSlides, ...showcaseSlides].map(item => (
            <article class="brand-slide">
              <a class="brand-slide-image-link" href={item.href} aria-label={`Explore ${item.title}`}>
                <img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="760" draggable="false" />
              </a>
              <div><span>{item.label}</span><h3>{item.title}</h3></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="home-product-category-transition" aria-hidden="true"></div>

    <section class="section feature-band deferred-section tw:py-20 lg:tw:py-28">
      <div class="container feature-band-inner tw:mx-auto tw:grid tw:max-w-7xl tw:gap-10 tw:px-5 sm:tw:px-8 lg:tw:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div>
          <span class="eyebrow">Commercial confidence</span>
          <h2>From initial brief to long-term buyer support.</h2>
          <p>Present the proof, application context, and product detail that a serious international buyer needs before a conversation begins.</p>
        </div>
        <div class="mini-specs hot-sales-grid tw:grid tw:gap-3 sm:tw:grid-cols-2">
          {[
            ['Detail', 'Technical evidence'],
            ['Fit', 'Application context'],
            ['Reach', 'International markets'],
            ['Support', 'Commercial response'],
          ].map(item => (
            <a class="hot-sale-card" href="/about/">
              <div><strong>{item[0]}</strong><span>{item[1]}</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-ambient-section featured-equipment-section deferred-section tw:py-20 lg:tw:py-28" style="--home-section-bg: var(--featured-equipment-bg);">
      <div class="container home-ambient-inner tw:mx-auto tw:max-w-7xl tw:px-5 sm:tw:px-8">
        <div class="section-heading tw:max-w-3xl">
          <span class="eyebrow">Featured offerings</span>
          <h2>{products.length ? `${primaryKeyword} in focus` : `${primaryKeyword} starts with verified information`}</h2>
          <p class="prose">{products.length ? 'Explore the selected range, then contact the team with project and market requirements.' : 'Add verified products, services, or solution pages before inviting buyers to evaluate the range.'}</p>
        </div>
        {products.length ? (
          <div class="card-grid series-card-grid product-showcase tw:mt-10">{products.map(product => <SeriesCard product={product} />)}</div>
        ) : (
          <div class="card-grid tw:mt-10">
            {brandShowcase.map(item => (
              <article class="card">
                <img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="760" />
                <div class="card-body"><span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>Use verified product, project, process, or service imagery that helps buyers understand the offer.</p></div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section container partners-section deferred-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="proof-grid tw:grid tw:gap-6 lg:tw:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)]">
        <div class="glass-panel proof-panel partnership-panel">
          <div class="partnership-copy">
            <span class="eyebrow">Partnership perspective</span>
            <h2>Clear information. Practical dialogue. Durable outcomes.</h2>
            <p class="prose">{publicSiteCopy.positioning}</p>
          </div>
          <figure class="partnership-visual">
            <img src={homePlaceholderImages.partnership} alt={`${industryProfile.market.industry} collaboration`} loading="lazy" decoding="async" width="1600" height="980" />
            <figcaption>International commercial partnership</figcaption>
          </figure>
        </div>
        <div class="proof-list tw:grid tw:gap-3 sm:tw:grid-cols-2 lg:tw:grid-cols-1">
          <article class="proof-card" tabindex="0" aria-label="SEO">
            <strong>Evidence</strong><p class="prose">Buyer-facing detail that supports selection, comparison, and procurement conversations.</p>
            <span class="proof-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4.5h14v15H5z" /><path d="M8 8h8M8 12h8M8 16h5" /></svg></span>
          </article>
          <article class="proof-card" tabindex="0" aria-label="Translation">
            <strong>Context</strong><p class="prose">Applications, compatibility, and decision criteria explained in a direct, credible voice.</p>
            <span class="proof-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4.5 5h15M8 5c1.3 5.4 4.7 9.6 9 12M15 5c-1 4.2-3.6 7.7-7.3 10" /><path d="M5 19h7" /></svg></span>
          </article>
          <article class="proof-card" tabindex="0" aria-label="Media">
            <strong>Reach</strong><p class="prose">A clear path for global buyers to discover, assess, and discuss the offer.</p>
            <span class="proof-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5Z" /><path d="M4.4 8.8 12 13l7.6-4.2M12 13v7" /></svg></span>
          </article>
          <article class="proof-card" tabindex="0" aria-label="Deployment">
            <strong>Response</strong><p class="prose">A commercial inquiry flow designed for detailed requirements and real next steps.</p>
            <span class="proof-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v12" /><path d="m7 8 5-5 5 5" /><path d="M5 15v4h14v-4" /></svg></span>
          </article>
        </div>
      </div>
    </section>

    <section class="section home-ambient-section factory-section deferred-section tw:py-20 lg:tw:py-28" style="--home-section-bg: var(--factory-capability-bg);">
      <div class="container home-ambient-inner tw:mx-auto tw:max-w-7xl tw:px-5 sm:tw:px-8">
        <div class="section-heading tw:max-w-3xl">
          <span class="eyebrow">Capability in view</span>
          <h2>Show the work, the product, and the outcome buyers are evaluating.</h2>
          <p class="prose">{industryProfile.visual.imageRules}</p>
        </div>
        <div class="factory-carousel-shell" data-marquee-shell data-marquee-direction="ltr" data-marquee-duration="48">
          <div class="brand-rail-hint" aria-hidden="true">Drag / swipe to browse</div>
          <div class="factory-carousel" aria-label={`${industryProfile.market.industry} image carousel`} data-marquee-track>
            {[...factoryGallery, ...factoryGallery].map(item => (
              <figure><img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="800" draggable="false" /><figcaption>{item.title}</figcaption></figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section container insights-section deferred-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="section-heading tw:max-w-3xl">
          <span class="eyebrow">Insights</span>
          <h2>{posts.length ? 'Published insights' : `Useful ${industryProfile.market.industry} guidance is coming`}</h2>
      </div>
      <div class="card-grid tw:mt-10">
        {posts.length ? posts.map(post => (
          <article class="card">
            <a href={`/blog/${post.id.replace(/\.mdoc$/, '')}/`}>
              <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" width="1200" height="760" />
              <div class="card-body"><span class="eyebrow">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
            </a>
          </article>
        )) : (
          <article class="card">
            <img src={siteImages.pageBanners.engineeringNotes} alt={`${industryProfile.market.industry} insights`} loading="lazy" decoding="async" width="1200" height="760" />
            <div class="card-body"><span class="eyebrow">Insights</span><h3>Practical guidance for serious buyers</h3><p>{publicSiteCopy.insightDescription}</p></div>
          </article>
        )}
      </div>
    </section>
  </main>
  <HomeRippleScript />
</BaseLayout>
