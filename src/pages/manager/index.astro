        state.activeBlogSlug = slug;
        state.activeBlogDraftId = '';
        state.isNewBlog = false;
        $('blogTitle').value = post.title || '';
        $('blogSlug').value = post.slug || '';
        $('blogSlug').readOnly = true;
        $('blogCategory').value = post.category || '';
        $('blogPublishDate').value = toDateTimeLocal(post.publishDate);
        $('blogAuthor').value = post.author || 'BusinessWeb Editorial Team';
        $('blogFeatured').checked = post.featured === true;
        $('blogImage').value = post.image || '';
        updateImageFieldPreview('blogImage');
        $('blogDescription').value = post.description || '';
        setRichTextValue('blogBody', post.body || '');
        $('viewBlogButton').href = `/blog/${post.slug}/`;
        renderBlogPosts();
        renderBlogWorkDrafts();
        showBlogEditor();
        setStatus('blogStatus', `正在编辑：${post.title}`);
      };

      const startNewBlog = () => {
        state.activeBlogSlug = '';
        state.activeBlogDraftId = '';
        state.isNewBlog = true;
        $('blogTitle').value = '';
        $('blogSlug').value = '';
        $('blogSlug').readOnly = false;
        $('blogCategory').value = '';
        $('blogPublishDate').value = toDateTimeLocal(new Date().toISOString());
        $('blogAuthor').value = 'BusinessWeb Editorial Team';
        $('blogFeatured').checked = false;
        $('blogImage').value = '';
        updateImageFieldPreview('blogImage');
        $('blogDescription').value = '';
        setRichTextValue('blogBody', '');
        $('viewBlogButton').href = '#';
        renderBlogPosts();
        renderBlogWorkDrafts();
        showBlogEditor();
        setStatus('blogStatus', '正在新建文章草稿。Slug 保存后将用于生成文章页面。');
      };

      const getBlogPayload = () => ({
        blogSlug: $('blogSlug').value.trim().toLowerCase(),
        title: $('blogTitle').value.trim(),
        description: $('blogDescription').value.trim(),
        category: $('blogCategory').value.trim(),
        image: $('blogImage').value.trim(),
        author: $('blogAuthor').value.trim() || 'BusinessWeb Editorial Team',
        publishDate: fromDateTimeLocal($('blogPublishDate').value),
        featured: $('blogFeatured').checked,
        body: getRichTextValue('blogBody').trim(),
      });

      const saveBlogDraft = async () => {
        const payload = getBlogPayload();
        if (!payload.blogSlug) {
          setStatus('blogStatus', '请先填写文章 slug。', true);
          return;
        }
        if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(payload.blogSlug)) {
          setStatus('blogStatus', 'Slug 只能使用小写英文、数字和短横线。', true);
          return;
        }
        setStatus('blogStatus', '正在保存文章草稿...');
        const data = await requestJson('/api/manager/blog-drafts', {
          method: 'POST',
          body: JSON.stringify({ id: state.activeBlogDraftId, payload }),
        });
        state.activeBlogDraftId = data.draft?.id || '';
        state.activeBlogSlug = payload.blogSlug;
        await loadBlogDrafts();
        setStatus('blogStatus', '文章草稿已保存。');
      };

      const renderBlogWorkDrafts = () => {
        const drafts = state.activeBlogSlug
          ? state.blogDrafts.filter(draft => draft.blogSlug === state.activeBlogSlug)
          : state.blogDrafts.slice(0, 10);
        $('blogDraftWorkList').innerHTML = drafts.length
          ? drafts
              .map(
                draft => `
                  <div class="draft">
                    <span>
                      <strong>${escapeHtml(draft.blogTitle)}</strong>
                      <small>${escapeHtml(draft.status)} · ${formatDate(draft.updatedAt)}</small>
                    </span>
                    <button class="button secondary" data-blog-apply="${escapeHtml(draft.id)}" type="button">应用到网站内容</button>
                  </div>
                `
              )
              .join('')
          : '<div class="draft"><span><strong>暂无文章草稿</strong><small>保存文章草稿后会显示在这里。</small></span></div>';
      };

      const applyBlogDraft = async draftId => {
        setStatus('blogStatus', '正在提交内容更新...');
        const data = await requestJson(`/api/manager/blog-drafts/${encodeURIComponent(draftId)}/apply`, { method: 'POST' });
        await loadBlogDrafts();
        setStatus('blogStatus', data.requestId ? '内容更新已提交，请稍后刷新查看。' : '内容更新已提交。');
      };

      const getPayload = () => ({
        productSlug: $('productSlug').value.trim().toLowerCase(),
        title: $('title').value.trim(),
        description: $('description').value.trim(),
        content: getRichTextValue('productContent').trim(),
        offeringType: $('offeringType').value,
        modelStrategy: $('modelStrategy').value,
        category: $('category').value,
        series: $('series').value.trim(),
        sortOrder: Number($('sortOrder').value || 9999),
        published: $('published').checked,
        image: $('image').value.trim(),
        featured: $('featured').checked,
        galleryImages: state.formData.galleryImages,
        detailImages: state.formData.detailImages,
        applications: state.formData.applications,
        specs: state.formData.specs,
        specTables: state.formData.specTables,
        highlights: state.formData.highlights,
        faqs: state.formData.faqs,
      });

      const syncProductFormInput = target => {
        if (target.id === 'image') {
          updateImageFieldPreview('image');
          return;
        }
        if (target.dataset.list) {
          state.formData[target.dataset.list][Number(target.dataset.index)] = target.value;
          if (target.dataset.list === 'galleryImages') {
            const preview = target.closest('.form-row')?.querySelector('[data-inline-image-preview]');
            if (preview) {
              const value = target.value.trim();
              preview.innerHTML = thumbnailMarkup(value, '产品主图');
              preview.dataset.inlineImagePreview = value;
              preview.title = value || '当前没有图片';
              preview.disabled = !value;
            }
          }
          return;
        }
        if (target.dataset.specIndex !== undefined) {
          const item = state.formData.specs[Number(target.dataset.specIndex)];
          if (item) item[target.dataset.field] = target.value;
          return;
        }
        if (target.dataset.detailIndex !== undefined) {
          const item = state.formData.detailImages[Number(target.dataset.detailIndex)];
          if (item) item[target.dataset.field] = target.value;
          return;
        }
        if (target.dataset.faqIndex !== undefined) {
          const item = state.formData.faqs[Number(target.dataset.faqIndex)];
          if (item) item[target.dataset.field] = target.value;
          return;
        }
        if (target.dataset.table !== undefined) {
          const table = state.formData.specTables[Number(target.dataset.table)];
          if (!table) return;
          if (target.dataset.field === 'title') {
            table.title = target.value;
            return;
          }
          if (target.dataset.column !== undefined) {
            table.columns[Number(target.dataset.column)] = target.value;
            return;
          }
          if (target.dataset.row !== undefined && target.dataset.cell !== undefined) {
            const row = table.rows[Number(target.dataset.row)];
            if (row) row[Number(target.dataset.cell)] = target.value;
            return;
          }
          if (target.dataset.headerRow !== undefined && target.dataset.headerCell !== undefined) {
            const cell = table.headerRows?.[Number(target.dataset.headerRow)]?.cells?.[Number(target.dataset.headerCell)];
            if (!cell) return;
            if (target.dataset.field === 'text') cell.text = target.value;
            if (target.dataset.field === 'colspan') cell.colspan = Math.max(1, Number(target.value || 1));
            if (target.dataset.field === 'rowspan') cell.rowspan = Math.max(1, Number(target.value || 1));
          }
        }
      };

      const ensureRowWidth = (table, width) => {
        table.rows = (table.rows || []).map(row => {
          const next = [...row];
          while (next.length < width) next.push('');
          return next.slice(0, width);
        });
      };

      const handleProductAction = actionButton => {
        const action = actionButton.dataset.action;
        const index = Number(actionButton.dataset.index);
        if (!action) return;

        if (action === 'gallery:add') state.formData.galleryImages.push('');
        if (action === 'galleryImages:remove') state.formData.galleryImages.splice(index, 1);
        if (action === 'detail:add') state.formData.detailImages.push({ image: '', title: '', caption: '' });
        if (action === 'detail:remove') state.formData.detailImages.splice(index, 1);
        if (action === 'applications:add') state.formData.applications.push('');
        if (action === 'applications:remove') state.formData.applications.splice(index, 1);
        if (action === 'specs:add') state.formData.specs.push({ label: '', value: '' });
        if (action === 'specs:remove') state.formData.specs.splice(index, 1);
        if (action === 'highlights:add') state.formData.highlights.push('');
        if (action === 'highlights:remove') state.formData.highlights.splice(index, 1);
        if (action === 'faqs:add') state.formData.faqs.push({ question: '', answer: '' });
        if (action === 'faqs:remove') state.formData.faqs.splice(index, 1);
        if (action === 'tables:add') {
          state.formData.specTables.push({
            title: 'Product Specifications',
            columns: ['Model', 'Specification'],
            headerRows: [],
            rows: [['', '']],
          });
        }
        if (action === 'tables:remove') state.formData.specTables.splice(index, 1);

        const tableIndex = Number(actionButton.dataset.table);
        const table = state.formData.specTables[tableIndex];
        if (table) {
          if (action === 'table:column:add') {
            table.columns.push('');
            table.rows.forEach(row => row.push(''));
          }
          if (action === 'table:column:remove') {
            const column = Number(actionButton.dataset.column);
            table.columns.splice(column, 1);
            table.rows.forEach(row => row.splice(column, 1));
            if (!table.columns.length) table.columns.push('Specification');
            ensureRowWidth(table, table.columns.length);
          }
          if (action === 'table:row:add') table.rows.push(table.columns.map(() => ''));
          if (action === 'table:row:remove') {
            table.rows.splice(Number(actionButton.dataset.row), 1);
            if (!table.rows.length) table.rows.push(table.columns.map(() => ''));
          }
          if (action === 'table:header-row:add') table.headerRows.push({ cells: [{ text: '', colspan: 1, rowspan: 1 }] });
          if (action === 'table:header-row:remove') table.headerRows.splice(Number(actionButton.dataset.row), 1);
          if (action === 'table:header-cell:add') {
            const row = table.headerRows[Number(actionButton.dataset.row)];
            row.cells.push({ text: '', colspan: 1, rowspan: 1 });
          }
          if (action === 'table:header-cell:remove') {
            const row = table.headerRows[Number(actionButton.dataset.row)];
            row.cells.splice(Number(actionButton.dataset.cell), 1);
          }
        }

        renderProductBuilders();
      };

      const syncTranslationFormInput = target => {
        if (target.dataset.list) {
          state.translationFormData[target.dataset.list][Number(target.dataset.index)] = target.value;
          return;
        }
        if (target.dataset.specIndex !== undefined) {
          const item = state.translationFormData.specs[Number(target.dataset.specIndex)];
          if (item) item[target.dataset.field] = target.value;
          return;
        }
        if (target.dataset.faqIndex !== undefined) {
          const item = state.translationFormData.faqs[Number(target.dataset.faqIndex)];
          if (item) item[target.dataset.field] = target.value;
          return;
        }
        if (target.dataset.table !== undefined) {
          const table = state.translationFormData.specTables[Number(target.dataset.table)];
          if (!table) return;
          if (target.dataset.field === 'title') {
            table.title = target.value;
            return;
          }
          if (target.dataset.column !== undefined) {
            table.columns[Number(target.dataset.column)] = target.value;
            return;
          }
          if (target.dataset.row !== undefined && target.dataset.cell !== undefined) {
            const row = table.rows[Number(target.dataset.row)];
            if (row) row[Number(target.dataset.cell)] = target.value;
            return;
          }
          if (target.dataset.headerRow !== undefined && target.dataset.headerCell !== undefined) {
            const cell = table.headerRows?.[Number(target.dataset.headerRow)]?.cells?.[Number(target.dataset.headerCell)];
            if (!cell) return;
            if (target.dataset.field === 'text') cell.text = target.value;
            if (target.dataset.field === 'colspan') cell.colspan = Math.max(1, Number(target.value || 1));
            if (target.dataset.field === 'rowspan') cell.rowspan = Math.max(1, Number(target.value || 1));
          }
        }
      };

      const handleTranslationAction = actionButton => {
        const action = actionButton.dataset.action;
        const index = Number(actionButton.dataset.index);
        if (!action) return;

        if (action === 'applications:add') state.translationFormData.applications.push('');
        if (action === 'applications:remove') state.translationFormData.applications.splice(index, 1);
        if (action === 'specs:add') state.translationFormData.specs.push({ label: '', value: '' });
        if (action === 'specs:remove') state.translationFormData.specs.splice(index, 1);
        if (action === 'highlights:add') state.translationFormData.highlights.push('');
        if (action === 'highlights:remove') state.translationFormData.highlights.splice(index, 1);
        if (action === 'faqs:add') state.translationFormData.faqs.push({ question: '', answer: '' });
        if (action === 'faqs:remove') state.translationFormData.faqs.splice(index, 1);
        if (action === 'tables:add') {
          state.translationFormData.specTables.push({
            title: 'Product Specifications',
            columns: ['Model', 'Specification'],
            headerRows: [],
            rows: [['', '']],
          });
        }
        if (action === 'tables:remove') state.translationFormData.specTables.splice(index, 1);

        const tableIndex = Number(actionButton.dataset.table);
        const table = state.translationFormData.specTables[tableIndex];
        if (table) {
          if (action === 'table:column:add') {
            table.columns.push('');
            table.rows.forEach(row => row.push(''));
          }
          if (action === 'table:column:remove') {
            const column = Number(actionButton.dataset.column);
            table.columns.splice(column, 1);
            table.rows.forEach(row => row.splice(column, 1));
            if (!table.columns.length) table.columns.push('Specification');
            ensureRowWidth(table, table.columns.length);
          }
          if (action === 'table:row:add') table.rows.push(table.columns.map(() => ''));
          if (action === 'table:row:remove') {
            table.rows.splice(Number(actionButton.dataset.row), 1);
            if (!table.rows.length) table.rows.push(table.columns.map(() => ''));
          }
          if (action === 'table:header-row:add') table.headerRows.push({ cells: [{ text: '', colspan: 1, rowspan: 1 }] });
          if (action === 'table:header-row:remove') table.headerRows.splice(Number(actionButton.dataset.row), 1);
          if (action === 'table:header-cell:add') {
            const row = table.headerRows[Number(actionButton.dataset.row)];
            row.cells.push({ text: '', colspan: 1, rowspan: 1 });
          }
          if (action === 'table:header-cell:remove') {
            const row = table.headerRows[Number(actionButton.dataset.row)];
            row.cells.splice(Number(actionButton.dataset.cell), 1);
          }
        }

        renderTranslationProductBuilders();
      };

      const saveDraft = async () => {
        const payload = getPayload();
        if (!payload.productSlug) {
          setStatus('statusText', '请先填写产品 slug。', true);
          return;
        }
        if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(payload.productSlug)) {
          setStatus('statusText', 'Slug 只能使用小写英文、数字和短横线，例如 vx-modular-control-cabinet。', true);
          return;
        }
        setStatus('statusText', '正在保存草稿...');
        const data = await requestJson('/api/manager/product-drafts', {
          method: 'POST',
          body: JSON.stringify({ id: state.activeDraftId, payload }),
        });
        state.activeDraftId = data.draft?.id || '';
        state.activeSlug = payload.productSlug;
        await loadDrafts();
        setStatus('statusText', '草稿已保存。');
      };

      const applyDraft = async draftId => {
        setStatus('statusText', '正在提交内容更新...');
        const data = await requestJson(`/api/manager/product-drafts/${encodeURIComponent(draftId)}/apply`, { method: 'POST' });
        await loadDrafts();
        setStatus('statusText', data.requestId ? '内容更新已提交，请稍后刷新查看。' : '内容更新已提交。');
      };

      const parentPrefix = prefix => {
        const parts = prefix.split('/').filter(Boolean);
        parts.pop();
        return parts.length ? `${parts.join('/')}/` : '';
      };

      const renderAssets = () => {
        $('assetPath').textContent = state.assetPrefix || '根目录';
        const folders = state.assetFolders
          .map(
            folder => `
              <button class="asset-card is-folder" data-folder="${escapeHtml(folder.prefix)}" type="button">
                <span class="folder-icon" aria-hidden="true"></span>
                <div class="asset-name" title="${escapeHtml(folder.prefix)}">${escapeHtml(folder.name)}</div>
                <div class="asset-meta">文件夹</div>
              </button>
            `
          )
          .join('');
        const files = state.assetFiles
          .map(
            file => `
              <div class="asset-card">
                <input class="asset-check" data-asset-check="${escapeHtml(file.key)}" type="checkbox" ${state.selectedAssetKeys.has(file.key) ? 'checked' : ''} />
                ${
                  file.isImage
                    ? `<button class="asset-card__preview" data-asset-preview="${escapeHtml(file.url)}" data-asset-name="${escapeHtml(file.name)}" data-asset-key="${escapeHtml(file.key)}" type="button" aria-label="预览 ${escapeHtml(file.name)}">${thumbnailMarkup(file.url, file.name)}</button>`
                    : `<div class="asset-placeholder${file.isDocument ? ' asset-document' : ''}">${file.isDocument ? 'PDF' : '文件'}</div>`
                }
                <div class="asset-name" title="${escapeHtml(file.key)}">${escapeHtml(file.name)}</div>
                <div class="asset-meta">${escapeHtml(formatBytes(file.size))}</div>
                <div class="asset-tools">
                  <button data-copy="${escapeHtml(file.url)}" type="button">复制链接</button>
                  ${file.isDocument ? `<button data-asset-insert-document="${escapeHtml(file.url)}" data-asset-document-name="${escapeHtml(file.name)}" type="button">插入 PDF</button>` : ''}
                  <button data-delete="${escapeHtml(file.key)}" type="button">删除</button>
                </div>
              </div>
            `
          )
          .join('');
        const uploadTile = `
          <button class="asset-card asset-card--upload" data-asset-upload type="button">
            <span class="upload-icon" aria-hidden="true"></span>
            <div class="asset-name">上传图片</div>
            <div class="asset-meta">当前文件夹</div>
          </button>
        `;
        $('assetGrid').innerHTML = uploadTile + folders + files || '<div class="notice"><span><strong>当前文件夹为空</strong><small>可以上传图片或新建文件夹。</small></span></div>';
      };

      const loadAssets = async (prefix = state.assetPrefix) => {
        setStatus('assetStatus', '正在加载图片池...');
        const data = await requestJson(`/api/manager/r2/assets?prefix=${encodeURIComponent(prefix)}&limit=300`);
        state.assetPrefix = data.prefix || '';
        state.assetFolders = data.folders || [];
        state.assetFiles = data.files || [];
        state.selectedAssetKeys.clear();
        renderAssets();
        setStatus('assetStatus', `已加载 ${state.assetFolders.length} 个文件夹、${state.assetFiles.length} 个文件。`);
      };

      const renderImagePicker = () => {
        $('imagePickerPath').textContent = state.imagePicker.prefix || '根目录';
        const folders = state.imagePicker.folders
          .map(
            folder => `
              <button class="image-picker-card is-folder" data-picker-folder="${escapeHtml(folder.prefix)}" type="button">
                <span class="folder-icon" aria-hidden="true"></span>
                <strong title="${escapeHtml(folder.prefix)}">${escapeHtml(folder.name)}</strong>
                <small>文件夹</small>
              </button>
            `
          )
          .join('');
        const files = state.imagePicker.files
          .filter(file => file.isImage)
          .map(
            file => `
              <article class="image-picker-card">
                <button class="image-card-preview" data-picker-preview="${escapeHtml(file.url)}" data-picker-name="${escapeHtml(file.name)}" data-picker-key="${escapeHtml(file.key)}" type="button" aria-label="预览 ${escapeHtml(file.name)}">
                  ${thumbnailMarkup(file.url, file.name)}
                </button>
                <strong title="${escapeHtml(file.key)}">${escapeHtml(file.name)}</strong>
                <small>${escapeHtml(formatBytes(file.size))}</small>
                <div class="image-picker-actions">
                  <button class="mini-button" data-picker-select="${escapeHtml(file.url)}" type="button">选择</button>
                  <button class="mini-button" data-picker-copy="${escapeHtml(file.url)}" type="button">复制链接</button>
                </div>
              </article>
            `
          )
          .join('');
        $('imagePickerGrid').innerHTML =
          folders + files || '<div class="notice"><span><strong>当前文件夹没有图片</strong><small>请进入其它文件夹或先在图片池上传。</small></span></div>';
      };

      const loadImagePickerAssets = async (prefix = state.imagePicker.prefix) => {
        setStatus('imagePickerStatus', '正在加载图片...');
        const data = await requestJson(`/api/manager/r2/assets?prefix=${encodeURIComponent(prefix)}&limit=300`);
        state.imagePicker.prefix = data.prefix || '';
        state.imagePicker.folders = data.folders || [];
        state.imagePicker.files = data.files || [];
        renderImagePicker();
        setStatus('imagePickerStatus', `已加载 ${state.imagePicker.folders.length} 个文件夹、${state.imagePicker.files.filter(file => file.isImage).length} 张图片。`);
      };

      const openImagePicker = async options => {
        state.imagePicker = {
          fieldId: options.fieldId || '',
          listKey: options.listKey || '',
          richEditorId: options.richEditorId || '',
          detailIndex: options.detailIndex ?? null,
          prefix: '',
          files: [],
          folders: [],
        };
        $('imagePickerTitle').textContent = options.title || '选择图片';
        $('imagePicker').classList.add('is-open');
        $('imagePicker').setAttribute('aria-hidden', 'false');
        syncModalLock();
        await loadImagePickerAssets('');
      };

      const closeImagePicker = () => {
        $('imagePicker').classList.remove('is-open');
        $('imagePicker').setAttribute('aria-hidden', 'true');
        syncModalLock();
      };

      const pickImage = url => {
        if (state.imagePicker.fieldId) {
          $(state.imagePicker.fieldId).value = url;
          updateImageFieldPreview(state.imagePicker.fieldId);
        }
        if (state.imagePicker.listKey) {
          state.formData[state.imagePicker.listKey][Number(state.imagePicker.detailIndex)] = url;
          renderProductBuilders();
        }
        if (state.imagePicker.richEditorId) {
          insertRichEditorImage(state.imagePicker.richEditorId, url);
        }
        if (state.imagePicker.detailIndex !== null && !state.imagePicker.listKey) {
          const item = state.formData.detailImages[Number(state.imagePicker.detailIndex)];
          if (item) {
            item.image = url;
            renderProductBuilders();
          }
        }
        closeImagePicker();
      };

      const createFolder = async () => {
        const name = prompt('请输入新文件夹名称');
        if (!name) return;
        const cleanName = name.trim().replace(/^\/+|\/+$/g, '');
        if (!cleanName) return;
        await requestJson('/api/manager/r2/assets', {
          method: 'PUT',
          body: JSON.stringify({ prefix: `${state.assetPrefix}${cleanName}/` }),
        });
        await loadAssets();
      };

      const uploadAssets = async files => {
        if (!files?.length) return;
        const formData = new FormData();
        formData.append('prefix', state.assetPrefix);
        [...files].forEach(file => formData.append('files', file));
        setStatus('assetStatus', '正在上传图片...');
        await requestForm('/api/manager/r2/assets', formData);
        await loadAssets();
        setStatus('assetStatus', '图片已上传。');
      };

      const uploadPickerAssets = async files => {
        if (!files?.length) return;
        const formData = new FormData();
        formData.append('prefix', state.imagePicker.prefix);
        [...files].forEach(file => formData.append('files', file));
        setStatus('imagePickerStatus', '正在上传图片...');
        await requestForm('/api/manager/r2/assets', formData);
        await loadImagePickerAssets(state.imagePicker.prefix);
        setStatus('imagePickerStatus', '图片已上传，可直接选择。');
      };

      const copyText = async (value, statusId = 'assetStatus', trigger = null) => {
        const originalText = trigger?.textContent || '';
        try {
          await navigator.clipboard.writeText(value);
          setStatus(statusId, '链接已复制。');
        } catch {
          prompt('复制这个链接', value);
        }
        if (trigger) {
          trigger.textContent = '已复制';
          trigger.disabled = true;
          window.setTimeout(() => {
            trigger.textContent = originalText || '复制链接';
            trigger.disabled = false;
          }, 1600);
        }
      };

      const deleteAsset = async key => {
        if (!confirm(`确认删除这个文件？\n${key}`)) return;
        await requestJson('/api/manager/r2/assets', { method: 'DELETE', body: JSON.stringify({ key }) });
        await loadAssets();
      };

      const cutSelectedAssets = () => {
        state.cutAssetKeys = [...state.selectedAssetKeys];
        setStatus('assetStatus', state.cutAssetKeys.length ? `已剪切 ${state.cutAssetKeys.length} 个文件。` : '请先勾选需要移动的文件。', !state.cutAssetKeys.length);
      };

      const pasteAssets = async () => {
        if (!state.cutAssetKeys.length) {
          setStatus('assetStatus', '没有已剪切的文件。', true);
          return;
        }
        await requestJson('/api/manager/r2/assets', {
          method: 'PATCH',
          body: JSON.stringify({ keys: state.cutAssetKeys, targetPrefix: state.assetPrefix }),
        });
        state.cutAssetKeys = [];
        await loadAssets();
      };

      const renderLocaleOptions = () => {
        if (!locales.length) {
          $('localeGrid').innerHTML = '<p class="muted">站长尚未在 /keystatic/ 的“网站语言”页面启用目标语言。</p>';
          syncLocaleBulkControls();
          return;
        }
        $('localeGrid').innerHTML = locales
          .map(
            ([code, label]) => `
              <label>
                <input type="checkbox" value="${code}" checked />
                <span>${escapeHtml(label)}</span>
              </label>
            `
          )
          .join('');
        syncLocaleBulkControls();
      };

      const loadTranslationLocales = async () => {
        const response = await fetch('/api/ai/translation-locales', { headers: { accept: 'application/json' } });
        if (!response.ok) throw new Error(await response.text());
        const payload = await response.json();
        const configured = Array.isArray(payload.locales) ? payload.locales : [];
        locales.splice(0, locales.length, ...configured
          .filter(item => item && typeof item.value === 'string' && typeof item.label === 'string')
          .map(item => [item.value, item.label]));
        renderLocaleOptions();
      };

      const localeInputs = () => [...$('localeGrid').querySelectorAll('input[type="checkbox"]')];

      const syncLocaleBulkControls = () => {
        const inputs = localeInputs();
        const checkedCount = inputs.filter(input => input.checked).length;
        const selectAll = $('translationLocaleSelectAll');
        selectAll.checked = inputs.length > 0 && checkedCount === inputs.length;
        selectAll.indeterminate = checkedCount > 0 && checkedCount < inputs.length;
        $('translationLocaleInvert').checked = false;
      };

      const setAllLocales = checked => {
        localeInputs().forEach(input => {
          input.checked = checked;
        });
        syncLocaleBulkControls();
      };

      const invertLocales = () => {
        localeInputs().forEach(input => {
          input.checked = !input.checked;
        });
        syncLocaleBulkControls();
      };

      const selectedLocales = () =>
        [...$('localeGrid').querySelectorAll('input[type="checkbox"]:checked')].map(input => input.value);

      const translationOutcomeLabel = result => {
        if (!result) return '';
        if (result.resultStatusLabel) return result.resultStatusLabel;
        const generated = result.generated?.length || 0;
        const skipped = result.skipped?.length || 0;
        const errors = result.errors?.length || 0;
        if (errors && (generated || skipped)) return '部分成功';
        if (errors) return '全部失败';
        return '全部成功';
      };

      const translationOutcomeMessage = result => {
        const generated = result?.generated?.length || 0;
        const skipped = result?.skipped?.length || 0;
        const errors = result?.errors?.length || 0;
        if (errors && generated) return '已生成的草稿可以继续审核；失败的语言已列在下面，可稍后只重试失败项。';
        if (errors && skipped) return '已有草稿被跳过；失败的语言已列在下面，可稍后只重试失败项。';
        if (errors) return '本次没有生成可用草稿。请查看失败明细，更换可用 AI Key 后重试。';
        if (generated) return '翻译任务已完成。请到产品翻译草稿或文章翻译草稿里审核。';
        if (skipped) return '任务已完成，没有新增草稿；本次目标草稿已经存在。';
        return '任务已结束，但没有产生新草稿、跳过项或错误。请打开任务记录确认输入范围。';
      };

      const renderTranslationItems = (items, emptyText, renderItem) => {
        if (!items?.length) return `<p class="translation-result-empty">${emptyText}</p>`;
        const visible = items.slice(0, 20);
        const more = items.length > visible.length ? `<li>还有 ${items.length - visible.length} 条未显示，请打开任务记录查看完整列表。</li>` : '';
        return `<ul>${visible.map(renderItem).join('')}${more}</ul>`;
      };

      const renderTranslationResult = data => {
        const result = data.result;
        const generated = result?.generated?.length || 0;
        const skipped = result?.skipped?.length || 0;
        const errors = result?.errors?.length || 0;
        const toneClass = result
          ? errors
            ? generated || skipped
              ? 'is-warning'
              : 'is-error'
            : 'is-success'
          : '';
        $('translationResult').innerHTML = `
          <div class="notice ${toneClass}">
            <span>
              <strong>${escapeHtml(translationOutcomeLabel(result) || data.label || data.status || '任务状态')}</strong>
              <small>${escapeHtml(data.run?.title || data.message || '')}</small>
              ${
                result
                  ? `<small>生成 ${generated} 条，跳过 ${skipped} 条，错误 ${errors} 条。</small>`
                  : '<small>任务结果文件生成后会在这里显示摘要。</small>'
              }
              ${result ? `<small>${escapeHtml(translationOutcomeMessage(result))}</small>` : ''}
            </span>
          </div>
          ${
            result
              ? `
                <div class="translation-result-columns">
                  <section class="is-success">
                    <strong>成功生成</strong>
                    ${renderTranslationItems(
                      result.generated || [],
                      '本次没有新增草稿。',
                      item => {
                        const previewType = item.type === 'blog' ? 'blog' : 'product';
                        const previewHref = `/api/manager/ai/draft-preview?type=${previewType}&draft=${encodeURIComponent(`${item.locale}--${item.slug}`)}`;
                        const retryText = item.attempts && item.attempts > 1 ? `，重试 ${item.attempts - 1} 次` : '';
                        return `<li>${escapeHtml(item.type)} / ${escapeHtml(item.locale)} / ${escapeHtml(item.slug)}${item.keySlot ? `，AI 通道 ${escapeHtml(item.keySlot)}` : ''}${escapeHtml(retryText)} <a href="${escapeHtml(previewHref)}" data-auth-preview="${escapeHtml(previewHref)}" data-preview-status="translationStatus" target="_blank" rel="noreferrer">预览</a></li>`;
                      }
                    )}
                  </section>
                  <section class="is-skipped">
                    <strong>跳过</strong>
                    ${renderTranslationItems(
                      result.skipped || [],
                      '本次没有跳过项。',
                      item => `<li>${escapeHtml(item.type)} / ${escapeHtml(item.locale)} / ${escapeHtml(item.slug)}：${escapeHtml(item.reason || '已存在')}</li>`
                    )}
                  </section>
                  <section class="is-failure">
                    <strong>失败</strong>
                    ${renderTranslationItems(
                      result.errors || [],
                      '本次没有失败项。',
                      item => {
                        const retryText = item.attempts && item.attempts > 1 ? `，已重试 ${item.attempts - 1} 次` : '';
                        const keyText = item.keySlots?.length ? `，通道 ${item.keySlots.join(' -> ')}` : '';
                        return `<li>${escapeHtml(item.type)} / ${escapeHtml(item.locale)} / ${escapeHtml(item.slug)}：${escapeHtml(item.friendlyMessage || item.message || '翻译失败')}${escapeHtml(retryText)}${escapeHtml(keyText)}</li>`;
                      }
                    )}
                  </section>
                </div>
              `
              : ''
          }
        `;
      };

      const generatedTranslationDraftTypes = result => [
        ...new Set(
          (result?.generated || [])
            .map(item => (item.type === 'blog' ? 'blog' : item.type === 'product' ? 'product' : ''))
            .filter(Boolean)
        ),
      ];

      const requestedTranslationDraftTypes = sourceType =>
        sourceType === 'blog' ? ['blog'] : sourceType === 'products' ? ['product'] : ['product', 'blog'];

      const refreshCompletedTranslationDrafts = async data => {
        const types = generatedTranslationDraftTypes(data.result);
        if (!types.length && data.status === 'completed' && data.conclusion === 'success') {
          types.push(...requestedTranslationDraftTypes(state.translationLastSourceType));
        }
        if (!types.length) return;

        const syncKey = `${data.requestId || state.translationRequestId}:${types.sort().join(',')}:${data.result?.generated?.length || 0}`;
        if (state.translationDraftSyncKey === syncKey) return;
        state.translationDraftSyncKey = syncKey;

        if (types.length === 1 && activePanel() === 'translation') {
          activateTab(translationDraftTabForType(types[0]));
          return;
        }

        await Promise.all(
          types.map(type =>
            loadTranslationDrafts(type).catch(error => setStatus(draftUi(type).status, error.message, true))
          )
        );
      };

      const draftUi = type =>
        type === 'blog'
          ? {
              list: 'blogDraftList',
              status: 'blogDraftStatus',
              include: 'blogDraftIncludePublished',
              empty: '当前没有需要显示的文章翻译草稿',
            }
          : {
              list: 'productDraftList',
              status: 'productDraftStatus',
              include: 'productDraftIncludePublished',
              empty: '当前没有需要显示的产品翻译草稿',
            };

      const renderTranslationDrafts = (type, drafts) => {
        const ui = draftUi(type);
        $(ui.list).innerHTML = drafts.length
          ? drafts
              .map(
                draft => `
                  <div class="record translation-record" data-translation-type="${escapeHtml(type)}" data-translation-slug="${escapeHtml(draft.draftSlug)}">
                    <label>
                      <input type="checkbox" data-translation-draft="${escapeHtml(type)}:${escapeHtml(draft.draftSlug)}" />
                      <span>
                        <strong>${escapeHtml(draft.locale)} · ${escapeHtml(draft.title)}</strong>
                        <small>${escapeHtml(draft.typeLabel)} · ${draft.published ? '已审核发布' : '待审核'} · ${formatDate(draft.generatedAt)}</small>
                        <small>源内容：${escapeHtml(draft.sourceTitle || draft.sourceSlug)}</small>
                      </span>
                    </label>
                    <span class="record-actions">
                      <a class="button secondary" href="${escapeHtml(draft.previewUrl)}" data-auth-preview="${escapeHtml(draft.previewUrl)}" data-preview-status="${escapeHtml(ui.status)}" target="_blank" rel="noreferrer">预览</a>
                      <button class="button secondary" data-translation-edit="${escapeHtml(type)}:${escapeHtml(draft.draftSlug)}" type="button">审核编辑</button>
                    </span>
                  </div>
                `
              )
              .join('')
          : `<div class="notice"><span><strong>${ui.empty}</strong><small>生成多语言草稿完成后再刷新。</small></span></div>`;
      };

      const loadTranslationDrafts = async type => {
        const ui = draftUi(type);
        setStatus(ui.status, '正在加载翻译草稿...');
        const includePublished = $(ui.include).checked ? 'true' : 'false';
        const data = await requestJson(`/api/manager/ai/drafts?type=${encodeURIComponent(type)}&includePublished=${includePublished}`);
        state.translationDrafts = data.drafts || [];
        renderTranslationDrafts(type, state.translationDrafts);
        const warning = data.warning ? ` ${data.warning}` : '';
        setStatus(ui.status, `待审核 ${data.counts?.pending || 0} 条，当前显示 ${data.counts?.visible || state.translationDrafts.length} 条。${warning}`);
      };

      const approveTranslationDrafts = async type => {
        const ui = draftUi(type);
        const drafts = [...document.querySelectorAll(`[data-translation-draft^="${type}:"]:checked`)].map(input =>
          input.dataset.translationDraft.replace(`${type}:`, '')
        );
        if (!drafts.length) {
          setStatus(ui.status, '请先勾选需要审核的草稿。', true);
          return;
        }
        setStatus(ui.status, '正在审核选中草稿...');
        const data = await requestJson('/api/manager/ai/drafts', {
          method: 'PATCH',
          body: JSON.stringify({ type, drafts }),
        });
        if (data.errors?.length) {
          setStatus(ui.status, `审核完成但有 ${data.errors.length} 个错误，请检查草稿。`, true);
        } else {
          setStatus(ui.status, `已审核 ${data.approved?.length || 0} 个草稿。`);
        }
        await loadTranslationDrafts(type);
      };

      const setTranslationEditorOpen = open => {
        if (open) activateTab('translation-editor');
        else activateTab(state.translationEditor.returnTab || translationDraftTabForType(state.translationEditor.type));
      };

      const closeTranslationEditor = () => {
        const returnTab = state.translationEditor.returnTab || translationDraftTabForType(state.translationEditor.type);
        state.translationEditor = { type: '', draftSlug: '', draft: null, returnTab };
        setTranslationFormData({});
        setStatus('translationEditorStatus', '请选择一条翻译草稿。');
        setTranslationEditorOpen(false);
      };

      const fillTranslationEditor = (draft, warning = '') => {
        const data = draft.data || {};
        const isProduct = draft.type === 'product';
        const editable = draft.editable !== false;
        $('translationEditorTitle').textContent = `${draft.typeLabel}翻译草稿`;
        $('translationEditorPreviewLink').href = draft.previewUrl || '#';
        $('translationEditorPreviewLink').dataset.authPreview = draft.previewUrl || '';
        $('translationEditorPreviewLink').dataset.previewStatus = 'translationEditorStatus';
        $('translationEditTitle').value = data.title || '';
        $('translationEditDescription').value = data.description || '';
        $('translationEditCategoryName').value = data.categoryName || '';
        $('translationEditSeries').value = data.series || '';
        $('translationEditCategory').value = data.category || '';
        setTranslationFormData(data);
        renderTranslationProductBuilders();
        setRichTextValue('translationEditBody', draft.body || '');
        $('translationEditPublished').checked = data.published === true;
        document.querySelectorAll('.translation-edit-product').forEach(node => {
          node.hidden = !isProduct;
        });
        document.querySelectorAll('.translation-edit-blog').forEach(node => {
          node.hidden = isProduct;
        });
        $('translationEditorSaveButton').disabled = !editable;
        $('translationEditorApproveButton').disabled = !editable;
        setStatus(
          'translationEditorStatus',
          warning
            ? editable
              ? `${warning} 当前仍可编辑，保存时会写回 GitHub。`
              : warning
            : editable
              ? '草稿已加载。'
              : '当前为本地只读草稿，无法直接保存。'
        );
      };

      const openTranslationDraftEditor = async (type, draftSlug) => {
        const ui = draftUi(type);
        const returnTab = translationDraftTabForType(type);
        state.translationEditor = { type, draftSlug, draft: null, returnTab };
        setStatus(ui.status, '正在读取翻译草稿...');
        setStatus('translationEditorStatus', '正在读取翻译草稿...');
        setTranslationEditorOpen(true);
        const data = await requestJson(`/api/manager/ai/drafts?type=${encodeURIComponent(type)}&draft=${encodeURIComponent(draftSlug)}`);
        state.translationEditor = { type, draftSlug, draft: data.draft, returnTab };
        fillTranslationEditor(data.draft, data.warning || '');
        if (data.warning) setStatus(ui.status, data.warning, true);
        else setStatus(ui.status, '草稿已打开。');
      };

      const cleanTranslationStrings = value => (Array.isArray(value) ? value.map(item => String(item || '').trim()).filter(Boolean) : []);

      const cleanTranslationSpecs = value =>
        Array.isArray(value)
          ? value
              .map(item => ({
                label: String(item?.label || '').trim(),
                value: String(item?.value || '').trim(),
              }))
              .filter(item => item.label || item.value)
          : [];

      const cleanTranslationFaqs = value =>
        Array.isArray(value)
          ? value
              .map(item => ({
                question: String(item?.question || '').trim(),
                answer: String(item?.answer || '').trim(),
              }))
              .filter(item => item.question || item.answer)
          : [];

      const cleanTranslationSpecTables = value =>
        Array.isArray(value)
          ? value
              .map(table => {
                const columns = cleanTranslationStrings(table?.columns);
                const rows = Array.isArray(table?.rows)
                  ? table.rows
                      .map(row => (Array.isArray(row) ? row.map(cell => String(cell || '').trim()) : []))
                      .filter(row => row.some(Boolean))
                  : [];
                const headerRows = Array.isArray(table?.headerRows)
                  ? table.headerRows
                      .map(row => ({
                        cells: Array.isArray(row?.cells)
                          ? row.cells
                              .map(cell => ({
                                text: String(cell?.text || '').trim(),
                                colspan: Math.max(1, Number(cell?.colspan || 1)),
                                rowspan: Math.max(1, Number(cell?.rowspan || 1)),
                              }))
                              .filter(cell => cell.text)
                          : [],
                      }))
                      .filter(row => row.cells.length)
                  : [];
                return {
                  title: String(table?.title || '').trim(),
                  columns,
                  headerRows,
                  rows,
                };
              })
              .filter(table => table.title || table.columns.length || table.rows.length || table.headerRows.length)
          : [];

      const saveTranslationDraftEditor = async ({ publish = false } = {}) => {
        const { type, draftSlug, draft } = state.translationEditor;
        if (!type || !draftSlug || !draft) return;
        const data = { ...(draft.data || {}) };
        data.title = $('translationEditTitle').value.trim();
        data.description = $('translationEditDescription').value.trim();
        data.published = publish ? true : $('translationEditPublished').checked;
        if (type === 'product') {
          data.categoryName = $('translationEditCategoryName').value.trim();
          data.series = $('translationEditSeries').value.trim();
          data.applications = cleanTranslationStrings(state.translationFormData.applications);
          data.specs = cleanTranslationSpecs(state.translationFormData.specs);
          data.specTables = cleanTranslationSpecTables(state.translationFormData.specTables);
          data.highlights = cleanTranslationStrings(state.translationFormData.highlights);
          data.faqs = cleanTranslationFaqs(state.translationFormData.faqs);
        } else {
          data.category = $('translationEditCategory').value.trim();
        }
        setStatus('translationEditorStatus', '正在保存草稿...');
        const response = await requestJson('/api/manager/ai/drafts', {
          method: 'PUT',
          body: JSON.stringify({
            type,
            draftSlug,
            data,
            body: getRichTextValue('translationEditBody'),
          }),
        });
        state.translationEditor.draft = response.draft;
        fillTranslationEditor(response.draft);
        await loadTranslationDrafts(type);
        setStatus('translationEditorStatus', publish ? '草稿已审核并保存。' : '草稿已保存。');
      };

      const handleTranslationDraftListClick = event => {
        const editButton = event.target.closest('[data-translation-edit]');
        if (editButton) {
          const [type, draftSlug] = editButton.dataset.translationEdit.split(':');
          if (type && draftSlug) openTranslationDraftEditor(type, draftSlug).catch(error => setStatus(draftUi(type).status, error.message, true));
          return;
        }
        if (event.target.closest('input, a, button')) return;
        const row = event.target.closest('.record');
        const type = row?.dataset.translationType;
        const draftSlug = row?.dataset.translationSlug;
        if (type && draftSlug) openTranslationDraftEditor(type, draftSlug).catch(error => setStatus(draftUi(type).status, error.message, true));
      };

      const pollTranslationStatus = async () => {
        if (!state.translationRequestId) {
          setStatus('translationStatus', '还没有提交任务。', true);
          return;
        }
        const data = await requestJson(`/api/manager/ai/translation-status?requestId=${encodeURIComponent(state.translationRequestId)}`);
        setStatus('translationStatus', data.label || data.status || '状态已刷新。', data.conclusion && data.conclusion !== 'success');
        renderTranslationResult(data);
        if (data.status === 'completed') {
          clearInterval(state.translationTimer);
          state.translationTimer = null;
          await refreshCompletedTranslationDrafts(data);
        }
      };

      const submitTranslation = async () => {
        const locales = selectedLocales();
        if (!locales.length) {
          setStatus('translationStatus', '请至少选择一个目标语言。', true);
          return;
        }
        setStatus('translationStatus', '正在提交翻译任务...');
        const data = await requestJson('/api/manager/ai/translations', {
          method: 'POST',
          body: JSON.stringify({
            sourceType: $('translationSourceType').value,
            sourceSlug: $('translationSlug').value.trim(),
            locales,
            overwrite: $('translationOverwrite').checked,
            apiKeyOffset: Date.now(),
          }),
        });
        state.translationRequestId = data.requestId;
        state.translationDraftSyncKey = '';
        state.translationLastSourceType = data.sourceType || $('translationSourceType').value || 'all';
        setStatus('translationStatus', '翻译任务已提交，请稍后刷新任务状态。');
        clearInterval(state.translationTimer);
        state.translationTimer = setInterval(() => pollTranslationStatus().catch(error => setStatus('translationStatus', error.message, true)), 8000);
      };

      const renderPublishHistory = records => {
        $('publishHistory').innerHTML = records.length
          ? records
              .map(
                record => `
                  <div class="record">
                    <label>
                      <input type="checkbox" data-publish-record="${escapeHtml(record.id)}" />
                      <span>
                        <strong>${escapeHtml(record.label)} · ${escapeHtml(record.requestId || `#${record.runNumber}`)}</strong>
                        <small>${escapeHtml(record.message || '')}</small>
                        <small>提交：${formatDate(record.submittedAt)} · 更新：${formatDate(record.updatedAt)}</small>
                      </span>
                    </label>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无发布记录</strong><small>点击发布网站更新后会显示最近记录。</small></span></div>';
      };

      const loadPublishHistory = async () => {
        setStatus('publishStatus', '正在读取最近发布记录...');
        const data = await requestJson('/api/manager/deploy/site');
        state.publishRecords = data.records || [];
        renderPublishHistory(state.publishRecords);
        setStatus('publishStatus', `已读取最近 ${state.publishRecords.length} 条记录。`);
      };

      const pollPublishStatus = async () => {
        if (!state.publishRequestId) {
          setStatus('publishStatus', '还没有提交发布。', true);
          return;
        }
        const data = await requestJson(`/api/manager/deploy/site?requestId=${encodeURIComponent(state.publishRequestId)}`);
        setStatus('publishStatus', data.message || data.label || data.status, data.stage === 'failed');
        if (data.stage === 'success' || data.stage === 'failed') {
          clearInterval(state.publishTimer);
          state.publishTimer = null;
          await loadPublishHistory();
        }
      };

      const submitPublish = async () => {
        if (!confirm('确认发布网站更新？请确保产品、文章和翻译草稿已经检查完成。')) return;
        setStatus('publishStatus', '正在提交发布任务...');
        const data = await requestJson('/api/manager/deploy/site', { method: 'POST', body: JSON.stringify({}) });
        state.publishRequestId = data.requestId;
        setStatus('publishStatus', data.message || `任务已提交：${data.requestId}`);
        clearInterval(state.publishTimer);
        state.publishTimer = setInterval(() => pollPublishStatus().catch(error => setStatus('publishStatus', error.message, true)), 8000);
        await pollPublishStatus();
      };

      const deletePublishRecords = async () => {
        const runIds = [...document.querySelectorAll('[data-publish-record]:checked')].map(input => Number(input.dataset.publishRecord));
        if (!runIds.length) {
          setStatus('publishStatus', '请先勾选需要删除的发布记录。', true);
          return;
        }
        if (!confirm(`确认删除 ${runIds.length} 条发布记录？`)) return;
        await requestJson('/api/manager/deploy/site', { method: 'DELETE', body: JSON.stringify({ runIds }) });
        await loadPublishHistory();
      };

      document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => activateTab(button.dataset.tab)));
      $('searchInput').addEventListener('input', () => {
        state.productPage = 1;
        renderProducts();
      });
      $('categoryFilter').addEventListener('change', () => {
        state.productPage = 1;
        renderProducts();
      });
      $('productPagination').addEventListener('click', event => {
        const button = event.target.closest('[data-product-page]');
        if (button && !button.disabled) setProductPage(button.dataset.productPage);
      });
      $('orderSearchInput').addEventListener('input', renderProductOrder);
      $('orderCategoryFilter').addEventListener('change', renderProductOrder);
      $('orderGrid').addEventListener('input', event => {
        const input = event.target.closest('[data-order-slug]');
        if (!input) return;
        const product = state.products.find(item => item.slug === input.dataset.orderSlug);
        const nextValue = Math.max(1, Math.round(Number(input.value || 1)));
        if (product && nextValue === Number(product.sortOrder)) state.orderChanges.delete(input.dataset.orderSlug);
        else state.orderChanges.set(input.dataset.orderSlug, nextValue);
        setStatus('orderStatus', `已修改 ${state.orderChanges.size} 个权重，保存后会生成排序草稿。`);
      });
      $('orderSaveButton').addEventListener('click', () => saveOrderDrafts().catch(error => setStatus('orderStatus', error.message, true)));
      $('blogSearchInput').addEventListener('input', renderBlogPosts);
      $('blogForm').addEventListener('input', event => {
        if (event.target.id === 'blogImage') updateImageFieldPreview('blogImage');
      });
      $('blogRefreshButton').addEventListener('click', () => Promise.all([loadBlogPosts(), loadBlogDrafts()]).catch(error => setStatus('blogStatus', error.message, true)));
      $('newBlogButton').addEventListener('click', startNewBlog);
      $('blogList').addEventListener('click', event => {
        if (event.target.closest('[data-blog-view]')) return;
        const row = event.target.closest('[data-blog-slug]');
        if (row) selectBlogPost(row.dataset.blogSlug);
      });
      $('saveBlogDraftButton').addEventListener('click', () => saveBlogDraft().catch(error => setStatus('blogStatus', error.message, true)));
      $('reloadBlogDraftButton').addEventListener('click', () => loadBlogDrafts().catch(error => setStatus('blogStatus', error.message, true)));
      $('blogDraftWorkList').addEventListener('click', event => {
        const button = event.target.closest('[data-blog-apply]');
        if (button) applyBlogDraft(button.dataset.blogApply).catch(error => setStatus('blogStatus', error.message, true));
      });
      $('reviewRefreshButton').addEventListener('click', () => loadReviews().catch(error => setStatus('reviewStatus', error.message, true)));
      $('newReviewButton').addEventListener('click', () => fillReviewForm(null));
      $('saveReviewDraftButton').addEventListener('click', () => saveReviewDraft('upsert').catch(error => setStatus('reviewStatus', error.message, true)));
      $('deleteReviewDraftButton').addEventListener('click', () => saveReviewDraft('delete').catch(error => setStatus('reviewStatus', error.message, true)));
      $('reviewList').addEventListener('click', event => {
        const button = event.target.closest('[data-review-id]');
        const review = button && state.reviews.find(item => item.id === button.dataset.reviewId);
        if (review) fillReviewForm(review);
      });
      $('reviewDraftList').addEventListener('click', event => {
        const edit = event.target.closest('[data-review-draft-edit]');
        if (edit) {
          const draft = state.reviewDrafts.find(item => item.id === edit.dataset.reviewDraftEdit);
          if (draft) fillReviewForm({ ...draft.payload, draftId: draft.id });
          return;
        }
        const apply = event.target.closest('[data-review-draft-apply]');
        if (apply) applyReviewDraft(apply.dataset.reviewDraftApply).catch(error => setStatus('reviewStatus', error.message, true));
      });
      $('productForm').addEventListener('input', event => syncProductFormInput(event.target));
      $('productForm').addEventListener('click', event => {
        const button = event.target.closest('[data-action]');
        if (button) handleProductAction(button);
      });
      $('productList').addEventListener('click', event => {
        if (event.target.closest('[data-product-view]') || event.target.closest('[data-product-published]')) return;
        const row = event.target.closest('[data-slug]');
        if (row) selectProduct(row.dataset.slug);
      });
      $('productList').addEventListener('change', event => {
        const input = event.target.closest('[data-product-published]');
        if (!input) return;
        const product = state.products.find(item => item.slug === input.dataset.productPublished);
        if (!product) return;
        product.published = input.checked;
        requestJson('/api/manager/product-drafts', {
          method: 'POST',
          body: JSON.stringify({ payload: productToPayload(product) }),
        })
          .then(() => {
            renderProducts();
            setStatus('productBrowserStatus', `${product.title} 已保存为${input.checked ? '上线' : '下线'}草稿。`);
          })
          .catch(error => {
            product.published = !input.checked;
            renderProducts();
            setStatus('productBrowserStatus', error.message, true);
          });
      });
      $('draftList').addEventListener('click', event => {
        const button = event.target.closest('[data-apply]');
        if (button) applyDraft(button.dataset.apply).catch(error => setStatus('statusText', error.message, true));
      });
      $('saveDraftButton').addEventListener('click', () => saveDraft().catch(error => setStatus('statusText', error.message, true)));
      $('reloadButton').addEventListener('click', () => loadDrafts().catch(error => setStatus('statusText', error.message, true)));
      $('newProductButton').addEventListener('click', startNewProduct);
      $('productBackButton').addEventListener('click', showProductBrowser);
      $('blogBackButton').addEventListener('click', showBlogBrowser);
      $('assetRefreshButton').addEventListener('click', () => loadAssets().catch(error => setStatus('assetStatus', error.message, true)));
      $('assetBackButton').addEventListener('click', () => loadAssets(parentPrefix(state.assetPrefix)).catch(error => setStatus('assetStatus', error.message, true)));
      $('assetNewFolderButton').addEventListener('click', () => createFolder().catch(error => setStatus('assetStatus', error.message, true)));
      $('assetUploadButton').addEventListener('click', () => $('assetUploadInput').click());
      $('assetUploadInput').addEventListener('change', event =>
        uploadAssets(event.target.files)
          .then(() => {
            event.target.value = '';
          })
          .catch(error => setStatus('assetStatus', error.message, true))
      );
      $('assetCutButton').addEventListener('click', cutSelectedAssets);
      $('assetPasteButton').addEventListener('click', () => pasteAssets().catch(error => setStatus('assetStatus', error.message, true)));
      $('assetGrid').addEventListener('click', event => {
        const upload = event.target.closest('[data-asset-upload]');
        if (upload) {
          $('assetUploadInput').click();
          return;
        }
        const folder = event.target.closest('[data-folder]');
        if (folder) {
          loadAssets(folder.dataset.folder).catch(error => setStatus('assetStatus', error.message, true));
          return;
        }
        const insertDocument = event.target.closest('[data-asset-insert-document]');
        if (insertDocument) {
          const editorId = state.richEditorSelection?.editorId;
          if (!editorId) {
            setStatus('assetStatus', '请先点击需要插入 PDF 的富文本字段。', true);
            return;
          }
          insertRichEditorDocument(editorId, insertDocument.dataset.assetInsertDocument, insertDocument.dataset.assetDocumentName);
          setStatus('assetStatus', 'PDF 链接已插入当前富文本字段。');
          return;
        }
        const preview = event.target.closest('[data-asset-preview]');
        if (preview) {
          openImagePreview({
            url: preview.dataset.assetPreview,
            name: preview.dataset.assetName,
            key: preview.dataset.assetKey,
            statusId: 'assetStatus',
          });
          return;
        }
        const copy = event.target.closest('[data-copy]');
        if (copy) {
          copyText(copy.dataset.copy, 'assetStatus', copy);
          return;
        }
        const del = event.target.closest('[data-delete]');
        if (del) {
          deleteAsset(del.dataset.delete).catch(error => setStatus('assetStatus', error.message, true));
        }
      });
      $('assetGrid').addEventListener('change', event => {
        const checkbox = event.target.closest('[data-asset-check]');
        if (!checkbox) return;
        if (checkbox.checked) state.selectedAssetKeys.add(checkbox.dataset.assetCheck);
        else state.selectedAssetKeys.delete(checkbox.dataset.assetCheck);
      });
      document.addEventListener('click', event => {
        if (!event.target.closest('.theme-switch')) setThemeMenuOpen(false);

        const imageFieldPreview = event.target.closest('[data-image-field-preview]');
        if (imageFieldPreview) {
          openImagePreview({
            url: imageFieldPreview.dataset.previewUrl,
            name: imageFieldPreview.dataset.imageFieldPreview === 'blogImage' ? '文章封面' : '产品主图',
            statusId: imageFieldPreview.dataset.previewStatus || 'assetStatus',
          });
          return;
        }

        const inlineImagePreview = event.target.closest('[data-inline-image-preview]');
        if (inlineImagePreview && inlineImagePreview.dataset.inlineImagePreview) {
          openImagePreview({
            url: inlineImagePreview.dataset.inlineImagePreview,
            name: '产品主图',
            statusId: 'statusText',
          });
          return;
        }

        const fieldButton = event.target.closest('[data-image-field]');
        if (fieldButton) {
          openImagePicker({
            fieldId: fieldButton.dataset.imageField,
            title: fieldButton.dataset.imageTitle || '选择图片',
          }).catch(error => setStatus('imagePickerStatus', error.message, true));
          return;
        }

        const listButton = event.target.closest('[data-image-list]');
        if (listButton) {
          openImagePicker({
            listKey: listButton.dataset.imageList,
            detailIndex: Number(listButton.dataset.index),
            title: '选择产品相册图',
          }).catch(error => setStatus('imagePickerStatus', error.message, true));
          return;
        }

        const detailButton = event.target.closest('[data-image-detail]');
        if (detailButton) {
          openImagePicker({
            detailIndex: Number(detailButton.dataset.imageDetail),
            title: '选择详情页宣传图',
          }).catch(error => setStatus('imagePickerStatus', error.message, true));
          return;
        }
      });
      $('imagePickerCloseButton').addEventListener('click', closeImagePicker);
      $('imagePicker').addEventListener('click', event => {
        if (event.target === $('imagePicker')) closeImagePicker();
      });
      $('imagePickerBackButton').addEventListener('click', () => loadImagePickerAssets(parentPrefix(state.imagePicker.prefix)).catch(error => setStatus('imagePickerStatus', error.message, true)));
      $('imagePickerRefreshButton').addEventListener('click', () => loadImagePickerAssets(state.imagePicker.prefix).catch(error => setStatus('imagePickerStatus', error.message, true)));
      $('imagePickerUploadButton').addEventListener('click', () => $('imagePickerUploadInput').click());
      $('imagePickerUploadInput').addEventListener('change', event =>
        uploadPickerAssets(event.target.files)
          .then(() => {
            event.target.value = '';
          })
          .catch(error => setStatus('imagePickerStatus', error.message, true))
      );
      $('imagePickerGrid').addEventListener('click', event => {
        const folder = event.target.closest('[data-picker-folder]');
        if (folder) {
          loadImagePickerAssets(folder.dataset.pickerFolder).catch(error => setStatus('imagePickerStatus', error.message, true));
          return;
        }
        const preview = event.target.closest('[data-picker-preview]');
        if (preview) {
          openImagePreview({
            url: preview.dataset.pickerPreview,
            name: preview.dataset.pickerName,
            key: preview.dataset.pickerKey,
            canSelect: true,
            statusId: 'imagePickerStatus',
          });
          return;
        }
        const select = event.target.closest('[data-picker-select]');
        if (select) {
          pickImage(select.dataset.pickerSelect);
          return;
        }
        const copy = event.target.closest('[data-picker-copy]');
        if (copy) copyText(copy.dataset.pickerCopy, 'imagePickerStatus', copy);
