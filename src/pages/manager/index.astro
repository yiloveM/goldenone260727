        border-radius: 5px;
        padding: 1px 5px;
        color: #344054;
        background: var(--surface-2);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        font-size: 0.9em;
        font-weight: 700;
      }

      .rich-editor__surface pre {
        margin: 0 0 14px;
        overflow: auto;
        border: 1px solid rgba(15, 23, 42, 0.12);
        border-radius: 8px;
        padding: 12px 14px;
        color: #f8fafc;
        background: #111827;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
        font-size: 13px;
        line-height: 1.55;
        white-space: pre;
