        $('connectionDetail').textContent = connected
          ? detail || '当前浏览器已通过内容管理专用域名和签名会话验证。'
          : detail || '请从站长提供的完整专用域名和 UUID 地址重新进入。';
      };

      const checkManagerStatus = async () => {
        try {
          const data = await requestJson('/api/manager/status');
          $('managerEmail').textContent = data.manager?.email || '已连接';
          setConnectedUi(true);
          return true;
        } catch (error) {
          $('managerEmail').textContent = '未连接';
          setConnectedUi(false, error.message);
          return false;
        }
      };

      const translationDraftTabForType = type => (type === 'blog' ? 'blog-drafts' : 'product-drafts');
      const activePanel = () => document.querySelector('.section.is-active')?.dataset.panel || '';

      const activateTab = tab => {
        const activeNavTab = tab === 'translation-editor' ? state.translationEditor.returnTab || translationDraftTabForType(state.translationEditor.type) : tab;
        document.querySelectorAll('.tab').forEach(button => button.classList.toggle('is-active', button.dataset.tab === activeNavTab));
        document.querySelectorAll('.section').forEach(panel => panel.classList.toggle('is-active', panel.dataset.panel === tab));
        if (tab === 'products') showProductBrowser();
        if (tab === 'blog') showBlogBrowser();
        if (tab === 'images' && !state.assetFiles.length && !state.assetFolders.length) loadAssets().catch(error => setStatus('assetStatus', error.message, true));
        if (tab === 'publish' && !state.publishRecords.length) loadPublishHistory().catch(error => setStatus('publishStatus', error.message, true));
        if (tab === 'blog' && !state.blogPosts.length) {
          Promise.all([loadBlogPosts(), loadBlogDrafts()]).catch(error => setStatus('blogStatus', error.message, true));
        }
        if (tab === 'reviews' && !state.reviews.length && !state.reviewDrafts.length) {
          loadReviews().catch(error => setStatus('reviewStatus', error.message, true));
        }
        if (tab === 'product-drafts') loadTranslationDrafts('product').catch(error => setStatus('productDraftStatus', error.message, true));
        if (tab === 'blog-drafts') loadTranslationDrafts('blog').catch(error => setStatus('blogDraftStatus', error.message, true));
      };

      const fillCategoryOptions = () => {
        const categoryFilter = $('categoryFilter');
        const orderCategoryFilter = $('orderCategoryFilter');
        const category = $('category');
        categoryFilter.innerHTML = '<option value="">所有分类</option>';
        orderCategoryFilter.innerHTML = '<option value="">所有分类</option>';
        category.innerHTML = '';
        for (const item of state.categories) {
          const value = escapeHtml(item);
          categoryFilter.insertAdjacentHTML('beforeend', `<option value="${value}">${value}</option>`);
          orderCategoryFilter.insertAdjacentHTML('beforeend', `<option value="${value}">${value}</option>`);
          category.insertAdjacentHTML('beforeend', `<option value="${value}">${value}</option>`);
        }
      };

      const filteredProducts = () => {
        const term = $('searchInput').value.trim().toLowerCase();
        const category = $('categoryFilter').value;
        return state.products
          .filter(product => {
            const matchesTerm = !term || `${product.title} ${product.series} ${product.category}`.toLowerCase().includes(term);
            const matchesCategory = !category || product.category === category;
            return matchesTerm && matchesCategory;
          })
          .sort((a, b) => Number(a.sortOrder || 9999) - Number(b.sortOrder || 9999) || String(a.title || '').localeCompare(String(b.title || '')));
      };

      const filteredOrderProducts = () => {
        const term = $('orderSearchInput').value.trim().toLowerCase();
        const category = $('orderCategoryFilter').value;
        return state.products.filter(product => {
          const matchesTerm = !term || `${product.title} ${product.series}`.toLowerCase().includes(term);
          const matchesCategory = !category || product.category === category;
          return matchesTerm && matchesCategory;
        });
      };

      const renderProducts = () => {
        const products = filteredProducts();
        const totalProducts = state.products.length;
        const onlineCount = state.products.filter(product => product.published !== false).length;
        const offlineCount = Math.max(0, totalProducts - onlineCount);
        const totalPages = Math.max(1, Math.ceil(products.length / productPageSize));
        const currentPage = Math.min(Math.max(1, state.productPage), totalPages);
        state.productPage = currentPage;
        const pageProducts = products.slice((currentPage - 1) * productPageSize, currentPage * productPageSize);
        const categoryLabel = $('categoryFilter').value || '全部分类';

        $('productTotalCount').textContent = totalProducts;
        $('productOnlineCount').textContent = onlineCount;
        $('productOfflineCount').textContent = offlineCount;
        $('productCategoryMeta').textContent = categoryLabel;
        $('productBrowserStatus').textContent = `当前筛选 ${products.length} 个产品 / 第 ${currentPage} 页，共 ${totalPages} 页`;
        $('productList').innerHTML = pageProducts.length
          ? `
            <div class="manager-product-head">
              <span>产品图</span>
              <span>产品名称</span>
              <span>产品分类</span>
              <span>操作</span>
            </div>
            ${pageProducts
              .map(
                product => `
                  <article class="manager-product-row ${product.slug === state.activeSlug ? 'is-active' : ''} ${product.published === false ? 'is-unpublished' : ''}">
                    <button class="manager-product-thumb" data-slug="${escapeHtml(product.slug)}" type="button" aria-label="编辑 ${escapeHtml(product.title)}">
                      ${thumbnailMarkup(product.image, product.title)}
                    </button>
                    <div class="manager-product-main">
                      <button class="manager-product-title" data-slug="${escapeHtml(product.slug)}" title="${escapeHtml(product.title)}" type="button">${escapeHtml(product.title)}</button>
                      <span class="manager-product-series">${escapeHtml(product.series || '未填写系列')}</span>
                    </div>
                    <span class="manager-product-category">${escapeHtml(product.category || '未分类')}</span>
                    <span class="manager-product-actions">
                      <label class="manager-product-publish ${product.published ? 'is-on' : ''}">
                        <input data-product-published="${escapeHtml(product.slug)}" type="checkbox" ${product.published ? 'checked' : ''} />
                        <span>${product.published ? '已上线' : '已下线'}</span>
                      </label>
                      <button class="manager-product-edit" data-slug="${escapeHtml(product.slug)}" type="button">编辑</button>
                      <a class="manager-product-view" data-product-view href="/products/${escapeHtml(product.slug)}/" target="_blank" rel="noreferrer">前端查看</a>
                    </span>
                  </article>
                `
              )
              .join('')}
          `
          : '<div class="manager-product-empty notice"><span><strong>没有匹配产品</strong><small>请换一个关键词或分类。</small></span></div>';
        $('productPagination').innerHTML = `
          <button data-product-page="first" type="button" ${currentPage <= 1 ? 'disabled' : ''}>首页</button>
          <button data-product-page="prev" type="button" ${currentPage <= 1 ? 'disabled' : ''}>上一页</button>
          <span>${currentPage} / ${totalPages}</span>
          <button data-product-page="next" type="button" ${currentPage >= totalPages ? 'disabled' : ''}>下一页</button>
          <button data-product-page="last" type="button" ${currentPage >= totalPages ? 'disabled' : ''}>末页</button>
        `;
      };

      const setProductPage = action => {
        const products = filteredProducts();
        const totalPages = Math.max(1, Math.ceil(products.length / productPageSize));
        if (action === 'first') state.productPage = 1;
        if (action === 'prev') state.productPage = Math.max(1, state.productPage - 1);
        if (action === 'next') state.productPage = Math.min(totalPages, state.productPage + 1);
        if (action === 'last') state.productPage = totalPages;
        renderProducts();
      };

      const renderProductOrder = () => {
        const products = filteredOrderProducts();
        $('orderGrid').innerHTML = products.length
          ? products
              .map(product => {
                const value = state.orderChanges.has(product.slug) ? state.orderChanges.get(product.slug) : product.sortOrder;
                return `
                  <article class="order-card">
                    ${thumbnailMarkup(product.image, product.title)}
                    <strong>${escapeHtml(product.title)}</strong>
                    <small>${escapeHtml(product.category)} · ${escapeHtml(product.series)}</small>
                    <label>
                      <small>权重</small>
                      <input data-order-slug="${escapeHtml(product.slug)}" type="number" min="1" step="1" value="${escapeHtml(value)}" />
                    </label>
                  </article>
                `;
              })
              .join('')
          : '<div class="notice"><span><strong>没有匹配产品</strong><small>请换一个关键词或分类。</small></span></div>';
        setStatus('orderStatus', `当前显示 ${products.length} 个产品，已修改 ${state.orderChanges.size} 个权重。`);
      };

      const filteredBlogPosts = () => {
        const term = $('blogSearchInput').value.trim().toLowerCase();
        return state.blogPosts.filter(post => !term || `${post.title} ${post.category}`.toLowerCase().includes(term));
      };

      const renderBlogPosts = () => {
        const posts = filteredBlogPosts();
        $('blogCount').textContent = `${posts.length} 篇文章`;
        $('blogList').innerHTML = posts.length
          ? `
              <div class="blog-list-head">
                <span>文章标题</span>
                <span>发表时间</span>
                <span>文章分类</span>
                <span>操作</span>
              </div>
              ${posts
                .map(
                  post => `
                    <article class="blog-list-row ${post.slug === state.activeBlogSlug ? 'is-active' : ''}" data-blog-slug="${escapeHtml(post.slug)}">
                      <button class="blog-list-title" title="${escapeHtml(post.title)}" type="button">${escapeHtml(post.title)}</button>
                      <span class="blog-list-date">${formatDate(post.publishDate)}</span>
                      <span class="blog-list-category">${escapeHtml(post.category || '未分类')}</span>
                      <a class="blog-list-view" data-blog-view href="/blog/${escapeHtml(post.slug)}/" target="_blank" rel="noreferrer">前端查看</a>
                    </article>
                  `
                )
                .join('')}
            `
          : '<div class="notice"><span><strong>没有匹配文章</strong><small>请换一个关键词。</small></span></div>';
        setStatus('blogStatus', `当前显示 ${posts.length} 篇文章。`);
      };

      const cloneArray = value => JSON.parse(JSON.stringify(Array.isArray(value) ? value : []));

      const setFormData = product => {
        state.formData = {
          galleryImages: cloneArray(product.galleryImages),
          detailImages: cloneArray(product.detailImages),
          applications: cloneArray(product.applications),
          specs: cloneArray(product.specs),
          specTables: cloneArray(product.specTables),
          highlights: cloneArray(product.highlights),
          faqs: cloneArray(product.faqs),
        };
      };

      const renderSingleTextList = (id, key, placeholder) => {
        const list = state.formData[key] || [];
        const isImageList = key === 'galleryImages';
        $(id).innerHTML = list.length
          ? list
              .map(
                (value, index) => `
                  <div class="form-row ${isImageList ? 'has-picker is-single' : ''}">
                    <input data-list="${key}" data-index="${index}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}" />
                    ${
                      isImageList
                        ? `<button class="field-image-preview" data-inline-image-preview="${escapeHtml(value)}" type="button" title="${escapeHtml(value || '当前没有图片')}" ${value ? '' : 'disabled'}>${thumbnailMarkup(value, '产品主图')}</button><button class="mini-button" data-image-list="${key}" data-index="${index}" type="button">选择</button>`
                        : '<span></span>'
                    }
                    <button class="mini-button danger" data-action="${key}:remove" data-index="${index}" type="button">删除</button>
                  </div>
                `
              )
              .join('')
          : `<div class="notice"><span><strong>暂无内容</strong><small>点击添加按钮新增。</small></span></div>`;
      };

      const renderSpecs = () => {
        const specs = state.formData.specs || [];
        $('specsList').innerHTML = specs.length
          ? specs
              .map(
                (item, index) => `
                  <div class="form-row">
                    <input data-spec-index="${index}" data-field="label" value="${escapeHtml(item.label || '')}" placeholder="参数名，例如 Flow Rate" />
                    <input data-spec-index="${index}" data-field="value" value="${escapeHtml(item.value || '')}" placeholder="参数值，例如 35 m³/h" />
                    <button class="mini-button danger" data-action="specs:remove" data-index="${index}" type="button">删除</button>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无参数</strong><small>点击添加参数新增。</small></span></div>';
      };

      const renderDetailImages = () => {
        const images = state.formData.detailImages || [];
        $('detailImageList').innerHTML = images.length
          ? images
              .map(
                (item, index) => `
                  <div class="builder">
                    <div class="form-row has-picker">
                      <input data-detail-index="${index}" data-field="image" value="${escapeHtml(item.image || '')}" placeholder="图片链接" />
                      <button class="mini-button" data-image-detail="${index}" type="button">选择</button>
                      <input data-detail-index="${index}" data-field="title" value="${escapeHtml(item.title || '')}" placeholder="图片标题" />
                      <button class="mini-button danger" data-action="detail:remove" data-index="${index}" type="button">删除</button>
                    </div>
                    <textarea data-detail-index="${index}" data-field="caption" placeholder="图片说明">${escapeHtml(item.caption || '')}</textarea>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无详情图</strong><small>点击添加详情图新增。</small></span></div>';
      };

      const renderFaqs = () => {
        const faqs = state.formData.faqs || [];
        $('faqsList').innerHTML = faqs.length
          ? faqs
              .map(
                (item, index) => `
                  <div class="builder">
                    <div class="form-row">
                      <input data-faq-index="${index}" data-field="question" value="${escapeHtml(item.question || '')}" placeholder="问题" />
                      <span></span>
                      <button class="mini-button danger" data-action="faqs:remove" data-index="${index}" type="button">删除</button>
                    </div>
                    <textarea data-faq-index="${index}" data-field="answer" placeholder="答案">${escapeHtml(item.answer || '')}</textarea>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无 FAQ</strong><small>点击添加 FAQ 新增。</small></span></div>';
      };

      const renderSpecTables = () => {
        const tables = state.formData.specTables || [];
        $('specTablesList').innerHTML = tables.length
          ? tables.map((table, tableIndex) => renderSpecTable(table, tableIndex)).join('')
          : '<div class="notice"><span><strong>暂无参数表</strong><small>点击添加参数表新增。</small></span></div>';
      };

      const renderSpecTable = (table, tableIndex) => {
        const columns = Array.isArray(table.columns) && table.columns.length ? table.columns : ['Model', 'Specification'];
        const rows = Array.isArray(table.rows) && table.rows.length ? table.rows : [['', '']];
        const headerRows = Array.isArray(table.headerRows) ? table.headerRows : [];
        table.columns = columns;
        table.rows = rows;
        table.headerRows = headerRows;

        const headerEditor = headerRows
          .map(
            (row, rowIndex) => `
              <div class="builder">
                <div class="builder-head">
                  <strong>复杂表头行 ${rowIndex + 1}</strong>
                  <div class="table-toolbar">
                    <button class="mini-button" data-action="table:header-cell:add" data-table="${tableIndex}" data-row="${rowIndex}" type="button">添加表头单元格</button>
                    <button class="mini-button danger" data-action="table:header-row:remove" data-table="${tableIndex}" data-row="${rowIndex}" type="button">删除表头行</button>
                  </div>
                </div>
                ${(row.cells || [])
                  .map(
                    (cell, cellIndex) => `
                      <div class="header-cell-editor">
                        <input data-table="${tableIndex}" data-header-row="${rowIndex}" data-header-cell="${cellIndex}" data-field="text" value="${escapeHtml(cell.text || '')}" placeholder="表头文字" />
                        <input data-table="${tableIndex}" data-header-row="${rowIndex}" data-header-cell="${cellIndex}" data-field="colspan" type="number" min="1" value="${escapeHtml(cell.colspan || 1)}" title="跨列" />
                        <input data-table="${tableIndex}" data-header-row="${rowIndex}" data-header-cell="${cellIndex}" data-field="rowspan" type="number" min="1" value="${escapeHtml(cell.rowspan || 1)}" title="跨行" />
                        <button class="mini-button danger" data-action="table:header-cell:remove" data-table="${tableIndex}" data-row="${rowIndex}" data-cell="${cellIndex}" type="button">删除</button>
                      </div>
                    `
                  )
                  .join('')}
              </div>
            `
          )
          .join('');

        return `
          <div class="table-card">
            <div class="builder-head">
              <input data-table="${tableIndex}" data-field="title" value="${escapeHtml(table.title || '')}" placeholder="表格标题，例如 Product Specifications" />
              <button class="mini-button danger" data-action="tables:remove" data-index="${tableIndex}" type="button">删除参数表</button>
            </div>
            <div class="table-toolbar">
              <button class="mini-button" data-action="table:column:add" data-table="${tableIndex}" type="button">添加列</button>
              <button class="mini-button" data-action="table:row:add" data-table="${tableIndex}" type="button">添加行</button>
              <button class="mini-button" data-action="table:header-row:add" data-table="${tableIndex}" type="button">添加复杂表头</button>
            </div>
            ${headerEditor}
            <div class="table-scroll">
              <table class="edit-table">
                <thead>
                  <tr>
                    ${columns
                      .map(
                        (column, columnIndex) => `
                          <th>
                            <input data-table="${tableIndex}" data-column="${columnIndex}" value="${escapeHtml(column)}" placeholder="列名" />
                            <button class="mini-button danger" data-action="table:column:remove" data-table="${tableIndex}" data-column="${columnIndex}" type="button">删列</button>
                          </th>
                        `
                      )
                      .join('')}
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  ${rows
                    .map(
                      (row, rowIndex) => `
                        <tr>
                          ${columns
                            .map(
                              (_, columnIndex) => `
                                <td><input data-table="${tableIndex}" data-row="${rowIndex}" data-cell="${columnIndex}" value="${escapeHtml(row[columnIndex] || '')}" placeholder="单元格" /></td>
                              `
                            )
                            .join('')}
                          <td><button class="mini-button danger" data-action="table:row:remove" data-table="${tableIndex}" data-row="${rowIndex}" type="button">删行</button></td>
                        </tr>
                      `
                    )
                    .join('')}
                </tbody>
              </table>
            </div>
          </div>
        `;
      };

      const renderProductBuilders = () => {
        renderSingleTextList('galleryList', 'galleryImages', '产品主图链接');
        renderDetailImages();
        renderSingleTextList('applicationsList', 'applications', '应用场景');
        renderSpecs();
        renderSingleTextList('highlightsList', 'highlights', '产品亮点');
        renderFaqs();
        renderSpecTables();
      };

      const setTranslationFormData = data => {
        state.translationFormData = {
          applications: cloneArray(data.applications),
          specs: cloneArray(data.specs),
          specTables: cloneArray(data.specTables),
          highlights: cloneArray(data.highlights),
          faqs: cloneArray(data.faqs),
        };
      };

      const renderTranslationSingleTextList = (id, key, placeholder) => {
        const list = state.translationFormData[key] || [];
        $(id).innerHTML = list.length
          ? list
              .map(
                (value, index) => `
                  <div class="form-row is-single">
                    <input data-list="${key}" data-index="${index}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}" />
                    <span></span>
                    <button class="mini-button danger" data-action="${key}:remove" data-index="${index}" type="button">删除</button>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无内容</strong><small>点击添加按钮新增。</small></span></div>';
      };

      const renderTranslationSpecs = () => {
        const specs = state.translationFormData.specs || [];
        $('translationSpecsList').innerHTML = specs.length
          ? specs
              .map(
                (item, index) => `
                  <div class="form-row">
                    <input data-spec-index="${index}" data-field="label" value="${escapeHtml(item.label || '')}" placeholder="参数名，例如 Flow Rate" />
                    <input data-spec-index="${index}" data-field="value" value="${escapeHtml(item.value || '')}" placeholder="参数值，例如 35 m3/h" />
                    <button class="mini-button danger" data-action="specs:remove" data-index="${index}" type="button">删除</button>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无参数</strong><small>点击添加参数新增。</small></span></div>';
      };

      const renderTranslationFaqs = () => {
        const faqs = state.translationFormData.faqs || [];
        $('translationFaqsList').innerHTML = faqs.length
          ? faqs
              .map(
                (item, index) => `
                  <div class="builder">
                    <div class="form-row">
                      <input data-faq-index="${index}" data-field="question" value="${escapeHtml(item.question || '')}" placeholder="问题" />
                      <span></span>
                      <button class="mini-button danger" data-action="faqs:remove" data-index="${index}" type="button">删除</button>
                    </div>
                    <textarea data-faq-index="${index}" data-field="answer" placeholder="答案">${escapeHtml(item.answer || '')}</textarea>
                  </div>
                `
              )
              .join('')
          : '<div class="notice"><span><strong>暂无 FAQ</strong><small>点击添加 FAQ 新增。</small></span></div>';
      };

      const renderTranslationSpecTables = () => {
        const tables = state.translationFormData.specTables || [];
        $('translationSpecTablesList').innerHTML = tables.length
          ? tables.map((table, tableIndex) => renderSpecTable(table, tableIndex)).join('')
          : '<div class="notice"><span><strong>暂无参数表</strong><small>点击添加参数表新增。</small></span></div>';
      };

      const renderTranslationProductBuilders = () => {
        renderTranslationSingleTextList('translationApplicationsList', 'applications', '应用场景');
        renderTranslationSpecs();
        renderTranslationSingleTextList('translationHighlightsList', 'highlights', '产品亮点');
        renderTranslationFaqs();
        renderTranslationSpecTables();
      };

      const showProductBrowser = () => {
        $('productBrowserView').classList.add('is-visible');
        $('productEditorView').classList.remove('is-visible');
      };

      const showProductEditor = () => {
        $('productBrowserView').classList.remove('is-visible');
        $('productEditorView').classList.add('is-visible');
      };

      const selectProduct = slug => {
        const product = state.products.find(item => item.slug === slug);
        if (!product) return;
        state.activeSlug = slug;
        state.activeDraftId = '';
        state.isNewProduct = false;
        $('title').value = product.title || '';
        $('productSlug').value = product.slug || '';
        $('productSlug').readOnly = true;
        $('offeringType').value = product.offeringType || 'physical-product';
        $('modelStrategy').value = product.modelStrategy || 'series';
        $('category').value = product.category || '';
        $('series').value = product.series || '';
        $('sortOrder').value = product.sortOrder || 9999;
        $('published').checked = product.published !== false;
        $('featured').checked = product.featured === true;
        $('image').value = product.image || '';
        updateImageFieldPreview('image');
        $('description').value = product.description || '';
        setRichTextValue('productContent', product.content || '');
        setFormData(product);
        renderProductBuilders();
        renderProducts();
        renderDrafts();
        showProductEditor();
        setStatus('statusText', `正在编辑：${product.title}`);
      };

      const startNewProduct = () => {
        state.activeSlug = '';
        state.activeDraftId = '';
        state.isNewProduct = true;
        $('title').value = '';
        $('productSlug').value = '';
        $('productSlug').readOnly = false;
        $('offeringType').value = 'physical-product';
        $('modelStrategy').value = 'series';
        $('category').value = state.categories[0] || '';
        $('series').value = '';
        $('sortOrder').value = 9999;
        $('published').checked = false;
        $('featured').checked = false;
        $('image').value = '';
        updateImageFieldPreview('image');
        $('description').value = '';
        setRichTextValue('productContent', '');
        state.formData = {
          galleryImages: [],
          detailImages: [],
          applications: [''],
          specs: [{ label: '', value: '' }],
          specTables: [
            {
              title: 'Product Specifications',
              columns: ['Model', 'Specification'],
              headerRows: [],
              rows: [['', '']],
            },
          ],
          highlights: [''],
          faqs: [],
        };
        renderProductBuilders();
        renderProducts();
        renderDrafts();
        showProductEditor();
        setStatus('statusText', '正在新建产品草稿。Slug 保存后将用于生成产品文件。');
      };

      const renderDrafts = () => {
        const drafts = state.activeSlug
          ? state.drafts.filter(draft => draft.productSlug === state.activeSlug)
          : state.drafts.slice(0, 10);
        $('draftList').innerHTML = drafts.length
          ? drafts
              .map(
                draft => `
                  <div class="draft">
                    <span>
                      <strong>${escapeHtml(draft.productTitle)}</strong>
                      <small>${escapeHtml(draft.status)} · ${formatDate(draft.updatedAt)}</small>
                    </span>
                    <button class="button secondary" data-apply="${escapeHtml(draft.id)}" type="button">应用到网站内容</button>
                  </div>
                `
              )
              .join('')
          : '<div class="draft"><span><strong>暂无草稿</strong><small>保存草稿后会显示在这里。</small></span></div>';
      };

      const loadProducts = async () => {
        const data = await requestJson('/api/manager/products');
        state.products = data.products || [];
        state.categories = data.categories || [];
        $('managerEmail').textContent = data.manager?.email || '已连接';
        fillCategoryOptions();
        renderProducts();
        renderProductOrder();
      };

      const loadDrafts = async () => {
        const data = await requestJson('/api/manager/product-drafts');
        state.drafts = data.drafts || [];
        renderDrafts();
      };

      const loadDraftsSafely = async () => {
        try {
          await loadDrafts();
        } catch (error) {
          state.drafts = [];
          renderDrafts();
          setStatus('statusText', error.message || '草稿暂时无法加载，请联系站长检查后台配置。', true);
        }
      };

      const loadBlogPosts = async () => {
        setStatus('blogStatus', '正在加载文章...');
        const data = await requestJson('/api/manager/blog');
        state.blogPosts = data.posts || [];
        renderBlogPosts();
      };

      const loadBlogDrafts = async () => {
        const data = await requestJson('/api/manager/blog-drafts');
        state.blogDrafts = data.drafts || [];
        renderBlogWorkDrafts();
      };

      const loadBlogDraftsSafely = async () => {
        try {
          await loadBlogDrafts();
        } catch (error) {
          state.blogDrafts = [];
          renderBlogWorkDrafts();
          setStatus('blogStatus', error.message || '文章草稿暂时无法加载，请联系站长检查后台配置。', true);
        }
      };

      const reviewPayloadFromForm = (operation = 'upsert') => ({
        operation,
        id: $('reviewId').value.trim().toLowerCase(),
        published: $('reviewPublished').checked,
        kind: $('reviewKind').value,
        rating: $('reviewRating').value,
        quote: $('reviewQuote').value.trim(),
        buyerLabel: $('reviewBuyerLabel').value.trim(),
        country: $('reviewCountry').value.trim(),
        date: $('reviewDate').value,
        projectType: $('reviewProjectType').value.trim(),
        source: $('reviewSource').value.trim(),
        sourceUrl: $('reviewSourceUrl').value.trim(),
        productSlugs: $('reviewProductSlugs').value.split(/\r?\n|,/).map(value => value.trim()).filter(Boolean),
        seoEligible: $('reviewSeoEligible').checked,
      });

      const fillReviewForm = review => {
        const item = review || {};
        state.activeReviewId = item.id || '';
        state.activeReviewDraftId = item.draftId || '';
        $('reviewId').value = item.id || '';
        $('reviewId').readOnly = Boolean(item.id && !item.draftId);
        $('reviewBuyerLabel').value = item.buyerLabel || '';
        $('reviewKind').value = item.kind === 'demo' ? 'demo' : 'verified';
        $('reviewRating').value = String(item.rating) === '4' ? '4' : '5';
        $('reviewQuote').value = item.quote || '';
        $('reviewDate').value = item.date || '';
        $('reviewCountry').value = item.country || '';
        $('reviewProjectType').value = item.projectType || '';
        $('reviewSource').value = item.source || 'Alibaba.com';
        $('reviewSourceUrl').value = item.sourceUrl || '';
        $('reviewProductSlugs').value = (item.productSlugs || []).join('\n');
        $('reviewPublished').checked = item.published !== false;
        $('reviewSeoEligible').checked = item.seoEligible === true;
        setStatus('reviewStatus', item.id ? `正在编辑：${item.id}` : '正在新建评价草稿。');
      };

      const renderReviews = () => {
        $('reviewList').innerHTML = state.reviews.length
          ? state.reviews.map(review => `
              <button class="blog-row" data-review-id="${escapeHtml(review.id)}" type="button">
                <span><strong>${escapeHtml(review.buyerLabel || review.id)}</strong><small>${escapeHtml(review.projectType || review.source || '')}</small></span>
                <span class="status">${review.kind === 'demo' ? '演示' : '已核实'} · ${review.published === false ? '隐藏' : `${review.rating} 星`}</span>
              </button>`).join('')
          : '<div class="draft"><span><strong>暂无正式评价</strong><small>可以新建评价草稿。</small></span></div>';
        $('reviewListStatus').textContent = `共 ${state.reviews.length} 条正式评价`;
      };

      const renderReviewDrafts = () => {
        $('reviewDraftList').innerHTML = state.reviewDrafts.length
          ? state.reviewDrafts.map(draft => `
              <div class="draft">
                <span><strong>${escapeHtml(draft.buyerLabel || draft.reviewId)}</strong><small>${escapeHtml(draft.status)} · ${formatDate(draft.updatedAt)}</small></span>
                <button class="button secondary" data-review-draft-edit="${escapeHtml(draft.id)}" type="button">编辑</button>
                <button class="button secondary" data-review-draft-apply="${escapeHtml(draft.id)}" type="button">应用到网站</button>
              </div>`).join('')
          : '<div class="draft"><span><strong>暂无评价草稿</strong><small>保存后会显示在这里。</small></span></div>';
      };

      const loadReviews = async () => {
        const data = await requestJson('/api/manager/review-drafts');
        state.reviews = data.reviews || [];
        state.reviewDrafts = data.drafts || [];
        $('reviewSystemStatus').textContent = `评价系统总开关：${data.settings?.enabled ? '已启用' : '已关闭'}（仅站长可在 Keystatic 修改）`;
        renderReviews();
        renderReviewDrafts();
      };

      const saveReviewDraft = async operation => {
        const payload = reviewPayloadFromForm(operation);
        if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(payload.id)) {
          setStatus('reviewStatus', '唯一 ID 只能使用小写英文、数字和短横线。', true);
          return;
        }
        setStatus('reviewStatus', operation === 'delete' ? '正在生成删除草稿...' : '正在保存评价草稿...');
        const data = await requestJson('/api/manager/review-drafts', {
          method: 'POST',
          body: JSON.stringify({ id: state.activeReviewDraftId, payload }),
        });
        state.activeReviewDraftId = data.draft?.id || '';
        await loadReviews();
        setStatus('reviewStatus', operation === 'delete' ? '删除草稿已保存，尚未删除正式数据。' : '评价草稿已保存。');
      };

      const applyReviewDraft = async id => {
        setStatus('reviewStatus', '正在提交评价内容更新...');
        const data = await requestJson(`/api/manager/review-drafts/${encodeURIComponent(id)}/apply`, { method: 'POST' });
        await loadReviews();
        setStatus('reviewStatus', data.requestId ? '评价更新已提交到网站工作流。' : '评价更新已提交。');
      };

      const bootstrapManager = async () => {
        await loadProducts();
        await loadDraftsSafely();
        if (new URLSearchParams(window.location.search).get('section') === 'reviews') activateTab('reviews');
      };

      const productToPayload = (product, sortOrder = product.sortOrder) => ({
        productSlug: product.slug,
        title: product.title,
        description: product.description,
        category: product.category,
        series: product.series,
        sortOrder: Number(sortOrder || product.sortOrder || 9999),
        published: product.published !== false,
        image: product.image || '',
        featured: product.featured === true,
        galleryImages: product.galleryImages || [],
        detailImages: product.detailImages || [],
        applications: product.applications || [],
        specs: product.specs || [],
        specTables: product.specTables || [],
        highlights: product.highlights || [],
        faqs: product.faqs || [],
        content: product.content || '',
      });

      const saveOrderDrafts = async () => {
        const changes = [...state.orderChanges.entries()]
          .map(([slug, sortOrder]) => {
            const product = state.products.find(item => item.slug === slug);
            return product ? { product, sortOrder } : null;
          })
          .filter(Boolean);

        if (!changes.length) {
          setStatus('orderStatus', '还没有修改产品权重。', true);
          return;
        }

        setStatus('orderStatus', `正在保存 ${changes.length} 个排序草稿...`);
        for (const item of changes) {
          await requestJson('/api/manager/product-drafts', {
            method: 'POST',
            body: JSON.stringify({ payload: productToPayload(item.product, item.sortOrder) }),
          });
        }
        state.orderChanges.clear();
        await loadDrafts();
        renderProductOrder();
        setStatus('orderStatus', '排序草稿已保存，请在产品内容页检查后应用到网站内容。');
      };

