      html[data-theme='dark'] .tab,
      html[data-theme='dark'] .theme-switch__trigger,
      html[data-theme='dark'] .theme-switch__chevron,
      html[data-theme='dark'] .theme-switch__menu button,
      html[data-theme='dark'] .connection-copy strong,
      html[data-theme='dark'] .connection-copy span,
      html[data-theme='dark'] .panel-head span,
      html[data-theme='dark'] .product-manager-header p,
      html[data-theme='dark'] .product-manager-toolbar label span,
      html[data-theme='dark'] .product-manager-meta span,
      html[data-theme='dark'] .field label,
      html[data-theme='dark'] .field-help,
      html[data-theme='dark'] .status,
      html[data-theme='dark'] .path,
      html[data-theme='dark'] .blog-list-title,
      html[data-theme='dark'] .blog-list-date,
      html[data-theme='dark'] .blog-list-category,
      html[data-theme='dark'] .blog-list-view,
      html[data-theme='dark'] .manager-product-head,
      html[data-theme='dark'] .manager-product-series,
      html[data-theme='dark'] .manager-product-category,
      html[data-theme='dark'] .draft small,
      html[data-theme='dark'] .record small,
      html[data-theme='dark'] .notice small,
      html[data-theme='dark'] .translation-result-columns ul,
      html[data-theme='dark'] .translation-result-empty,
      html[data-theme='dark'] .order-card small,
      html[data-theme='dark'] .asset-name,
      html[data-theme='dark'] .asset-meta,
      html[data-theme='dark'] .image-picker-card strong,
      html[data-theme='dark'] .image-picker-card small,
      html[data-theme='dark'] .translation-guide,
      html[data-theme='dark'] .locale-bulk-controls label,
      html[data-theme='dark'] .locale-grid label,
      html[data-theme='dark'] .translation-editor-form label {
        color: var(--muted);
      }

      html[data-theme='dark'] .panel-head h2,
      html[data-theme='dark'] .product-manager-header h2 {
        color: var(--accent);
      }

      html[data-theme='dark'] .translation-guide strong,
      html[data-theme='dark'] .status.is-error {
        color: var(--text-strong);
      }

      html[data-theme='dark'] .status.is-error {
        color: var(--danger);
      }

      html[data-theme='dark'] code,
      html[data-theme='dark'] .rich-editor__surface code {
        color: #d4d4d8;
      }

      html[data-theme='dark'] .rich-editor__surface pre {
        border-color: #3f3f46;
        color: #f8fafc;
        background: #18181b;
      }

      .locale-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 8px;
      }

      .locale-head {
        display: flex;
        gap: 12px;
        align-items: center;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: thin;
      }

      .locale-head > label {
        flex: 0 0 auto;
      }

      .locale-bulk-controls {
        display: inline-flex;
        flex: 0 0 auto;
        gap: 8px;
        align-items: center;
        white-space: nowrap;
      }

      .locale-bulk-controls label {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        min-height: 30px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: #344054;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
      }

      .locale-bulk-controls input {
        margin: 0;
      }

      .translation-guide {
        margin: 14px 16px 0;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
      }

      .translation-guide strong {
        display: block;
        margin-bottom: 8px;
        color: var(--text-strong);
        font-size: 13px;
      }

      .translation-guide ol {
        display: grid;
        gap: 5px;
        margin: 0;
        padding-left: 20px;
      }

      .translation-guide li {
        padding-left: 2px;
      }

      .locale-grid label {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 10px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: #344054;
        font-size: 13px;
        font-weight: 650;
      }

      .record label,
      .draft label {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        min-width: 0;
      }

      .record input[type='checkbox'],
      .draft input[type='checkbox'] {
        margin-top: 3px;
      }

      @media (max-width: 980px) {
        .shell {
          width: 100%;
          padding: 0;
        }

        .admin-layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
          min-height: auto;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .theme-switch {
          margin-top: 0;
        }

        .tabs {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          align-items: start;
        }

        .content-area {
          padding: 18px 14px 28px;
        }

        .hero,
        .grid,
        .dual-grid,
        .form,
        .translation-result-columns {
          grid-template-columns: 1fr;
        }

        .hero {
          padding: 0 0 14px;
        }

        .connection-panel {
          grid-template-columns: 1fr;
        }

        .product-manager-header,
        .product-manager-toolbar {
          grid-template-columns: 1fr;
        }

        .product-manager-side {
          align-items: stretch;
        }

        .product-manager-summary {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .product-manager-side .button {
          width: 100%;
        }

        .product-list,
        .asset-grid,
        .content-card-grid,
        .blog-list {
          max-height: 460px;
          min-height: 360px;
        }

        .blog-list-head {
          display: none;
        }

        .blog-list-row {
          grid-template-columns: 1fr;
          gap: 7px;
          padding: 12px;
        }

        .blog-list-category,
        .blog-list-view {
          justify-self: start;
        }

        .manager-product-list {
          max-height: 540px;
          min-height: 360px;
        }

        .manager-product-head {
          display: none;
        }

        .manager-product-row {
          grid-template-columns: 96px minmax(0, 1fr);
          gap: 10px;
          padding: 10px;
        }

        .manager-product-category,
        .manager-product-actions {
          grid-column: 2;
        }

        .manager-product-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-start;
        }

        .image-picker-overlay {
          padding: 10px;
        }

        .image-picker-dialog {
          width: calc(100vw - 20px);
          height: calc(100vh - 20px);
        }

        .image-picker-grid {
          grid-template-columns: repeat(auto-fill, minmax(142px, 142px));
          padding: 10px;
        }

        .form-row.has-picker,
        .form-row.has-picker.is-single {
          grid-template-columns: 1fr;
        }

        .input-action.has-preview,
        .input-action.image-field-control {
          grid-template-columns: minmax(0, 1fr) 64px;
        }

        .input-action.image-field-control > .button {
          grid-column: 1 / -1;
        }

        .field-image-preview {
          width: 64px;
          height: 64px;
        }

        .toolbar.is-row.order-toolbar {
          grid-template-columns: 1fr;
        }

        .translation-editor-body {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <div class="admin-layout">
        <aside class="sidebar">
          <div class="brand-mark">
            <a href="/" aria-label="Open BusinessWeb home page">
              <strong>BusinessWeb</strong>
              <span>内容管理</span>
            </a>
          </div>
          <section class="connection-panel" id="connectionPanel" hidden>
            <div class="connection-copy">
              <strong id="connectionTitle"></strong>
              <span id="connectionDetail"></span>
            </div>
          </section>
          <div class="theme-switch" aria-label="显示模式">
            <button class="theme-switch__trigger" id="themeMenuButton" type="button" aria-haspopup="menu" aria-expanded="false">
              <span id="themeMenuLabel">跟随系统</span>
              <span class="theme-switch__chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="theme-switch__menu" id="themeMenu" role="menu" hidden>
              <button data-theme-option="light" type="button" role="menuitem">浅色</button>
              <button data-theme-option="dark" type="button" role="menuitem">深色</button>
              <button data-theme-option="system" type="button" role="menuitem">跟随系统</button>
            </div>
          </div>
          <div class="user-pill" id="managerEmail" hidden></div>
          <nav class="tabs" aria-label="Manager sections">
            <div class="nav-group">
              <span class="nav-group-label">内容</span>
              <button class="tab is-active" data-tab="products" type="button">产品管理</button>
              <button class="tab" data-tab="product-order" type="button">产品排序</button>
              <button class="tab" data-tab="blog" type="button">博客</button>
              <button class="tab" data-tab="reviews" type="button">客户评价</button>
              <button class="tab" data-tab="translation" type="button">AI 翻译助手</button>
              <button class="tab" data-tab="product-drafts" type="button">产品翻译草稿</button>
              <button class="tab" data-tab="blog-drafts" type="button">文章翻译草稿</button>
              <button class="tab" data-tab="publish" type="button">发布网站更新</button>
            </div>
            <div class="nav-group">
              <span class="nav-group-label">媒体</span>
              <button class="tab" data-tab="images" type="button">图片池</button>
            </div>
            <div class="nav-group">
              <span class="nav-group-label">数据</span>
              <a class="tab tab-link" id="managerAnalyticsLink" href="#">网站访问分析</a>
            </div>
          </nav>
        </aside>

        <div class="content-area">
      <section class="section" data-panel="product-order">
        <section class="panel">
          <div class="panel-head">
            <div class="order-panel-copy">
              <h2>产品排序</h2>
              <div class="order-panel-meta">
                <span>按产品分类筛选后直接修改权重。数字越小，前台越靠前。</span>
                <span class="status" id="orderStatus">排序列表未加载。</span>
              </div>
            </div>
            <button class="button" id="orderSaveButton" type="button">保存排序草稿</button>
          </div>
          <div class="toolbar is-row order-toolbar">
            <input id="orderSearchInput" type="search" placeholder="搜索产品名称或系列" />
            <select id="orderCategoryFilter">
              <option value="">所有分类</option>
            </select>
          </div>
          <div class="order-grid" id="orderGrid"></div>
        </section>
      </section>

      <section class="section is-active" data-panel="products">
        <div class="grid">
          <aside class="panel manager-view is-visible" id="productBrowserView">
            <header class="product-manager-header">
              <div>
                <h2>产品内容工作台</h2>
                <p>按分类和关键词快速找到产品；点击产品图或产品名称进入编辑，操作列只处理预览和上线状态。</p>
              </div>
              <div class="product-manager-side">
                <div class="product-manager-summary" aria-label="产品状态概览">
                  <span><strong id="productTotalCount">0</strong><small>全部产品</small></span>
                  <span><strong id="productOnlineCount">0</strong><small>已上线</small></span>
                  <span><strong id="productOfflineCount">0</strong><small>已下线</small></span>
                </div>
                <button class="button secondary" id="newProductButton" type="button">新建产品草稿</button>
              </div>
            </header>
            <div class="product-manager-toolbar">
              <label>
                <span>产品分类</span>
                <select id="categoryFilter">
                  <option value="">所有分类</option>
                </select>
              </label>
              <label>
                <span>产品名称关键词</span>
                <input id="searchInput" type="search" placeholder="输入产品名称或系列" />
              </label>
            </div>
            <div class="product-manager-meta">
              <strong id="productCategoryMeta">全部分类</strong>
              <span id="productBrowserStatus">正在加载产品...</span>
            </div>
            <div class="manager-product-list" id="productList"></div>
            <div class="product-manager-pager" id="productPagination" aria-label="产品分页"></div>
          </aside>

          <section class="panel manager-view" id="productEditorView">
            <div class="panel-head">
              <div>
                <h2>产品草稿</h2>
                <span>支持产品基础字段、主图、关键参数和详情页表格。</span>
              </div>
              <button class="button secondary" id="productBackButton" type="button">返回产品列表</button>
            </div>

            <form class="form" id="productForm">
              <div class="field">
                <label for="title">产品名称</label>
                <input id="title" name="title" required />
              </div>
              <div class="field">
                <label for="productSlug">页面地址 Slug</label>
                <input id="productSlug" name="productSlug" readonly />
              </div>
              <div class="field">
                <label for="offeringType">内容类型</label>
                <select id="offeringType" name="offeringType">
                  <option value="physical-product">实体产品（Product / ProductGroup）</option>
                  <option value="service">服务（Service）</option>
                  <option value="solution">工程解决方案（Service）</option>
                </select>
              </div>
              <div class="field">
                <label for="modelStrategy">型号结构</label>
                <select id="modelStrategy" name="modelStrategy">
                  <option value="single-model">单个可售型号</option>
                  <option value="series">系列产品 / 多型号参数表</option>
                  <option value="configurable">按项目或配置下单</option>
                  <option value="not-applicable">服务不适用型号</option>
                </select>
              </div>
              <div class="field">
                <label for="category">产品分类</label>
                <select id="category" name="category"></select>
              </div>
              <div class="field">
                <label for="series">系列 / 型号</label>
                <input id="series" name="series" required />
              </div>
              <div class="field">
                <label for="sortOrder">权重</label>
                <input id="sortOrder" name="sortOrder" type="number" min="1" step="1" required />
              </div>
              <div class="field">
                <label>前台上线</label>
                <span class="toggle">
                  <input id="published" name="published" type="checkbox" />
                  <span>显示该产品</span>
                </span>
              </div>
              <div class="field is-wide">
                <label for="image">产品主图 URL（首张）</label>
                <div class="input-action">
                  <input id="image" name="image" placeholder="可从图片池选择或粘贴图片链接" />
                  <button class="button secondary" data-image-field="image" data-image-title="选择产品主图" type="button">选择图片</button>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>产品主图组 / 轮播主图</strong>
                    <button class="mini-button" data-action="gallery:add" type="button">添加主图</button>
                  </div>
                  <p class="field-help">首张产品图会作为产品缩略图；这里可继续添加多个主图，用于产品详情页顶部轮播。</p>
                  <div class="builder-list" id="galleryList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <label for="description">简短描述</label>
                <textarea id="description" name="description" required></textarea>
              </div>
              <div class="field is-wide">
                <label for="productContent">详细内容</label>
                <textarea id="productContent" name="productContent" style="min-height: 420px;" placeholder="这里对应产品详情页的详细内容正文。可以粘贴图片池链接或 Markdoc 内容。"></textarea>
              </div>
              <div class="field is-wide">
                <label>首页推荐</label>
                <span class="toggle">
                  <input id="featured" name="featured" type="checkbox" />
                  <span>推荐显示在重点产品区域</span>
                </span>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>详情页宣传图 / 特性说明图</strong>
                    <button class="mini-button" data-action="detail:add" type="button">添加详情图</button>
                  </div>
                  <p class="field-help">用于产品详情页正文展示工艺、卖点、结构或应用场景。</p>
                  <div class="builder-list" id="detailImageList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>应用场景</strong>
                    <button class="mini-button" data-action="applications:add" type="button">添加应用场景</button>
                  </div>
                  <div class="builder-list" id="applicationsList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>关键产品参数</strong>
                    <button class="mini-button" data-action="specs:add" type="button">添加参数</button>
                  </div>
                  <p class="field-help">例如 Flow Rate、Filter Area、Valve Connection。单位和型号不要随意改写。</p>
                  <div class="builder-list" id="specsList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>产品亮点</strong>
                    <button class="mini-button" data-action="highlights:add" type="button">添加亮点</button>
                  </div>
                  <div class="builder-list" id="highlightsList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>常见问题</strong>
                    <button class="mini-button" data-action="faqs:add" type="button">添加 FAQ</button>
                  </div>
                  <div class="builder-list" id="faqsList"></div>
                </div>
              </div>
              <div class="field is-wide">
                <div class="builder">
                  <div class="builder-head">
                    <strong>型号参数表</strong>
                    <button class="mini-button" data-action="tables:add" type="button">添加参数表</button>
                  </div>
                  <p class="field-help">支持多表头、跨行、跨列、公制和英制单位。管理员只填表格内容，不需要写代码。</p>
                  <div class="builder-list" id="specTablesList"></div>
                </div>
              </div>
            </form>

            <div class="actions">
              <button class="button" id="saveDraftButton" type="button">保存草稿</button>
              <button class="button secondary" id="reloadButton" type="button">刷新草稿</button>
              <span class="status" id="statusText">请选择一个产品。</span>
            </div>

            <div class="drafts" id="draftList"></div>
          </section>
        </div>
      </section>

      <section class="section" data-panel="blog">
        <div class="grid">
          <aside class="panel manager-view is-visible" id="blogBrowserView">
            <div class="panel-head">
              <div>
                <h2>博客</h2>
                <span id="blogCount">加载中</span>
              </div>
              <button class="button secondary" id="newBlogButton" type="button">新建文章草稿</button>
            </div>
            <div class="toolbar is-row">
              <input id="blogSearchInput" type="search" placeholder="搜索文章标题或分类" />
              <button class="button secondary" id="blogRefreshButton" type="button">刷新文章</button>
            </div>
            <div class="blog-list" id="blogList"></div>
          </aside>

          <section class="panel manager-view" id="blogEditorView">
            <div class="panel-head">
              <div>
                <h2>文章草稿</h2>
                <span>支持文章标题、封面、摘要、分类、发布日期和正文。</span>
              </div>
              <button class="button secondary" id="blogBackButton" type="button">返回博客列表</button>
            </div>
            <form class="form" id="blogForm">
              <div class="field">
                <label for="blogTitle">文章标题</label>
                <input id="blogTitle" required />
              </div>
              <div class="field">
                <label for="blogSlug">页面地址 Slug</label>
                <input id="blogSlug" readonly />
              </div>
              <div class="field">
                <label for="blogCategory">文章分类</label>
                <input id="blogCategory" required />
              </div>
              <div class="field">
                <label for="blogPublishDate">发布时间</label>
                <input id="blogPublishDate" type="datetime-local" required />
              </div>
              <div class="field">
                <label for="blogAuthor">作者</label>
                <input id="blogAuthor" />
              </div>
              <div class="field">
                <label>首页推荐</label>
                <span class="toggle">
                  <input id="blogFeatured" type="checkbox" />
                  <span>推荐显示该文章</span>
                </span>
              </div>
              <div class="field is-wide">
                <label for="blogImage">文章封面 URL</label>
                <div class="input-action">
                  <input id="blogImage" placeholder="可从图片池选择或粘贴图片链接" />
                  <button class="button secondary" data-image-field="blogImage" data-image-title="选择文章封面" type="button">选择图片</button>
                </div>
              </div>
              <div class="field is-wide">
                <label for="blogDescription">文章摘要</label>
                <textarea id="blogDescription" required></textarea>
              </div>
              <div class="field is-wide">
                <label for="blogBody">文章正文</label>
                <textarea id="blogBody" required style="min-height: 420px;"></textarea>
              </div>
            </form>
            <div class="actions">
              <button class="button" id="saveBlogDraftButton" type="button">保存文章草稿</button>
              <button class="button secondary" id="reloadBlogDraftButton" type="button">刷新草稿</button>
              <a class="button secondary" id="viewBlogButton" href="#" target="_blank" rel="noreferrer">前端查看</a>
              <span class="status" id="blogStatus">请选择一篇文章。</span>
            </div>
            <div class="drafts" id="blogDraftWorkList"></div>
          </section>
        </div>
      </section>

      <section class="section" data-panel="reviews">
        <div class="grid">
          <aside class="panel">
            <div class="panel-head">
              <div>
                <h2>客户评价</h2>
                <span id="reviewSystemStatus">站长在 Keystatic 控制评价系统总开关。</span>
              </div>
              <button class="button secondary" id="newReviewButton" type="button">新建评价草稿</button>
