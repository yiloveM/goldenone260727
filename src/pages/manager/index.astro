    <script is:inline define:vars={{ publicR2AssetBaseUrl }}>
      // @ts-nocheck
      const state = {
        products: [],
        blogPosts: [],
        categories: [],
        drafts: [],
        blogDrafts: [],
        reviews: [],
        reviewDrafts: [],
        activeReviewId: '',
        activeReviewDraftId: '',
        orderChanges: new Map(),
        productPage: 1,
        activeSlug: '',
        activeDraftId: '',
        isNewProduct: false,
        activeBlogSlug: '',
        activeBlogDraftId: '',
        isNewBlog: false,
        assetPrefix: '',
        assetFiles: [],
        assetFolders: [],
        selectedAssetKeys: new Set(),
        cutAssetKeys: [],
        translationRequestId: '',
        translationTimer: null,
        translationDraftSyncKey: '',
        translationLastSourceType: 'all',
        publishRequestId: '',
        publishTimer: null,
        publishRecords: [],
        translationDrafts: [],
        imagePicker: {
          fieldId: '',
          listKey: '',
          richEditorId: '',
          detailIndex: null,
          prefix: '',
          files: [],
          folders: [],
        },
        previewImage: {
          url: '',
          name: '',
          key: '',
          canSelect: false,
          statusId: 'assetStatus',
        },
        translationEditor: {
          type: '',
          draftSlug: '',
          draft: null,
          returnTab: 'product-drafts',
        },
        translationFormData: {
          applications: [],
          specs: [],
          specTables: [],
          highlights: [],
          faqs: [],
        },
        richEditorSelection: null,
        themeChoice: localStorage.getItem('businessweb-manager-theme') || 'system',
        formData: {
          galleryImages: [],
          detailImages: [],
          applications: [],
          specs: [],
          specTables: [],
          highlights: [],
          faqs: [],
        },
      };

      const locales = [];
      const productPageSize = 12;

      const $ = id => document.getElementById(id);
      const analyticsLink = $('managerAnalyticsLink');
      if (analyticsLink) analyticsLink.href = `${window.location.pathname.replace(/\/+$/, '')}/analytics`;
      const escapeHtml = value =>
        String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      const normalizeThumbnailUrl = value => {
        const raw = String(value ?? '').trim();
        if (!raw) return '';
        if (/^(https?:|data:|blob:|\/)/i.test(raw)) return raw;
        if (/^r2\//i.test(raw)) return `/${raw.replace(/^\/+/, '')}`;
        return `${publicR2AssetBaseUrl}/${raw.replace(/^\/+/, '').replace(/ /g, '%20')}`;
      };
      const thumbnailMarkup = (value, alt = '') => {
        const src = normalizeThumbnailUrl(value);
        if (!src) return '<span class="thumb-frame thumb-frame--empty" aria-hidden="true"></span>';
        return `<span class="thumb-frame"><img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}" loading="lazy" decoding="async" /></span>`;
      };
      const richEditors = new Map();
      const richEditorBlocks = [
        ['P', 'Paragraph'],
        ['H2', 'Heading 2'],
        ['H3', 'Heading 3'],
        ['H4', 'Heading 4'],
        ['BLOCKQUOTE', 'Quote'],
      ];
      const parseMarkdocImageAttrs = value => {
        const attrs = {};
        String(value || '').replace(/([A-Za-z0-9_-]+)="([^"]*)"/g, (_, key, attrValue) => {
          attrs[key] = attrValue;
          return '';
        });
        return attrs;
      };
      const renderRichInline = value =>
        escapeHtml(value)
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>')
          .replace(/`([^`]+)`/g, '<code>$1</code>');
      const richImageHtml = ({ src = '', alt = '', caption = '' }) => `
        <figure data-rich-type="image">
          <img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}" loading="lazy" decoding="async" />
          <figcaption>${escapeHtml(caption || alt || '')}</figcaption>
        </figure>
      `;
      const markdownToRichHtml = value => {
        const lines = String(value || '').replace(/\r\n/g, '\n').split('\n');
        const output = [];
        let paragraph = [];
        let list = [];
        let orderedList = [];
        let table = [];
        let codeBlock = null;

        const flushParagraph = () => {
          const text = paragraph.join(' ').trim();
          if (text) output.push(`<p>${renderRichInline(text)}</p>`);
          paragraph = [];
        };
        const flushList = () => {
          if (list.length) output.push(`<ul>${list.map(item => `<li>${renderRichInline(item)}</li>`).join('')}</ul>`);
          list = [];
        };
        const flushOrderedList = () => {
          if (orderedList.length) output.push(`<ol>${orderedList.map(item => `<li>${renderRichInline(item)}</li>`).join('')}</ol>`);
          orderedList = [];
        };
        const flushTable = () => {
          const rows = table
            .filter(line => !/^\|\s*:?-{2,}/.test(line.trim()))
            .map(line => line.trim().replace(/^\||\|$/g, '').split('|').map(cell => cell.trim()));
          if (rows.length) {
            const [head, ...body] = rows;
            output.push(`<table><thead><tr>${head.map(cell => `<th>${renderRichInline(cell)}</th>`).join('')}</tr></thead><tbody>${body
              .map(row => `<tr>${row.map(cell => `<td>${renderRichInline(cell)}</td>`).join('')}</tr>`)
              .join('')}</tbody></table>`);
          }
          table = [];
        };
        const flushCodeBlock = () => {
          if (!codeBlock) return;
          output.push(`<pre><code>${escapeHtml(codeBlock.lines.join('\n'))}</code></pre>`);
          codeBlock = null;
        };
        const flushAll = () => {
          flushParagraph();
          flushList();
          flushOrderedList();
          flushTable();
        };

        for (const rawLine of lines) {
          const fence = rawLine.match(/^(`{3,})\s*([A-Za-z0-9_-]*)\s*$/);
          if (codeBlock) {
            if (fence && fence[1].length >= codeBlock.fence.length) flushCodeBlock();
            else codeBlock.lines.push(rawLine);
            continue;
          }
          if (fence) {
            flushAll();
            codeBlock = { fence: fence[1], language: fence[2] || '', lines: [] };
            continue;
          }

          const line = rawLine.trim();
          if (!line) {
            flushAll();
            continue;
          }

