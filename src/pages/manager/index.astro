      $('imagePreviewCloseButton').addEventListener('click', closeImagePreview);
      $('imagePreview').addEventListener('click', event => {
        if (event.target === $('imagePreview')) closeImagePreview();
      });
      $('imagePreviewUseButton').addEventListener('click', () => {
        if (!state.previewImage.url) return;
        pickImage(state.previewImage.url);
        closeImagePreview();
      });
      $('imagePreviewCopyButton').addEventListener('click', () => {
        if (state.previewImage.url) copyText(state.previewImage.url, state.previewImage.statusId || 'assetStatus', $('imagePreviewCopyButton'));
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        setThemeMenuOpen(false);
        if ($('imagePreview').classList.contains('is-open')) {
          closeImagePreview();
          return;
        }
        if ($('translationEditor').classList.contains('is-active')) {
          closeTranslationEditor();
          return;
        }
        if ($('imagePicker').classList.contains('is-open')) closeImagePicker();
      });
      $('translationSubmitButton').addEventListener('click', () => submitTranslation().catch(error => setStatus('translationStatus', error.message, true)));
      $('translationStatusButton').addEventListener('click', () => pollTranslationStatus().catch(error => setStatus('translationStatus', error.message, true)));
      $('translationLocaleSelectAll').addEventListener('change', event => setAllLocales(event.target.checked));
      $('translationLocaleInvert').addEventListener('change', invertLocales);
      $('localeGrid').addEventListener('change', event => {
        if (event.target.matches('input[type="checkbox"]')) syncLocaleBulkControls();
