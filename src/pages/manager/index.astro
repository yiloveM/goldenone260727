          previewLink.dataset.previewStatus || 'translationEditorStatus'
        );
      });
      $('productDraftRefreshButton').addEventListener('click', () => loadTranslationDrafts('product').catch(error => setStatus('productDraftStatus', error.message, true)));
      $('productDraftApproveButton').addEventListener('click', () => approveTranslationDrafts('product').catch(error => setStatus('productDraftStatus', error.message, true)));
      $('productDraftIncludePublished').addEventListener('change', () => loadTranslationDrafts('product').catch(error => setStatus('productDraftStatus', error.message, true)));
      $('productDraftList').addEventListener('click', handleTranslationDraftListClick);
      $('blogDraftRefreshButton').addEventListener('click', () => loadTranslationDrafts('blog').catch(error => setStatus('blogDraftStatus', error.message, true)));
      $('blogDraftApproveButton').addEventListener('click', () => approveTranslationDrafts('blog').catch(error => setStatus('blogDraftStatus', error.message, true)));
      $('blogDraftIncludePublished').addEventListener('change', () => loadTranslationDrafts('blog').catch(error => setStatus('blogDraftStatus', error.message, true)));
      $('blogDraftList').addEventListener('click', handleTranslationDraftListClick);
      $('translationEditorCloseButton').addEventListener('click', closeTranslationEditor);
      $('translationEditorCancelButton').addEventListener('click', closeTranslationEditor);
      $('translationEditorSaveButton').addEventListener('click', () => saveTranslationDraftEditor().catch(error => setStatus('translationEditorStatus', error.message, true)));
      $('translationEditorApproveButton').addEventListener('click', () => {
        $('translationEditPublished').checked = true;
        saveTranslationDraftEditor({ publish: true }).catch(error => setStatus('translationEditorStatus', error.message, true));
      });
      $('translationEditorForm').addEventListener('input', event => syncTranslationFormInput(event.target));
      $('translationEditorForm').addEventListener('click', event => {
        const button = event.target.closest('[data-action]');
        if (button) handleTranslationAction(button);
      });
      $('publishButton').addEventListener('click', () => submitPublish().catch(error => setStatus('publishStatus', error.message, true)));
      $('publishHistoryButton').addEventListener('click', () => loadPublishHistory().catch(error => setStatus('publishStatus', error.message, true)));
      $('publishDeleteButton').addEventListener('click', () => deletePublishRecords().catch(error => setStatus('publishStatus', error.message, true)));
      $('themeMenuButton').addEventListener('click', event => {
        event.stopPropagation();
        setThemeMenuOpen($('themeMenu').hidden);
      });
      document.querySelectorAll('[data-theme-option]').forEach(button => {
        button.addEventListener('click', () => applyTheme(button.dataset.themeOption));
      });
      themeMedia.addEventListener('change', () => {
        if (state.themeChoice === 'system') applyTheme('system');
      });

      initializeRichEditors();
      ensureImageFieldPreview('image', 'statusText');
      ensureImageFieldPreview('blogImage', 'blogStatus');
      loadTranslationLocales().catch(error => {
        locales.splice(0, locales.length);
        renderLocaleOptions();
        setStatus('translationStatus', error.message, true);
      });
      applyTheme(state.themeChoice);
      checkManagerStatus()
        .then(connected => {
          if (connected) return bootstrapManager();
        })
        .catch(error => setConnectedUi(false, error.message));
    </script>
  </body>
</html>
