---
import Sidebar from '../../components/manager/Sidebar.astro';
import WorkspacePanel from '../../components/manager/WorkspacePanel.astro';
import VisualsPanel from '../../components/manager/VisualsPanel.astro';
import ProductOrderPanel from '../../components/manager/ProductOrderPanel.astro';
import ProductsPanel from '../../components/manager/ProductsPanel.astro';
import ArticlesPanel from '../../components/manager/ArticlesPanel.astro';
import ReviewsPanel from '../../components/manager/ReviewsPanel.astro';
import MediaPanel from '../../components/manager/MediaPanel.astro';
import TranslationPanel from '../../components/manager/TranslationPanel.astro';
import ProductDraftsPanel from '../../components/manager/ProductDraftsPanel.astro';
import ArticleDraftsPanel from '../../components/manager/ArticleDraftsPanel.astro';
import TranslationEditorPanel from '../../components/manager/TranslationEditorPanel.astro';
import PublishingPanel from '../../components/manager/PublishingPanel.astro';
import ImagePicker from '../../components/manager/ImagePicker.astro';
import ImagePreview from '../../components/manager/ImagePreview.astro';
import '../../styles/manager.css';
import { serializeJsonLd } from '../../lib/json-ld.mjs';
import siteOriginConfig from '../../data/site-origin.json';
import {productEditorSettings as productEditorSettings} from '../../data/site-policy';
import { productEditorFields, resolveProductEditorPolicy } from '../../lib/product-editor.mjs';
const productEditorPolicy = resolveProductEditorPolicy(productEditorSettings);
import {analyticsSettings as analyticsDashboardSettings} from '../../data/site-policy';
import industryProfile from '../../data/industry-profile.json';
import { reviewSystemEnabled } from '../../data/customerReviews';

export const prerender = true;
const publicR2AssetBaseUrl = (import.meta.env.PUBLIC_R2_ASSET_BASE_URL || '').replace(/\/+$/, '');
const managerAnalyticsEnabled = analyticsDashboardSettings.managerVisible === true;
const managerOwner = String((industryProfile.governance as { contentOwner?: string } | undefined)?.contentOwner || 'Ethan.B.Rain').trim() || 'Ethan.B.Rain';
const managerReviewSystemEnabled = reviewSystemEnabled;
const managerSiteName = industryProfile.brand?.name || '内容管理';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Golden One 内容管理</title>

  </head>
  <body>
    <main class="shell">
      <div class="admin-layout">
        <Sidebar managerOwner={managerOwner} managerSiteName={managerSiteName} managerReviewSystemEnabled={managerReviewSystemEnabled} managerAnalyticsEnabled={managerAnalyticsEnabled} />

        <div class="content-area">
          <header class="manager-mobile-header"><button class="button secondary" id="managerMenuButton" aria-controls="managerSidebar" aria-expanded="false" type="button">工作区</button><strong>{managerSiteName}</strong><span>内容管理</span></header>
          <div id="managerFeatureStatus" class="status" role="status" aria-live="polite"></div>
          <aside class="publication-guidance" role="note" aria-label="发布提醒" hidden>
            <strong>发布提醒</strong>
            <span id="publicationGuidanceText">正在确认未发布变更。</span>
          </aside>
          <nav class="translation-workspace-nav" id="translationWorkspaceNav" aria-label="翻译工作台" hidden><strong>翻译</strong><button class="tab" data-tab="translation" type="button">任务</button><button class="tab" data-tab="product-drafts" type="button">产品待办</button><button class="tab" data-tab="blog-drafts" type="button">文章待办</button></nav>
      <WorkspacePanel />
      <VisualsPanel />
      <ProductOrderPanel />

      <ProductsPanel managerReviewSystemEnabled={managerReviewSystemEnabled} />

      <ArticlesPanel />

      <ReviewsPanel />

      <MediaPanel />

      <TranslationPanel />

      <ProductDraftsPanel />

      <ArticleDraftsPanel />

      <TranslationEditorPanel />

      <PublishingPanel />
        </div>
      </div>
    </main>
    <button class="manager-menu-shade" id="managerMenuShade" aria-label="关闭工作区" type="button" hidden></button>

    <ImagePicker />

    <ImagePreview />

<script id="manager-config" type="application/json" is:inline set:html={serializeJsonLd({ publicR2AssetBaseUrl, publicSiteOrigin: siteOriginConfig.productionUrl, managerReviewSystemEnabled, productEditorFields, productEditorPolicy })}></script>
<script>
  import { initializeManager } from '../../scripts/manager/bootstrap.mjs';
  const config = document.getElementById('manager-config');
  if (config) initializeManager(JSON.parse(config.textContent || '{}'));
</script>
  </body>
</html>
