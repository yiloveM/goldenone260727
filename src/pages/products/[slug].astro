---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brandAssets } from '../../data/assets';
import { categoryHref, getCategoryMeta, isProductPublished, sortProductsByPriority } from '../../data/productCategories';
import { publicProductSpecs } from '../../data/productSpecs';
import { productSeoDescription, productStructuredData, siteUrl } from '../../data/seo';
import SeriesCard from '../../components/SeriesCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ProductMediaGallery from '../../components/ProductMediaGallery.astro';
import ProductImageCarousel from '../../components/ProductImageCarousel.astro';
import ProductTableScrollerScript from '../../components/ProductTableScrollerScript.astro';
import ProductInquirySelector from '../../components/ProductInquirySelector.astro';
import CustomerReviews from '../../components/CustomerReviews.astro';
import { reviewSystemEnabled } from '../../data/customerReviews';
import { getProductModelCodes, isModelSpecTable } from '../../data/inquiryCart';
import { keywordTag } from '../../lib/keyword-tags';

export async function getStaticPaths() {
  const products = (await getCollection('products')).filter(isProductPublished);
  return products.map(product => ({ params: { slug: product.id.replace(/\.mdoc$/, '') }, props: { product } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const slug = product.id.replace(/\.mdoc$/, '');
const productImage = product.data.image || brandAssets.heroCenter;
const productGalleryImages = Array.from(new Set([productImage, ...product.data.galleryImages].filter(Boolean)));
const productDetailImages = product.data.detailImages.filter(item => item.image);
const productCategory = getCategoryMeta(product.data.category);
const productCategoryName = productCategory.displayName || productCategory.name;
const relatedProducts = sortProductsByPriority(
  (await getCollection('products')).filter(
    item => isProductPublished(item) && item.id !== product.id && item.data.category === product.data.category
  )
).slice(0, 3);
const productUrl = new URL(`/products/${slug}/`, siteUrl(Astro.site)).toString();
const productDescription = productSeoDescription(product);
const productStructuredDataItem = productStructuredData(product, slug, Astro.site);
const visibleSpecs = publicProductSpecs(product.data.specs);
const usesInquiryCart = product.data.offeringType === 'physical-product';
const productModels = product.data.modelStrategy === 'series' ? getProductModelCodes(product) : [];
const isRedundantSpecTableTitle = (title: string) =>
  /^(product|model|technical)\s+specifications?$/i.test(String(title || '').trim());
const tableHint = 'Drag / scroll to view full table';
---

<BaseLayout title={product.data.title} description={productDescription} image={productImage} type="product" structuredData={productStructuredDataItem}>
  <main class="product-detail-page">
    <section class="product-detail-intro">
      <div class="container">
        <nav class="product-detail-breadcrumbs" aria-label="Breadcrumb">
          <a href="/products/">Products</a>
          <span aria-hidden="true">/</span>
          <a href={categoryHref(product.data.category)}>{productCategoryName}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{product.data.series}</span>
        </nav>

        <div class="product-detail-showcase">
          <div class="product-detail-gallery">
            <ProductImageCarousel images={productGalleryImages} title={product.data.title} variant="hero" priority />
          </div>

          <div class="product-detail-summary">
            <span class="eyebrow">{productCategoryName} / {product.data.series}</span>
            <h1>{product.data.title}</h1>
            <p class="product-detail-lead">{productDescription}</p>

            <div class="product-meta-strip">
              <span>Custom artwork</span>
              <span>Finish and fitting options</span>
              <span>International project support</span>
              {reviewSystemEnabled && product.data.aggregateRatingValue && product.data.aggregateRatingCount > 0 && (
                <span>{product.data.aggregateRatingValue}/5 from {product.data.aggregateRatingCount} customer ratings</span>
              )}
            </div>

            <div class="product-keyword-tags" aria-label={`${product.data.title} keywords`}>
              {[productCategoryName, product.data.series, ...product.data.highlights.slice(0, 2)].map(keyword => (
                <span>{keywordTag(keyword)}</span>
              ))}
            </div>

            <div class="product-detail-actions">
              {usesInquiryCart ? (
                <ProductInquirySelector
                  locale="en"
                  productSlug={slug}
                  productTitle={product.data.title}
                  series={product.data.series}
                  productPath={`/products/${slug}/`}
                  models={productModels}
                />
              ) : (
                <a class="btn primary" href="/contact/">Request quotation</a>
              )}
              <a class="product-detail-category-link" href={categoryHref(product.data.category)}>View {productCategoryName}</a>
            </div>

            <ShareButtons
              url={productUrl}
              title={product.data.title}
              description={productDescription}
              image={productImage}
              label="Share product"
            />
          </div>
        </div>
      </div>
    </section>

    <nav class="product-detail-jump-nav" aria-label="Product page sections">
      <div class="container product-detail-jump-links">
        <a href="#product-overview">Overview</a>
        <a href="#product-specifications">Specifications</a>
        {productDetailImages.length > 0 && <a href="#product-gallery">Images &amp; options</a>}
        {product.data.faqs.length > 0 && <a href="#product-faq">FAQ</a>}
      </div>
    </nav>

    <section id="product-overview" class="product-content-band">
      <div class="container">
        <header class="product-section-heading">
          <span class="eyebrow">Selection overview</span>
          <h2>What defines this product.</h2>
        </header>

        <ul class="product-highlights" aria-label={`${product.data.title} highlights`}>
          {product.data.highlights.map(item => (
            <li class="highlight-card">
              <span class="highlight-check" aria-hidden="true">&#10003;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        {product.data.applications.length > 0 && (
          <div class="product-application-section">
            <h3>Typical applications</h3>
            <ul class="application-list">
              {product.data.applications.map(item => <li>{item}</li>)}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section id="product-specifications" class="product-content-band product-content-band--alternate">
      <div class="container product-specification-section">
        <header class="product-section-heading">
          <span class="eyebrow">Product configuration</span>
          <h2>General specifications and available options.</h2>
        </header>

        <div class="table-hint-row">
          <span class="table-scroll-hint" aria-hidden="true">{tableHint}</span>
        </div>
        <div class="table-scroll table-scroll--overview" tabindex="0">
          <table class="spec-table spec-overview-table">
            <tbody>{visibleSpecs.map(row => <tr><th>{row.label}</th><td>{row.value}</td></tr>)}</tbody>
          </table>
        </div>

        {product.data.specTables.length > 0 && (
          <div class="product-model-tables">
            <h3>Model specifications</h3>
            <div class="spec-table-stack">
              {product.data.specTables.map(table => (
                <div class="table-wrap" data-spec-table>
                  {!isRedundantSpecTableTitle(table.title) && (
                    <div class="spec-table-head">
                      <h4>{table.title}</h4>
                    </div>
                  )}
                  <div class="table-hint-row">
                    <span class="table-scroll-hint" aria-hidden="true">{tableHint}</span>
                  </div>
                  <div class="matrix-scroll table-scroll" tabindex="0">
                    <table class="spec-table matrix">
                      <thead>
                        {table.headerRows.length
                          ? table.headerRows.map(headerRow => (
                            <tr>{headerRow.cells.map(cell => (
                              <th colspan={cell.colspan > 1 ? cell.colspan : undefined} rowspan={cell.rowspan > 1 ? cell.rowspan : undefined}>{cell.text}</th>
                            ))}</tr>
                          ))
                          : <tr>{table.columns.map(column => <th>{column}</th>)}</tr>}
                      </thead>
                      <tbody>{table.rows.map(row => <tr data-model={isModelSpecTable(table) ? row[0] : undefined}>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="product-content-band product-description-band">
      <div class="container">
        <article class="detail-panel prose product-description-copy">
          <Content />
        </article>
      </div>
    </section>

    <ProductMediaGallery detailImages={productDetailImages} title={product.data.title} />

    {product.data.faqs.length > 0 && (
      <section id="product-faq" class="product-content-band product-content-band--alternate">
        <div class="container product-faq-section">
          <header class="product-section-heading">
            <span class="eyebrow">FAQ</span>
            <h2>Common questions.</h2>
          </header>
          <div class="faq-accordion-list">
            {product.data.faqs.map(item => (
              <details class="faq-accordion">
                <summary><strong>{item.question}</strong><span aria-hidden="true">+</span></summary>
                <div class="faq-accordion-panel">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedProducts.length > 0 && (
      <section class="section container related-products-section deferred-section">
        <div class="section-heading">
          <span class="eyebrow">Related items</span>
          <h2>Compare more {productCategoryName.toLowerCase()} options</h2>
          <p class="prose">Compare more products in the same category and find the right format for your project.</p>
        </div>
        <div class="card-grid series-card-grid">{relatedProducts.map(item => <SeriesCard product={item} />)}</div>
      </section>
    )}
    <CustomerReviews productSlug={slug} compact />
  </main>
  <ProductTableScrollerScript hint={tableHint} />
</BaseLayout>
