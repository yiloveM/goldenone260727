---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { factoryGallery, pageImages, siteInfo } from '../data/site';
import { industryProfile } from '../data/industry-profile';
import { breadcrumbStructuredData, organizationStructuredData } from '../data/seo';
import { translateTechnicalText, ui } from '../data/i18n';
import { getLocalizedPageCopy, type NonEnglishLocale } from './localizedPageHelpers';

interface Props {
  locale: NonEnglishLocale;
}

const { locale } = Astro.props;
const pages = getLocalizedPageCopy(locale);
const aboutDescription = pages.about.description;
const aboutStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: pages.about.title,
    description: aboutDescription,
    url: new URL(`/${locale}/about/`, Astro.site || 'https://businessweb.workers.dev').toString(),
  },
  breadcrumbStructuredData(
    [
      { name: siteInfo.name, url: `/${locale}/` },
      { name: ui[locale].nav.about, url: `/${locale}/about/` },
    ],
    Astro.site
  ),
];
const localizedFactoryGallery = factoryGallery.map(item => ({ ...item, title: translateTechnicalText(item.title, locale) }));
---

<BaseLayout title={pages.about.title} description={aboutDescription} image={pageImages.about} structuredData={aboutStructuredData} locale={locale}>
  <main>
    <PageBanner
      eyebrow={pages.about.bannerEyebrow}
      title={pages.about.bannerTitle}
      description={pages.about.bannerDescription}
      image={pageImages.about}
      variant="interior"
      share
      shareLabel={ui[locale].common.sharePage}
      dir="ltr"
    />
    <section class="section container interior-section about-system-section">
      <div class="section-heading" dir="ltr">
        <span class="eyebrow">{pages.about.systemEyebrow}</span>
        <h2>{pages.about.systemTitle}</h2>
        <p class="prose">{pages.about.systemDescription}</p>
      </div>
      <div class="proof-grid">
        <div class="glass-panel proof-panel">
          <h2>{pages.about.whatWeBuild}</h2>
          <p class="prose">{pages.about.whatWeBuildDescription}</p>
        </div>
        <div class="proof-list">
          <div class="proof-card about-proof-card" tabindex="0">
            <strong>{translateTechnicalText('Context', locale)}</strong>
            <p class="prose">{translateTechnicalText('Information shaped around actual applications, evaluation criteria, and project fit.', locale)}</p>
            <span class="proof-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M16 43c6-13 15-21 32-24"/><path d="M17 43h30"/><path d="M22 36l7 7 12-18"/><path d="M14 51h36"/></svg>
            </span>
          </div>
          <div class="proof-card about-proof-card" tabindex="0">
            <strong>{translateTechnicalText('Clarity', locale)}</strong>
            <p class="prose">{translateTechnicalText('Direct commercial conversations with the details needed for a useful response.', locale)}</p>
            <span class="proof-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M32 10 48 17v13c0 11-7 19-16 24-9-5-16-13-16-24V17Z"/><path d="m23 32 6 6 13-15"/></svg>
            </span>
          </div>
          <div class="proof-card about-proof-card" tabindex="0">
            <strong>{translateTechnicalText('Continuity', locale)}</strong>
            <p class="prose">{translateTechnicalText('Support for selection, implementation, and long-term operating needs.', locale)}</p>
            <span class="proof-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M14 24h36v24H14z"/><path d="M20 24V14h24v10"/><path d="M23 36h18"/><path d="M23 43h10"/></svg>
            </span>
          </div>
          <div class="proof-card about-proof-card" tabindex="0">
            <strong>{translateTechnicalText('Reach', locale)}</strong>
            <p class="prose">{translateTechnicalText('A perspective designed for international B2B buyers and project teams.', locale)}</p>
            <span class="proof-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="21"/><path d="M11 32h42"/><path d="M32 11c6 7 9 14 9 21s-3 14-9 21c-6-7-9-14-9-21s3-14 9-21Z"/></svg>
            </span>
          </div>
        </div>
      </div>
    </section>
    <section class="section container factory-section">
      <div class="section-heading" dir="ltr">
        <span class="eyebrow">{pages.about.factoryEyebrow}</span>
        <h2>{pages.about.factoryTitle}</h2>
      </div>
      <div class="factory-carousel-shell" data-marquee-shell data-marquee-direction="ltr" data-marquee-duration="48">
        <div class="brand-rail-hint" aria-hidden="true">{ui[locale].common.dragSwipe}</div>
        <div class="factory-carousel" aria-label={`${industryProfile.market.industry} visual gallery`} data-marquee-track>
          {[...localizedFactoryGallery, ...localizedFactoryGallery].map(item => (
            <figure><img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="800" /><figcaption>{item.title}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
