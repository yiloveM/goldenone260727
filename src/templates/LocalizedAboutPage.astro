---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import MediaCarousel from '../components/MediaCarousel.astro';
import { factoryGallery, pageImages, siteInfo } from '../data/site';
import { breadcrumbStructuredData, organizationStructuredData, siteUrl } from '../data/seo';
import { translateTechnicalText, ui } from '../data/i18n';
import { getLocalizedPageCopy, type NonEnglishLocale } from './localizedPageHelpers';

interface Props {
  locale: NonEnglishLocale;
}

const { locale } = Astro.props;
const pages = getLocalizedPageCopy(locale);
const aboutDescription = pages.about.description;
const aboutStructuredData = [
  organizationStructuredData(Astro.site),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: pages.about.title,
    description: aboutDescription,
    url: new URL(`/${locale}/about/`, siteUrl(Astro.site)).toString(),
  },
  breadcrumbStructuredData(
    [
      { name: siteInfo.name, url: `/${locale}/` },
      { name: ui[locale].nav.about, url: `/${locale}/about/` },
    ],
    Astro.site
  ),
];
const localizedFactoryGallery = factoryGallery.map(item => ({ ...item, title: translateTechnicalText(item.title, locale) }));
const aboutCards = locale === 'es'
  ? [
      ['Diseño', 'Empieza con la idea visual, el uso previsto y la forma que debe representarla.'],
      ['Objeto', 'Define silueta, dimensiones, espesor, relieve, anverso, reverso y canto.'],
      ['Acabado', 'Compara esmalte, baño, pulido, efecto antiguo, color y textura.'],
      ['Presentación', 'Completa el proyecto con cierre, cinta, herrajes, cuero y embalaje.'],
    ]
  : [
      ['Artwork', 'Start with the visual idea, intended use, and the form that should carry it.'],
      ['Object', 'Define shape, dimensions, thickness, relief, front, reverse, and edge treatment.'],
      ['Finish', 'Compare enamel, plating, polish, antique treatment, color, and texture.'],
      ['Presentation', 'Complete the project with backing, ribbon, hardware, leather, and packaging choices.'],
    ];
---

<BaseLayout title={pages.about.title} description={aboutDescription} image={pageImages.about} structuredData={aboutStructuredData} locale={locale}>
  <main>
    <PageBanner
      eyebrow={pages.about.bannerEyebrow}
      title={pages.about.bannerTitle}
      description={pages.about.bannerDescription}
      image={pageImages.about}
      variant="interior"
      share
      shareLabel={ui[locale].common.sharePage}
      dir="ltr"
    />
    <section class="section container interior-section about-system-section">
      <div class="section-heading" dir="ltr">
        <span class="eyebrow">{pages.about.systemEyebrow}</span>
        <h2>{pages.about.systemTitle}</h2>
        <p class="prose">{pages.about.systemDescription}</p>
      </div>
      <div class="proof-grid">
        <div class="glass-panel proof-panel">
          <h2>{pages.about.whatWeBuild}</h2>
          <p class="prose">{pages.about.whatWeBuildDescription}</p>
        </div>
        <div class="proof-list">
          {aboutCards.map(item => (
            <div class="proof-card about-proof-card" tabindex="0">
              <strong>{item[0]}</strong>
              <p class="prose">{item[1]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <MediaCarousel items={localizedFactoryGallery} eyebrow={pages.about.factoryEyebrow} title={pages.about.factoryTitle} id={`about-factory-${locale}`} />
  </main>
</BaseLayout>
