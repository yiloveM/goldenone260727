---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-tailwind.css';
import { brandAssets } from '../data/assets';
import { siteImages } from '../data/backgroundImages';
import HomeRippleScript from '../components/HomeRippleScript.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { brandShowcase, factoryGallery, homePlaceholderImages } from '../data/site';
import { siteInfo } from '../data/site';
import { industryProfile, primaryKeyword, profileKeywords } from '../data/industry-profile';
import { isProductPublished, sortProductsByPriority } from '../data/productCategories';
import { collectionStructuredData, organizationStructuredData, websiteStructuredData } from '../data/seo';
import { blogPath, localizedBlog, translateTechnicalText, ui } from '../data/i18n';
import { getLocalizedPageCopy, type NonEnglishLocale } from './localizedPageHelpers';

interface Props {
  locale: NonEnglishLocale;
}

const { locale } = Astro.props;
const pages = getLocalizedPageCopy(locale);
const allProducts = (await getCollection('products')).filter(isProductPublished);
const products = sortProductsByPriority(allProducts.filter(p => p.data.featured)).slice(0, 6);
const posts = (await getCollection('blog')).filter(p => p.data.featured).slice(0, 2);
const heroFloatingProducts = brandAssets.heroFloatingProducts.filter(Boolean).slice(0, 3);
const localizedBrandShowcase = brandShowcase.map(item => ({
  ...item,
  title: translateTechnicalText(item.title, locale),
  label: translateTechnicalText(item.label, locale),
}));
const localizedFactoryGallery = factoryGallery.map(item => ({ ...item, title: translateTechnicalText(item.title, locale) }));
const featureCards = [
  ['Detail', 'Technical evidence'],
  ['Fit', 'Application context'],
  ['Reach', 'International markets'],
  ['Support', 'Commercial response'],
].map(([title, description]) => ({ title: translateTechnicalText(title, locale), description: translateTechnicalText(description, locale) }));
const proofCards = [
  ['Evidence', 'Buyer-facing detail that supports selection, comparison, and procurement conversations.'],
  ['Context', 'Applications, compatibility, and decision criteria explained in a direct, credible voice.'],
  ['Reach', 'A clear path for global buyers to discover, assess, and discuss the offer.'],
  ['Response', 'A commercial inquiry flow designed for detailed requirements and real next steps.'],
].map(([title, description]) => ({ title: translateTechnicalText(title, locale), description: translateTechnicalText(description, locale) }));
const cssImage = (url: string) => `url('${url}')`;
const homeBackgroundStyle = [
  `--brand-section-bg: ${cssImage(siteImages.homeBackgrounds.productWorldsIntro)}`,
  `--product-category-transition-bg-desktop: ${cssImage(siteImages.homeBackgrounds.productCategoryTransitionDesktop)}`,
  `--product-category-transition-bg-mobile: ${cssImage(siteImages.homeBackgrounds.productCategoryTransitionMobile)}`,
  `--feature-band-bg: ${cssImage(siteImages.homeBackgrounds.hotSalesBand)}`,
  `--featured-equipment-bg: ${cssImage(siteImages.homeBackgrounds.featuredEquipment)}`,
  `--factory-capability-bg: ${cssImage(siteImages.homeBackgrounds.factoryCapability)}`,
].join('; ');

const homeStructuredData = [
  organizationStructuredData(Astro.site),
  websiteStructuredData(Astro.site),
  collectionStructuredData(
    {
      name: pages.home.hotTitle,
      description: pages.home.description,
      url: `/${locale}/`,
      image: brandAssets.heroRippleDesktop,
      keywords: profileKeywords([industryProfile.market.industry, primaryKeyword]),
      items: [
        { name: pages.products.title, url: `/${locale}/products/`, image: siteImages.pageBanners.productsCatalog },
        { name: pages.blog.title, url: `/${locale}/blog/`, image: siteImages.pageBanners.engineeringNotes },
      ],
    },
    Astro.site
  ),
];
---
<BaseLayout title={siteInfo.name} description={pages.home.description} image={brandAssets.heroRippleDesktop} preloadHomeHero structuredData={homeStructuredData} locale={locale}>
  <main class="astrowind-home tw:relative tw:isolate tw:overflow-hidden" data-tailwind-homepage style={homeBackgroundStyle}>
    <section class="hero astrowind-hero tw:relative tw:min-h-[46rem] tw:overflow-hidden" id="home-hero">
      <div class="hero-water-surface tw:absolute tw:inset-0" id="home-ripples" aria-hidden="true" style={`--hero-bg-desktop: url('${brandAssets.heroRippleDesktop}'); --hero-bg-mobile: url('${brandAssets.heroRippleMobile}');`}></div>
      <div class="container hero-inner tw:relative tw:z-10 tw:mx-auto tw:grid tw:min-h-[46rem] tw:items-center tw:gap-10 tw:px-5 tw:py-20 lg:tw:grid-cols-[minmax(0,0.88fr)_minmax(25rem,1.12fr)] lg:tw:px-8">
        <div class="hero-copy tw:relative tw:z-10 tw:max-w-2xl" dir="ltr">
          <span class="eyebrow tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-white/30 tw:bg-white/10 tw:px-3 tw:py-1 tw:text-xs tw:font-semibold tw:uppercase tw:tracking-[0.14em]">{pages.home.eyebrow}</span>
          <h1 class="tw:mt-6 tw:max-w-3xl tw:text-4xl tw:font-semibold tw:leading-tight sm:tw:text-5xl lg:tw:text-6xl">{pages.home.title}</h1>
          <p class="tw:mt-6 tw:max-w-xl tw:text-base tw:leading-8 sm:tw:text-lg">{pages.home.description}</p>
          <div class="hero-actions tw:mt-8 tw:flex tw:flex-wrap tw:gap-3">
            <a class="btn primary tw:inline-flex tw:min-h-12 tw:items-center tw:justify-center" href={`/${locale}/products/`}>{ui[locale].common.exploreProducts}</a>
            <a class="btn secondary tw:inline-flex tw:min-h-12 tw:items-center tw:justify-center" href={`/${locale}/contact/`}>{ui[locale].common.requestFactoryQuote}</a>
          </div>
          <div class="metric-row tw:mt-10 tw:grid tw:gap-3 sm:tw:grid-cols-3">
            <div class="metric" tabindex="0" role="group" aria-label={pages.home.metric1}>
              <strong>01</strong><span>{pages.home.metric1}</span>
            </div>
            <div class="metric" tabindex="0" role="group" aria-label={pages.home.metric2}>
              <strong>02</strong><span>{pages.home.metric2}</span>
            </div>
            <div class="metric" tabindex="0" role="group" aria-label={pages.home.metric3}>
              <strong>03</strong><span>{pages.home.metric3}</span>
            </div>
          </div>
        </div>
        <div class="hero-visual tw:relative tw:mx-auto tw:w-full tw:max-w-2xl" aria-label={pages.home.title}>
          <div class={`hero-product-stage hero-product-count-${heroFloatingProducts.length}`}>
            {heroFloatingProducts.map((image, index) => (
              <figure class={`hero-product hero-product-${index + 1}`} tabindex="0" role="button" aria-label={`Focus ${industryProfile.market.industry} visual ${index + 1}`}>
                <img src={image} alt={`${industryProfile.market.industry} visual ${index + 1}`} fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="900" height="760" />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section container brand-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="section-heading tw:max-w-3xl" dir="ltr">
        <span class="eyebrow">{pages.home.hotEyebrow}</span>
        <h2>{pages.home.hotTitle}</h2>
        <p class="prose">{pages.home.hotDescription}</p>
      </div>
      <div class="brand-rail-shell" data-brand-rail-shell>
        <div class="brand-rail-hint" aria-hidden="true">{ui[locale].common.dragSwipe}</div>
        <div class="brand-rail" aria-label={`${industryProfile.market.industry} capability carousel`} data-brand-rail>
          {[...localizedBrandShowcase, ...localizedBrandShowcase].map(item => (
            <article class="brand-slide">
              <a class="brand-slide-image-link" href={`/${locale}/about/`} aria-label={item.title}>
                <img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="760" draggable="false" />
              </a>
              <div dir="ltr"><span>{item.label}</span><h3>{item.title}</h3></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="home-product-category-transition" aria-hidden="true"></div>

    <section class="section feature-band deferred-section tw:py-20 lg:tw:py-28">
      <div class="container feature-band-inner tw:mx-auto tw:grid tw:max-w-7xl tw:gap-10 tw:px-5 sm:tw:px-8 lg:tw:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div>
          <span class="eyebrow">{pages.home.featureEyebrow}</span>
          <h2>{pages.home.featureTitle}</h2>
          <p>{pages.home.featureDescription}</p>
        </div>
        <div class="mini-specs hot-sales-grid tw:grid tw:gap-3 sm:tw:grid-cols-2">
          {featureCards.map(item => (
            <a class="hot-sale-card" href={`/${locale}/about/`}>
              <div><strong>{item.title}</strong><span>{item.description}</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-ambient-section featured-equipment-section deferred-section tw:py-20 lg:tw:py-28" style="--home-section-bg: var(--featured-equipment-bg);">
      <div class="container home-ambient-inner tw:mx-auto tw:max-w-7xl tw:px-5 sm:tw:px-8">
        <div class="section-heading tw:max-w-3xl" dir="ltr">
          <span class="eyebrow">{pages.home.equipmentEyebrow}</span>
          <h2>{pages.home.equipmentTitle}</h2>
        </div>
        {products.length ? (
          <div class="card-grid series-card-grid product-showcase tw:mt-10">{products.map(product => <SeriesCard product={product} locale={locale} />)}</div>
        ) : (
          <div class="card-grid tw:mt-10">
            {localizedBrandShowcase.map(item => (
              <article class="card">
                <img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="760" />
                <div class="card-body" dir="ltr"><span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>{pages.products.categoryDescription}</p></div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section container partners-section deferred-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="proof-grid tw:grid tw:gap-6 lg:tw:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)]">
        <div class="glass-panel proof-panel partnership-panel">
          <div class="partnership-copy">
            <span class="eyebrow">{pages.home.partnersEyebrow}</span>
            <h2>{pages.home.partnersTitle}</h2>
            <p class="prose">{pages.home.partnersDescription}</p>
          </div>
          <figure class="partnership-visual">
            <img src={homePlaceholderImages.partnership} alt={`${industryProfile.market.industry} collaboration`} loading="lazy" decoding="async" width="1600" height="980" />
            <figcaption>{pages.home.partnershipCaption}</figcaption>
          </figure>
        </div>
        <div class="proof-list tw:grid tw:gap-3 sm:tw:grid-cols-2 lg:tw:grid-cols-1">
          {proofCards.map(item => (
            <article class="proof-card" tabindex="0" aria-label={item.title}>
              <strong>{item.title}</strong><p class="prose">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-ambient-section factory-section deferred-section tw:py-20 lg:tw:py-28" style="--home-section-bg: var(--factory-capability-bg);">
      <div class="container home-ambient-inner tw:mx-auto tw:max-w-7xl tw:px-5 sm:tw:px-8">
        <div class="section-heading tw:max-w-3xl" dir="ltr">
          <span class="eyebrow">{pages.home.factoryEyebrow}</span>
          <h2>{pages.home.factoryTitle}</h2>
          <p class="prose">{pages.home.factoryDescription}</p>
        </div>
        <div class="factory-carousel-shell" data-marquee-shell data-marquee-direction="ltr" data-marquee-duration="48">
          <div class="brand-rail-hint" aria-hidden="true">{ui[locale].common.dragSwipe}</div>
          <div class="factory-carousel" aria-label={`${industryProfile.market.industry} image carousel`} data-marquee-track>
            {[...localizedFactoryGallery, ...localizedFactoryGallery].map(item => (
              <figure><img src={item.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="800" draggable="false" /><figcaption>{item.title}</figcaption></figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section container insights-section deferred-section tw:mx-auto tw:w-full tw:max-w-7xl tw:px-5 tw:py-20 sm:tw:px-8 lg:tw:py-28">
      <div class="section-heading tw:max-w-3xl" dir="ltr">
        <span class="eyebrow">{pages.home.insightsEyebrow}</span>
        <h2>{pages.home.insightsTitle}</h2>
      </div>
      <div class="card-grid tw:mt-10">
        {posts.length ? posts.map(post => {
          const item = localizedBlog(post, locale);
          return (
            <article class="card">
              <a href={blogPath(item.slug, locale)}>
                <img src={post.data.image} alt={item.title} loading="lazy" decoding="async" width="1200" height="760" />
                <div class="card-body" dir="ltr"><span class="eyebrow">{item.category}</span><h3>{item.title}</h3><p>{item.description}</p></div>
              </a>
            </article>
          );
        }) : (
          <article class="card">
            <img src={siteImages.pageBanners.engineeringNotes} alt={`${industryProfile.market.industry} insights`} loading="lazy" decoding="async" width="1200" height="760" />
            <div class="card-body" dir="ltr"><span class="eyebrow">{pages.blog.bannerEyebrow}</span><h3>{pages.blog.bannerTitle}</h3><p>{pages.blog.bannerDescription}</p></div>
          </article>
        )}
      </div>
    </section>
  </main>
  <HomeRippleScript />
</BaseLayout>
